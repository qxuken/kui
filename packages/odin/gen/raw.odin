package gen

import "core:fmt"
import "core:slice"
import "core:strings"

// `kui/c`: the mirror of kui.h, one declaration per C one. The names lose
// their prefix and nothing else changes - every field keeps its C type and
// meaning, so kui.h's comments are its documentation. The one deliberate
// difference is KuiStr, which is Odin's `string`: the same (ptr, len) pair,
// passed the same way.

KEYWORDS :: []string {
	"asm", "auto_cast", "bit_set", "break", "case", "cast", "context", "continue", "defer", "distinct",
	"do", "dynamic", "else", "enum", "fallthrough", "for", "foreign", "if", "import", "in", "map",
	"matrix", "not_in", "or_else", "or_return", "or_break", "or_continue", "package", "proc", "return",
	"struct", "switch", "transmute", "typeid", "union", "using", "when", "where",
}

emit_raw :: proc(m: ^C_Model, out_dir, layout_path: string) {
	b := strings.builder_make()
	w := strings.to_writer(&b)
	fmt.wprintln(w, `// GENERATED by packages/odin/gen from crates/kui-ffi/include/kui.h - do not
// edit; `+"`nu scripts/odin.nu gen`"+` rewrites it. kui.h is the documentation: every
// name here is the C one without its prefix (kui_open -> open, KuiSpec ->
// Spec, KUI_GROW -> GROW), and KuiStr is Odin's string.
package kui_c

// The library to link: kui_ffi from the system search path by default,
// which -extra-linker-flags:"-L<dir>" points at a build. Override with
// -define:KUI_LIB=<name or relative path>.
KUI_LIB :: #config(KUI_LIB, "system:kui_ffi")

// A plugin (-define:KUI_PLUGIN=true, built -build-mode:shared) links no kui
// on macOS or Linux: every kui_* stays undefined and resolves at load from
// the host that loads it, as kui.h's "Extension ABI" has it - so one plugin
// loads into a Rust, C, Odin or Node host alike. macOS's linker needs
// telling that undefined is meant: build with
// -extra-linker-flags:"-Wl,-undefined,dynamic_lookup" (an attribute here
// cannot carry it: Odin joins it to the next flag with no space). On
// Windows a DLL may not leave an import unresolved, and a plugin imports
// from kui_ffi.dll as any program does (kui.h's shape 1).
KUI_PLUGIN :: #config(KUI_PLUGIN, false)

when KUI_PLUGIN && ODIN_OS == .Darwin {
	foreign import lib "system:System"
} else when KUI_PLUGIN && ODIN_OS != .Windows {
	foreign import lib "system:c"
} else {
	foreign import lib { KUI_LIB }
}

Str :: string
`)

	fmt.wprintln(w, "// -- Opaque handles")
	for name in m.opaque do fmt.wprintfln(w, "%s :: struct {{}}", type_name(name))

	fmt.wprint(w, "\n// -- Constants (the header's #defines and anonymous enums)")
	last := -1
	for c in m.constants {
		if c.group != last do fmt.wprintln(w)
		last = c.group
		fmt.wprintfln(w, "%s :: %s", const_name(c.name), c.value)
	}

	fmt.wprintln(w, "\n// -- Callbacks")
	for f in m.fn_types do fmt.wprintfln(w, "%s :: #type %s", type_name(f.name), fn_pointer(f.type))

	fmt.wprintln(w, "\n// -- Structs")
	for r in m.records {
		if r.name == "KuiStr" do continue
		fmt.wprintfln(w, "%s :: struct {{", type_name(r.name))
		for f, i in r.fields {
			next := r.fields[i + 1].type if i + 1 < len(r.fields) else ""
			fmt.wprintfln(w, "\t%s: %s,", ident(f.name), odin_type(f.type, many = next == "size_t"))
		}
		fmt.wprintln(w, "}\n")
	}

	fmt.wprintln(w, `// -- Functions
@(default_calling_convention = "c", link_prefix = "kui_")
foreign lib {`)
	for f in m.functions {
		name := raw_name(f.name)
		if name != f.name[len("kui_"):] do fmt.wprintfln(w, "\t@(link_name = %q)", f.name)
		fmt.wprintf(w, "\t%s :: proc(", name)
		for p, i in f.params {
			if i > 0 do fmt.wprint(w, ", ")
			fmt.wprintf(w, "%s: %s", ident(p.name), odin_type(p.type, many = runs_into_count(f.params[i:])))
		}
		fmt.wprint(w, ")")
		if f.ret != "void" do fmt.wprintf(w, " -> %s", odin_type(f.ret))
		fmt.wprintln(w, " ---")
	}
	fmt.wprintln(w, "}")

	write(fmt.tprintf("%s/kui_c.odin", out_dir), strings.to_string(b))

	// The layout check: a C program that asks the C compiler, the authority
	// on the C ABI, for every size, alignment and offset and every constant's
	// value, and prints them as Odin #asserts - so `kui/c` refuses to compile
	// when its mirror and the header disagree, on the platform it is built
	// for.
	lb := strings.builder_make()
	lw := strings.to_writer(&lb)
	fmt.wprintln(lw, `/* GENERATED by packages/odin/gen - prints packages/odin/kui/c/layout.odin. */
#include <stdio.h>
#include <stddef.h>
#include "kui.h"
int main(void) {
    puts("// GENERATED by the layout program packages/odin/gen writes - do not edit.");
    puts("// The C compiler's sizes, alignments and offsets for every struct in kui.h,");
    puts("// and its value for every constant: a mirror that drifts from the header");
    puts("// stops compiling here.");
    puts("package kui_c\n");`)
	for r in m.records {
		if r.name == "KuiStr" do continue
		o := type_name(r.name)
		fmt.wprintfln(lw, "    printf(\"#assert(size_of(%s) == %%zu)\\n\", sizeof(%s));", o, r.name)
		fmt.wprintfln(lw, "    printf(\"#assert(align_of(%s) == %%zu)\\n\", _Alignof(%s));", o, r.name)
		for f in r.fields {
			fmt.wprintfln(lw, "    printf(\"#assert(offset_of(%s, %s) == %%zu)\\n\", offsetof(%s, %s));", o, ident(f.name), r.name, f.name)
		}
	}
	for c in m.constants {
		if strings.contains(c.value, ".") {
			fmt.wprintfln(lw, "    printf(\"#assert(%s == %%.9g)\\n\", (double)%s);", const_name(c.name), c.name)
		} else {
			fmt.wprintfln(lw, "    printf(\"#assert(%s == %%lld)\\n\", (long long)%s);", const_name(c.name), c.name)
		}
	}
	fmt.wprintln(lw, "    return 0;\n}")
	write(layout_path, strings.to_string(lb))

	fmt.printfln("gen: kui/c: %d functions, %d structs, %d constants, %d callbacks", len(m.functions), len(m.records) - 1, len(m.constants), len(m.fn_types))
}

// A C function's name in kui/c: kui_switch is switch_.
raw_name :: proc(c_name: string) -> string {
	return ident(c_name[len("kui_"):])
}

type_name :: proc(c: string) -> string {
	return strings.trim_prefix(c, "Kui")
}

const_name :: proc(c: string) -> string {
	return strings.trim_prefix(c, "KUI_")
}

ident :: proc(s: string) -> string {
	return fmt.aprintf("%s_", s) if slice.contains(KEYWORDS, s) else s
}

// A pointer parameter is an array when a size_t follows it, past any
// parallel arrays of the same type: `const KuiSpan *spans, size_t
// span_count`, and the legend's `const KuiStr *keys, const KuiStr *what,
// size_t count`.
runs_into_count :: proc(params: []Param) -> bool {
	return count_param(params) >= 0
}

// Where the count of the array starting params[0] is, or -1.
count_param :: proc(params: []Param) -> int {
	if !strings.has_suffix(params[0].type, "*") do return -1
	for p, i in params[1:] {
		if p.type == params[0].type do continue
		return i + 1 if p.type == "size_t" else -1
	}
	return -1
}

PRIMITIVES :: [?][2]string {
	{"void", ""},
	{"bool", "bool"},
	{"_Bool", "bool"},
	{"char", "u8"},
	{"float", "f32"},
	{"double", "f64"},
	{"int", "i32"},
	{"uint8_t", "u8"},
	{"uint16_t", "u16"},
	{"uint32_t", "u32"},
	{"uint64_t", "u64"},
	{"int32_t", "i32"},
	{"int64_t", "i64"},
	{"size_t", "uint"},
	{"KuiStr", "string"},
}

primitive :: proc(c: string) -> (string, bool) {
	for p in PRIMITIVES do if p[0] == c do return p[1], true
	return "", false
}

// The C type with its qualifiers and `struct` off: "const KuiSpec *" is
// "KuiSpec *".
bare :: proc(c_type: string) -> string {
	t := strings.trim_space(c_type)
	t, _ = strings.replace_all(t, "const ", "", context.temp_allocator)
	t = strings.trim_prefix(t, "struct ")
	return strings.trim_space(t)
}

is_pointer :: proc(c_type: string) -> bool {return strings.has_suffix(strings.trim_space(c_type), "*")}

// "const KuiSpec *" -> "KuiSpec"; "uint8_t **" -> "uint8_t *".
pointee :: proc(c_type: string) -> string {
	t := bare(c_type)
	return strings.trim_space(t[:len(t) - 1])
}

is_const_pointer :: proc(c_type: string) -> bool {
	return is_pointer(c_type) && strings.has_prefix(strings.trim_space(c_type), "const ")
}

odin_type :: proc(c_type: string, many := false) -> string {
	t := strings.trim_space(c_type)
	is_const := strings.has_prefix(t, "const ")
	t = strings.trim_space(strings.trim_prefix(t, "const "))
	t = strings.trim_prefix(t, "struct ")

	// float[4]
	if open := strings.index_byte(t, '['); open >= 0 && strings.has_suffix(t, "]") {
		return fmt.aprintf("[%s]%s", t[open + 1:len(t) - 1], odin_type(t[:open]))
	}
	if strings.has_suffix(t, "*") {
		base := strings.trim_space(t[:len(t) - 1])
		base_const := strings.has_prefix(base, "const ")
		bare_base := strings.trim_prefix(base, "const ")
		switch {
		case strings.has_suffix(bare_base, "*"):
			return fmt.aprintf("^%s", odin_type(base, many = true))
		case bare_base == "void":
			return "rawptr"
		case bare_base == "char":
			return "cstring"
		case bare_base == "uint8_t":
			return "[^]u8"
		}
		_, number := primitive(bare_base)
		number = number && bare_base != "KuiStr"
		// A const pointer to a number is input data (xy, ops, ids, a pivot,
		// a dash); a mutable one is an out-param (*x, *revision).
		if many || (number && (base_const || is_const)) {
			return fmt.aprintf("[^]%s", odin_type(bare_base))
		}
		return fmt.aprintf("^%s", odin_type(bare_base))
	}
	if p, ok := primitive(t); ok do return p
	if strings.has_prefix(t, "Kui") do return type_name(t)
	fail("no Odin type for %s", c_type)
}

// "void (*)(void *, KuiCtx *)" -> proc "c" (rawptr, ^Ctx)
fn_pointer :: proc(c_type: string) -> string {
	ret := strings.trim_space(c_type[:strings.index(c_type, "(*)")])
	args_s := c_type[strings.index(c_type, "(*)") + 4:len(c_type) - 1]
	b := strings.builder_make()
	strings.write_string(&b, `proc "c" (`)
	if args_s != "void" {
		for a, i in strings.split(args_s, ", ") {
			if i > 0 do strings.write_string(&b, ", ")
			strings.write_string(&b, odin_type(a))
		}
	}
	strings.write_string(&b, ")")
	if ret != "void" do fmt.sbprintf(&b, " -> %s", odin_type(ret))
	return strings.to_string(b)
}
