package gen

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"

// kui/generated.odin, the typed layer: what the schema and kui.h together
// say, in the shape an Odin program wants it.
//
//   - an enum or bit set per family of C constants (ENUMS), its members
//     checked against the schema's name lists;
//   - Spec and Text_Style, one field per PROPS row and CUSTOM composite,
//     with the procedures that lower them to KuiSpec / KuiTextStyle;
//   - a mirror per C struct a door takes or returns: slices where C has a
//     pointer and a count, enums where it has a code, no `size` header;
//   - a door per C function that no hand-written file calls - every verb
//     of schema::DOORS among them, with its row's documentation.
//
// The hand-written files are read first: a C function one of them calls
// is theirs, and every other function gets a door here or a SKIP row
// saying why not. So the binding covers kui.h whole, and a function added
// to the header is a door on the next run, or an error naming it.

Gen :: struct {
	m:            ^C_Model,
	s:            ^Schema,
	enums:        [dynamic]Enum_Def,
	mirrors:      [dynamic]^Mirror, // pointers: a mirror is built while its fields add others
	hand_calls:   map[string]bool, // C functions the hand-written files call
	hand_procs:   map[string]bool,
	hand_structs: map[string][]string, // name -> its fields
	used:         map[string]bool, // policy rows that matched something
	spec_fields:  map[string]bool, // what Spec and Text_Style declare, for check_odin_spellings
	style_fields: map[string]bool,
	out:          strings.Builder,
}

Member :: struct {
	odin, c: string,
	value:   i64,
}

Enum_Def :: struct {
	rule:    Enum_Rule,
	group:   int,
	members: [dynamic]Member,
	bits:    bool,
}

Mirror_Kind :: enum {
	Mirror, // generated here with _to_c / _from_c
	Alias, // the C struct as it is
	Same_Layout, // a hand-written twin, crossing by a cast
	Converted, // Spec, Text_Style, Gradient
}

Mirror :: struct {
	c_name: string,
	odin:   string,
	kind:   Mirror_Kind,
	fields: [dynamic]M_Field,
}

M_Field :: struct {
	decl:   string, // "name: Type", or "" for a field C has and Odin does not
	to_c:   string, // statements over v (the Odin value) and out (the C one)
	from_c: string,
}

emit_typed :: proc(m: ^C_Model, s: ^Schema, kui_dir: string) {
	g := Gen {
		m = m,
		s = s,
	}
	read_hand(&g, kui_dir)
	build_enums(&g)

	b := &g.out
	strings.builder_init(b)
	fmt.sbprintln(b, `// GENERATED by packages/odin/gen from kui.h and kui_core::schema - do not
// edit; `+"`nu scripts/odin.nu gen`"+` rewrites it. What is here and why: the
// header of packages/odin/gen/typed.odin.
package kui

import c "c"
`)
	emit_enums(&g)
	emit_spec(&g)
	doors := plan_doors(&g)
	emit_mirrors(&g)
	emit_doors(&g, doors[:])
	check_doors_column(&g, doors[:])
	check_odin_spellings(&g, doors[:])
	check_events(&g)
	check_elements(&g)
	check_stale(&g)

	write(fmt.tprintf("%s/generated.odin", kui_dir), strings.to_string(g.out))
	n_hand, n_skip := 0, 0
	for f in m.functions {
		if g.hand_calls[f.name] do n_hand += 1
		if skip_reason(&g, f.name) != "" do n_skip += 1
	}
	fmt.printfln(
		"gen: kui: %d enums, %d mirrors, %d doors generated, %d hand-written, %d skipped (%d C functions)",
		len(g.enums),
		count_mirrors(&g),
		len(doors),
		n_hand,
		n_skip,
		len(m.functions),
	)
}

count_mirrors :: proc(g: ^Gen) -> (n: int) {
	for mr in g.mirrors do if mr.kind == .Mirror || mr.kind == .Alias do n += 1
	return
}

// -- The hand-written files ---------------------------------------------------

read_hand :: proc(g: ^Gen, kui_dir: string) {
	matches, _ := filepath.glob(fmt.tprintf("%s/*.odin", kui_dir))
	for path in matches {
		if strings.has_suffix(path, "generated.odin") do continue
		data, err := os.read_entire_file(path, context.allocator)
		if err != nil do fail("cannot read %s: %v", path, err)
		text := string(data)
		// Every `c.name` - a call or a procedure value - is a C function this
		// file is the door for.
		for i := 0; i + 2 < len(text); i += 1 {
			if text[i] != 'c' || text[i + 1] != '.' do continue
			if i > 0 && is_ident_byte(text[i - 1]) do continue
			j := i + 2
			for j < len(text) && is_ident_byte(text[j]) do j += 1
			name := text[i + 2:j]
			if len(name) > 0 && 'a' <= name[0] && name[0] <= 'z' {
				g.hand_calls[fmt.aprintf("kui_%s", strings.trim_suffix(name, "_"))] = true
			}
		}
		// And the top-level names it declares.
		lines := strings.split_lines(text)
		for line, li in lines {
			if len(line) == 0 || line[0] == '\t' || line[0] == ' ' || line[0] == '/' do continue
			sep := strings.index(line, " :: ")
			if sep < 0 do continue
			name := line[:sep]
			rest := line[sep + 4:]
			switch {
			case strings.has_prefix(rest, "proc"):
				g.hand_procs[name] = true
			case strings.has_prefix(rest, "struct"):
				fields: [dynamic]string
				if strings.contains(rest, "}") {
					g.hand_structs[name] = nil // struct {}
					continue
				}
				for fl in lines[li + 1:] {
					if strings.has_prefix(fl, "}") do break
					t := strings.trim_space(fl)
					colon := strings.index_byte(t, ':')
					if colon < 0 || strings.has_prefix(t, "//") do continue
					for n in strings.split(t[:colon], ",") do append(&fields, strings.trim_space(n))
				}
				g.hand_structs[name] = fields[:]
			}
		}
	}
}

is_ident_byte :: proc(ch: u8) -> bool {
	return ch == '_' || ('a' <= ch && ch <= 'z') || ('A' <= ch && ch <= 'Z') || ('0' <= ch && ch <= '9')
}

// -- Enums --------------------------------------------------------------------

build_enums :: proc(g: ^Gen) {
	for rule in ENUMS {
		first := constant(g.m, rule.first)
		if first == nil do fail("ENUMS %s: no constant %s in kui.h", rule.name, rule.first)
		e := Enum_Def {
			rule  = rule,
			group = first.group,
			bits  = rule.flag != "",
		}
		for cst in g.m.constants {
			if cst.group != first.group || !strings.has_prefix(cst.name, rule.prefix) do continue
			v := parse_i64(cst.value)
			if e.bits {
				if v <= 0 || v & (v - 1) != 0 do fail("ENUMS %s: %s = %d is not one bit", rule.name, cst.name, v)
				v = log2(v)
			}
			append(&e.members, Member{ada(cst.name[len(rule.prefix):]), cst.name, v})
		}
		if len(e.members) == 0 do fail("ENUMS %s: nothing in %s's family starts with %s", rule.name, rule.first, rule.prefix)
		if rule.list != "" {
			list, ok := g.s.lists[rule.list]
			if !ok do fail("ENUMS %s: the schema has no list %q", rule.name, rule.list)
			for name in list {
				if member_named(&e, name) == nil do fail("ENUMS %s: the schema's %s has %q, which no %s* constant is", rule.name, rule.list, name, rule.prefix)
			}
		}
		append(&g.enums, e)
	}
}

// The member a schema name is: by its Odin name (spaceBetween is
// Space_Between), or by the C name past KUI_ (easeOut is KUI_EASE_OUT,
// whose member is Out).
member_named :: proc(e: ^Enum_Def, schema_name: string) -> ^Member {
	want := norm(schema_name)
	for &mb in e.members {
		if norm(mb.odin) == want || norm(mb.c[len("KUI_"):]) == want do return &mb
	}
	return nil
}

enum_def :: proc(g: ^Gen, name: string) -> ^Enum_Def {
	for &e in g.enums do if e.rule.name == name do return &e
	return nil
}

// The enum a prop's name list is: the one whose members cover it with the
// fewest to spare.
enum_for_list :: proc(g: ^Gen, prop: string, values: []string) -> string {
	best, spare := "", max(int)
	tie := false
	outer: for &e in g.enums {
		if e.bits do continue
		for v in values do if member_named(&e, v) == nil do continue outer
		extra := len(e.members) - len(values)
		if extra < spare {
			best, spare, tie = e.rule.name, extra, false
		} else if extra == spare {
			tie = true
		}
	}
	if best == "" do fail("prop %s: no ENUMS row covers its values %v - add one", prop, values)
	if tie do fail("prop %s: two ENUMS rows cover %v equally", prop, values)
	return best
}

emit_enums :: proc(g: ^Gen) {
	b := &g.out
	fmt.sbprintln(b, "// -- Enums: one per family of kui.h constants ---------------------------------\n")
	for &e in g.enums {
		backing := e.rule.backing if e.rule.backing != "" else "u32"
		elem := e.rule.flag if e.bits else e.rule.name
		fmt.sbprintfln(b, "%s :: enum %s {{", elem, backing)
		zero := false
		for mb in e.members do if mb.value == 0 do zero = true
		if !e.bits && !zero do fmt.sbprintln(b, "\tUnset = 0,")
		for mb in e.members do fmt.sbprintfln(b, "\t%s = %d, // %s", mb.odin, mb.value, mb.c)
		fmt.sbprintln(b, "}")
		if e.bits do fmt.sbprintfln(b, "%s :: bit_set[%s;%s]", e.rule.name, elem, backing)
		fmt.sbprintln(b)
	}
}

// -- Spec and Text_Style ------------------------------------------------------

Row :: struct {
	field: string, // the Odin field
	decl:  string,
	lower: string,
	doc:   string,
}

emit_spec :: proc(g: ^Gen) {
	spec_rows, style_rows: [dynamic]Row
	for cr in CUSTOM_RULES {
		found := false
		for cu in g.s.custom do if cu.name == cr.name do found = true
		if !found do fail("CUSTOM_RULES %s: the schema has no such CUSTOM row", cr.name)
	}
	for cu in g.s.custom {
		rule: ^Custom_Rule
		for &cr in CUSTOM_RULES do if cr.name == cu.name do rule = &cr
		if rule == nil do fail("schema CUSTOM row %q has no CUSTOM_RULES entry: say whether it is a Spec field, a style field or a verb", cu.name)
		switch rule.target {
		case "spec":
			append(&spec_rows, Row{cu.name, rule.decl, rule.lower, rule.doc})
		case "style":
			append(&style_rows, Row{cu.name, rule.decl, rule.lower, rule.doc})
		case "verb":
			if function(g.m, c_door(rule)) == nil do fail("CUSTOM_RULES %s: no C function %s", rule.name, rule.doc)
		}
	}
	for &p in g.s.props {
		row := prop_row(g, &p)
		if p.target == "style" do append(&style_rows, row)
		else do append(&spec_rows, row)
	}

	written := make(map[string]bool)
	b := &g.out
	fmt.sbprintln(b, `// -- Spec: the node -----------------------------------------------------------

// Everything a node can declare, one field per row of the prop schema
// (kui_core::schema::PROPS and CUSTOM): the zero value is a plain box that
// fits its content, so a literal names only what differs. Messages take
// any value (message.odin); nil is no handler. docs/props.md documents
// every row under its JSX, Lua and C spellings; this is the Odin one.
Spec :: struct {`)
	for r in spec_rows {
		emit_doc(b, r.doc, "\t")
		fmt.sbprintfln(b, "\t%s,", r.decl)
	}
	for r in spec_rows do note_fields(r.decl, &g.spec_fields)
	for r in style_rows do note_fields(r.decl, &g.style_fields)
	fmt.sbprintln(b, `}

// Spec as kui_open reads it. The message fields with a C field are
// borrowed (encoded into scratch, freed after the call); on_click, on_drag,
// on_key and on_hover are open's arguments and lowered there.
spec_to_c :: proc(s: Spec, out: ^c.Spec, scratch: ^Scratch) {`)
	for r in spec_rows {
		if r.lower == "" do continue
		fmt.sbprintfln(b, "\t%s", r.lower)
		note_writes(r.lower, &written)
	}
	fmt.sbprintln(b, "}\n")
	check_written(g, "KuiSpec", written)

	clear(&written)
	fmt.sbprintln(b, `// -- Text_Style ------------------------------------------------------------------

// How a text is set, one field per style row of the prop schema; the zero
// value is the theme's body text.
Text_Style :: struct {`)
	for r in style_rows {
		emit_doc(b, r.doc, "\t")
		fmt.sbprintfln(b, "\t%s,", r.decl)
	}
	fmt.sbprintln(b, "}\n\ntext_style_to_c :: proc(s: Text_Style) -> (out: c.TextStyle) {")
	for r in style_rows {
		fmt.sbprintfln(b, "\t%s", r.lower)
		note_writes(r.lower, &written)
	}
	fmt.sbprintln(b, "\treturn\n}\n")
	check_written(g, "KuiTextStyle", written)
}

// The C function a verb CUSTOM row names.
c_door :: proc(r: ^Custom_Rule) -> string {return r.doc}

prop_row :: proc(g: ^Gen, p: ^Prop) -> Row {
	f := ident(p.snake)
	c_struct := "KuiTextStyle" if p.target == "style" else "KuiSpec"
	rec := record(g.m, c_struct)
	c_field: ^Field
	for &fl in rec.fields do if fl.name == p.snake do c_field = &fl

	is_maybe := slice.contains(MAYBE_ROWS, p.name)
	is_int := slice.contains(INT_ROWS, p.name)
	if is_maybe do g.used[fmt.tprintf("maybe.%s", p.name)] = true
	if is_int do g.used[fmt.tprintf("int.%s", p.name)] = true

	typ := ""
	switch p.kind {
	case "f32":
		typ = "int" if is_int else "f32"
	case "color":
		typ = "Color"
	case "flag":
		typ = "bool"
	case "enum":
		typ = enum_for_list(g, p.name, p.values)
	case "sizing":
		typ = "Size"
	case "min", "max":
		// A zero Size is Fit, which on a clamp is "the fit size": unset has
		// to be its own value.
		typ = "Maybe(Size)"
	case "msg", "tag":
		typ = "any"
	case "str":
		typ = "string"
	case "family":
		typ = enum_for_list(g, p.name, p.values)
	case "resource":
		typ = ""
	case "keyframes":
		typ = "[]Keyframe"
	case "enter":
		typ = "Enter"
	case "gradient":
		typ = "Maybe(Gradient)"
	case:
		fail("prop %s: a kind the generator does not know: %s", p.name, p.kind)
	}
	for pt in PROP_TYPES do if pt[0] == p.name {
		typ = pt[1]
		g.used[fmt.tprintf("prop_type.%s", p.name)] = true
	}
	if typ == "" do fail("prop %s: a %s row needs a PROP_TYPES entry naming its handle", p.name, p.kind)
	if is_maybe do typ = fmt.tprintf("Maybe(%s)", typ)

	lower := ""
	for l in LOWERING do if l[0] == p.name {
		lower, _ = strings.replace_all(l[1], "{f}", f)
		g.used[fmt.tprintf("lowering.%s", p.name)] = true
	}
	if lower == "" {
		if c_field == nil {
			if p.kind == "msg" || p.kind == "tag" {
				// onClick, onDrag, onKey, onHover: open's arguments.
				if !slice.contains([]string{"onClick", "onDrag", "onKey", "onHover"}, p.name) {
					fail("prop %s: a message row with no KuiSpec field, and not one of open's arguments", p.name)
				}
			} else {
				fail("prop %s: KuiSpec/KuiTextStyle has no field %s and LOWERING has no row for it", p.name, p.snake)
			}
		} else {
			lower = default_lowering(g, p, f, typ, c_field)
		}
	}
	return {f, fmt.tprintf("%s: %s", f, typ), lower, p.doc}
}

default_lowering :: proc(g: ^Gen, p: ^Prop, f, typ: string, cf: ^Field) -> string {
	ct := bare(cf.type)
	dst := fmt.tprintf("out.%s", cf.name)
	// A string row that is a set of bits in C (buttons, scrollMods).
	if e := enum_def(g, typ); e != nil && e.bits do return fmt.tprintf("%s = transmute(u32)s.%s", dst, f)
	switch p.kind {
	case "f32", "color", "str":
		if ct == "uint32_t" && p.kind == "f32" do return fmt.tprintf("%s = u32(s.%s)", dst, f)
		return fmt.tprintf("%s = s.%s", dst, f)
	case "flag":
		if ct == "bool" do return fmt.tprintf("%s = s.%s", dst, f)
		return fmt.tprintf("%s = 1 if s.%s else 0", dst, f)
	case "enum", "family":
		return fmt.tprintf("%s = u32(s.%s)", dst, f)
	case "sizing":
		return fmt.tprintf("%s = transmute(c.Sizing)s.%s", dst, f)
	case "resource":
		return fmt.tprintf("%s = u64(s.%s)", dst, f)
	case "enter":
		return fmt.tprintf("%s = transmute(c.Enter)s.%s", dst, f)
	case "keyframes":
		return fmt.tprintf("%s, out.keyframes_len = ([^]c.Keyframe)(raw_data(s.%s)), uint(len(s.%s))", dst, f, f)
	case "gradient":
		return fmt.tprintf("if gr, ok := s.%s.?; ok do %s = lower_gradient(gr)", f, dst)
	case "msg", "tag":
		return fmt.tprintf("%s = borrow(scratch, s.%s)", dst, f)
	}
	fail("prop %s: no default lowering for kind %s", p.name, p.kind)
}

// Every `out.x` a lowering writes, and what its helpers write.
note_writes :: proc(code: string, written: ^map[string]bool) {
	for i := 0; i + 4 < len(code); i += 1 {
		if !strings.has_prefix(code[i:], "out.") || (i > 0 && is_ident_byte(code[i - 1])) do continue
		j := i + 4
		for j < len(code) && is_ident_byte(code[j]) do j += 1
		written[code[i + 4:j]] = true
	}
	for hw in HELPER_WRITES {
		if strings.contains(code, fmt.tprintf("%s(", hw[0])) {
			for f in strings.fields(hw[1]) do written[f] = true
		}
	}
}

check_written :: proc(g: ^Gen, c_struct: string, written: map[string]bool) {
	missed: [dynamic]string
	for f in record(g.m, c_struct).fields do if !written[f.name] do append(&missed, f.name)
	if len(missed) > 0 do fail("%s fields no schema row lowers to: %v", c_struct, missed)
}

// -- Doors --------------------------------------------------------------------

Door_Plan :: struct {
	f:     ^Function,
	procs: strings.Builder,
}

skip_reason :: proc(g: ^Gen, c_name: string) -> string {
	for sk in SKIP do if sk[0] == c_name {
		g.used[fmt.tprintf("skip.%s", c_name)] = true
		return sk[1]
	}
	return ""
}

plan_doors :: proc(g: ^Gen) -> (doors: [dynamic]^Function) {
	for &f in g.m.functions {
		if g.hand_calls[f.name] {
			if skip_reason(g, f.name) != "" do fail("SKIP %s: the hand-written files call it, so the row is stale", f.name)
			continue
		}
		if skip_reason(g, f.name) != "" do continue
		append(&doors, &f)
	}
	// Every verb of the schema's table reaches Odin.
	for d in g.s.doors {
		if d.c_cell != "is" do continue
		if function(g.m, d.c_text) == nil do fail("DOORS %s names %s, which kui.h does not declare", d.rust, d.c_text)
	}
	// The mirrors the doors need, found while lowering their signatures.
	for f in doors {
		for p in f.params do note_struct_use(g, p.type)
		note_struct_use(g, f.ret)
	}
	return
}

note_struct_use :: proc(g: ^Gen, c_type: string) {
	t := bare(c_type)
	for strings.has_suffix(t, "*") do t = strings.trim_space(t[:len(t) - 1])
	if !strings.has_prefix(t, "Kui") || t == "KuiStr" || t == "KuiCtx" || t == "KuiValue" || t == "KuiReplySink" do return
	if record(g.m, t) == nil do return // a callback typedef
	mirror_of(g, t)
}

mirror_of :: proc(g: ^Gen, c_name: string) -> ^Mirror {
	for mr in g.mirrors do if mr.c_name == c_name do return mr
	add :: proc(g: ^Gen, mr: Mirror) -> ^Mirror {
		p := new(Mirror)
		p^ = mr
		append(&g.mirrors, p)
		return p
	}
	for sl in SAME_LAYOUT do if sl[0] == c_name do return add(g, {c_name = c_name, odin = sl[1], kind = .Same_Layout})
	for cv in CONVERTED do if cv[0] == c_name do return add(g, {c_name = c_name, odin = cv[1], kind = .Converted})
	name := ada(type_name(c_name))
	for sn in STRUCT_NAMES do if sn[0] == c_name {
		name = sn[1]
		g.used[fmt.tprintf("struct_name.%s", c_name)] = true
	}
	// Placed before its fields are lowered, so a struct that names itself
	// through a pointer finds it.
	mr := add(g, {c_name = c_name, odin = name, kind = .Alias})
	mr.fields = mirror_fields(g, c_name)
	for fl in mr.fields do if fl.to_c != "" || fl.decl == "" do mr.kind = .Mirror
	return mr
}

// A mirror's Odin type for a C struct, and whether crossing needs a call.
needs_call :: proc(mr: ^Mirror) -> bool {return mr.kind == .Mirror || mr.kind == .Converted}

to_c_expr :: proc(mr: ^Mirror, v: string) -> string {
	switch mr.kind {
	case .Mirror:
		return fmt.tprintf("%s_to_c(%s, scratch)", snake_of(mr.odin), v)
	case .Same_Layout:
		return fmt.tprintf("transmute(c.%s)%s", type_name(mr.c_name), v)
	case .Alias:
		return v
	case .Converted:
		switch mr.odin {
		case "Text_Style":
			return fmt.tprintf("text_style_to_c(%s)", v)
		case "Gradient":
			return fmt.tprintf("lower_gradient(%s)^", v)
		}
	}
	fail("%s cannot be lowered inside another struct", mr.c_name)
}

from_c_expr :: proc(mr: ^Mirror, v: string) -> string {
	switch mr.kind {
	case .Mirror:
		return fmt.tprintf("%s_from_c(%s)", snake_of(mr.odin), v)
	case .Same_Layout:
		return fmt.tprintf("transmute(%s)%s", mr.odin, v)
	case .Alias:
		return v
	case .Converted:
	}
	fail("%s cannot be read back from C", mr.c_name)
}

// Whether `count` is the length of the array `ptr`: a bare count or len,
// or one named for it - stops / stops_len, ops / op_count - and not the
// next array's (an access run's char_widths and word_start_count).
counts :: proc(ptr, count: string) -> bool {
	if count == "count" || count == "len" do return true
	stem := ""
	switch {
	case strings.has_suffix(count, "_count"):
		stem = count[:len(count) - len("_count")]
	case strings.has_suffix(count, "_len"):
		stem = count[:len(count) - len("_len")]
	case:
		return false
	}
	return strings.has_prefix(ptr, stem)
}

typed :: proc(g: ^Gen, key: string) -> string {
	for t in TYPED do if t[0] == key {
		g.used[fmt.tprintf("typed.%s", key)] = true
		return t[1]
	}
	return ""
}

mirror_fields :: proc(g: ^Gen, c_name: string) -> (out: [dynamic]M_Field) {
	rec := record(g.m, c_name)
	has_size := len(rec.fields) > 0 && rec.fields[0].name == "size" && rec.fields[0].type == "uint32_t"
	short := type_name(c_name)
	skip_next := false
	for fl, i in rec.fields {
		if skip_next {
			skip_next = false
			continue
		}
		n := ident(fl.name)
		ct := bare(fl.type)
		raw := odin_type(fl.type, many = i + 1 < len(rec.fields) && rec.fields[i + 1].type == "size_t")
		if i == 0 && has_size {
			append(&out, M_Field{"", fmt.tprintf("out.size = size_of(c.%s)", short), ""})
			continue
		}
		// A pointer whose count is elsewhere in the struct (SLICE_COUNTS).
		explicit := ""
		for sc in SLICE_COUNTS do if sc[0] == fmt.tprintf("%s.%s", short, fl.name) {
			explicit = sc[1]
			g.used[fmt.tprintf("slice_count.%s", sc[0])] = true
		}
		if explicit != "" {
			elem_odin, elem_c, _ := elem_types(g, pointee(fl.type))
			append(
				&out,
				M_Field {
					fmt.tprintf("%s: []%s", n, elem_odin),
					fmt.tprintf("out.%s = ([^]%s)(raw_data(v.%s))", n, elem_c, n),
					fmt.tprintf("out.%s = ([^]%s)(v.%s)[:v.%s]", n, elem_odin, n, explicit),
				},
			)
			continue
		}
		// A field whose INIT macro is not its zero (FIELD_DEFAULTS).
		fdefault := ""
		for fd in FIELD_DEFAULTS do if fd[0] == fmt.tprintf("%s.%s", short, fl.name) {
			fdefault = fd[1]
			g.used[fmt.tprintf("field_default.%s", fd[0])] = true
		}
		if fdefault != "" {
			// A flag's default is true, false, or a condition on the struct's
			// other fields (`v.kind != .Popup`), when the INIT macros differ.
			if fdefault == "true" || fdefault == "false" || strings.has_prefix(fdefault, "v.") {
				append(
					&out,
					M_Field {
						fmt.tprintf("%s: Maybe(bool)", n),
						fmt.tprintf("out.%s = 1 if (v.%s.? or_else %s) else 0", n, n, fdefault),
						fmt.tprintf("out.%s = v.%s != 0", n, n),
					},
				)
			} else {
				append(
					&out,
					M_Field {
						fmt.tprintf("%s: Maybe(%s)", n, raw),
						fmt.tprintf("out.%s = v.%s.? or_else %s", n, n, fdefault),
						fmt.tprintf("out.%s = v.%s", n, n),
					},
				)
			}
			continue
		}
		// A pointer and the count after it, named for it: a slice.
		if is_pointer(fl.type) && i + 1 < len(rec.fields) && counts(fl.name, rec.fields[i + 1].name) {
			cn := rec.fields[i + 1].name
			ccount := odin_type(rec.fields[i + 1].type)
			elem := pointee(fl.type)
			elem_odin, elem_c, conv := elem_types(g, elem)
			to, from: string
			if conv != nil && needs_call(conv) {
				to = fmt.tprintf(
					"{{ tmp := make([]%s, len(v.%s), context.temp_allocator); for x, k in v.%s do tmp[k] = %s; out.%s, out.%s = raw_data(tmp), %s(len(tmp)) }}",
					elem_c,
					n,
					n,
					to_c_expr(conv, "x"),
					n,
					cn,
					ccount,
				)
				if conv.kind == .Mirror {
					from = fmt.tprintf(
						"{{ tmp := make([]%s, v.%s, context.temp_allocator); for &x, k in tmp do x = %s; out.%s = tmp }}",
						elem_odin,
						cn,
						from_c_expr(conv, fmt.tprintf("v.%s[k]", n)),
						n,
					)
				}
			} else {
				to = fmt.tprintf("out.%s, out.%s = ([^]%s)(raw_data(v.%s)), %s(len(v.%s))", n, cn, elem_c, n, ccount, n)
				from = fmt.tprintf("out.%s = ([^]%s)(v.%s)[:v.%s]", n, elem_odin, n, cn)
			}
			append(&out, M_Field{fmt.tprintf("%s: []%s", n, elem_odin), to, from})
			skip_next = true
			continue
		}
		if ct == "KuiValue *" {
			if has_size {
				append(&out, M_Field{fmt.tprintf("%s: Value", n), fmt.tprintf("out.%s = (^c.Value)(v.%s)", n, n), fmt.tprintf("out.%s = Value(v.%s)", n, n)})
			} else {
				append(&out, M_Field{fmt.tprintf("%s: any", n), fmt.tprintf("out.%s = borrow(scratch, v.%s)", n, n), ""})
			}
			continue
		}
		if t := typed(g, fmt.tprintf("%s.%s", short, fl.name)); t != "" {
			append(&out, typed_field(g, n, t, raw))
			continue
		}
		inverted := ""
		for iv in INVERTED do if iv[0] == fmt.tprintf("%s.%s", short, fl.name) {
			inverted = iv[1]
			g.used[fmt.tprintf("inverted.%s", iv[0])] = true
		}
		if inverted != "" {
			append(
				&out,
				M_Field {
					fmt.tprintf("%s: bool", inverted),
					fmt.tprintf("out.%s = 0 if v.%s else 1", n, inverted),
					fmt.tprintf("out.%s = v.%s == 0", inverted, n),
				},
			)
			continue
		}
		if slice.contains(BOOL_FIELDS, fl.name) && ct == "uint32_t" {
			g.used[fmt.tprintf("bool.%s", fl.name)] = true
			append(&out, M_Field{fmt.tprintf("%s: bool", n), fmt.tprintf("out.%s = 1 if v.%s else 0", n, n), fmt.tprintf("out.%s = v.%s != 0", n, n)})
			continue
		}
		if strings.has_prefix(ct, "Kui") && ct != "KuiStr" && !is_pointer(ct) {
			nested := mirror_of(g, ct)
			if nested.kind != .Alias {
				append(
					&out,
					M_Field {
						fmt.tprintf("%s: %s", n, nested.odin),
						fmt.tprintf("out.%s = %s", n, to_c_expr(nested, fmt.tprintf("v.%s", n))),
						fmt.tprintf("out.%s = %s", n, from_c_expr(nested, fmt.tprintf("v.%s", n))),
					},
				)
				continue
			}
			append(&out, M_Field{fmt.tprintf("%s: %s", n, nested.odin), "", ""})
			continue
		}
		append(&out, M_Field{fmt.tprintf("%s: %s", n, c_qualified(raw)), "", ""})
	}
	// A plain field is copied by the procedures too, once there are any.
	return
}

// The Odin and C element types of a C array, and the struct it is when it
// is one.
elem_types :: proc(g: ^Gen, c_elem: string) -> (odin, c_side: string, mr: ^Mirror) {
	t := bare(c_elem)
	if p, ok := primitive(t); ok do return p, p, nil
	if strings.has_prefix(t, "Kui") {
		mr = mirror_of(g, t)
		return mr.odin, fmt.tprintf("c.%s", type_name(t)), mr
	}
	fail("an array of %s", c_elem)
}

typed_field :: proc(g: ^Gen, n, t, raw: string) -> M_Field {
	switch {
	case t == "Color":
		return {fmt.tprintf("%s: Color", n), "", ""}
	case slice.contains(HANDLES, t):
		return {fmt.tprintf("%s: %s", n, t), fmt.tprintf("out.%s = u64(v.%s)", n, n), fmt.tprintf("out.%s = %s(v.%s)", n, t, n)}
	}
	e := enum_def(g, t)
	if e == nil do fail("TYPED names %s, which is not an enum, a handle or Color", t)
	if e.bits {
		return {fmt.tprintf("%s: %s", n, t), fmt.tprintf("out.%s = transmute(%s)v.%s", n, raw, n), fmt.tprintf("out.%s = transmute(%s)v.%s", n, t, n)}
	}
	return {fmt.tprintf("%s: %s", n, t), fmt.tprintf("out.%s = %s(v.%s)", n, raw, n), fmt.tprintf("out.%s = %s(v.%s)", n, t, n)}
}

emit_mirrors :: proc(g: ^Gen) {
	b := &g.out
	fmt.sbprintln(b, "// -- The structs the doors take and return -------------------------------------\n")
	for mr in g.mirrors {
		switch mr.kind {
		case .Alias:
			fmt.sbprintfln(b, "%s :: c.%s\n", mr.odin, type_name(mr.c_name))
		case .Mirror:
			fmt.sbprintfln(b, "// kui.h's %s.", mr.c_name)
			fmt.sbprintfln(b, "%s :: struct {{", mr.odin)
			for fl in mr.fields do if fl.decl != "" do fmt.sbprintfln(b, "\t%s,", fl.decl)
			fmt.sbprintln(b, "}\n")
			sn := snake_of(mr.odin)
			fmt.sbprintfln(b, "%s_to_c :: proc(v: %s, scratch: ^Scratch) -> (out: c.%s) {{", sn, mr.odin, type_name(mr.c_name))
			uses_scratch := false
			for fl in mr.fields {
				if fl.to_c != "" {
					fmt.sbprintfln(b, "\t%s", fl.to_c)
					if strings.contains(fl.to_c, "scratch") do uses_scratch = true
				} else if fl.decl != "" {
					n := fl.decl[:strings.index_byte(fl.decl, ':')]
					fmt.sbprintfln(b, "\tout.%s = v.%s", n, n)
				}
			}
			if !uses_scratch do fmt.sbprintln(b, "\t_ = scratch")
			fmt.sbprintln(b, "\treturn\n}\n")
			fmt.sbprintfln(b, "%s_from_c :: proc(v: c.%s) -> (out: %s) {{", sn, type_name(mr.c_name), mr.odin)
			for fl in mr.fields {
				if fl.decl == "" do continue
				if fl.from_c != "" {
					fmt.sbprintfln(b, "\t%s", fl.from_c)
				} else if fl.to_c == "" {
					n := fl.decl[:strings.index_byte(fl.decl, ':')]
					fmt.sbprintfln(b, "\tout.%s = v.%s", n, n)
				}
			}
			fmt.sbprintln(b, "\treturn\n}\n")
		case .Same_Layout, .Converted:
		}
	}
}

// One parameter of a door, lowered.
D_Param :: struct {
	decl:        string, // "name: Type"
	default_:    string, // "" when it has none
	defaultable: string, // the default it may take as part of a trailing run
}

D_Ret :: struct {
	name, type: string,
	set:        string, // the statement that fills it after the call, "" when the call fills it
}

emit_doors :: proc(g: ^Gen, doors: []^Function) {
	b := &g.out
	fmt.sbprintln(b, "// -- Doors: one per C function the hand-written files do not call --------------\n")
	for f in doors {
		if g.hand_procs[raw_name(f.name)] do fail("door %s collides with a hand-written procedure of that name", raw_name(f.name))
		emit_door(g, f)
	}
}

emit_door :: proc(g: ^Gen, f: ^Function) {
	params: [dynamic]D_Param
	pre, args, post: [dynamic]string
	rets: [dynamic]D_Ret
	uses_scratch := false
	out_array := false
	array_code: string
	ps := f.params[:]

	for i := 0; i < len(ps); i += 1 {
		p := ps[i]
		n := ident(p.name)
		t := p.type
		bt := bare(t)
		if i == 0 && bt == "KuiCtx *" {
			append(&params, D_Param{decl = "ui: ^Ui"})
			append(&args, "ui")
			continue
		}
		if fnt := fn_typedef(g, bt); fnt != "" do fail("%s: parameter %s is a callback (%s); write its door by hand", f.name, p.name, fnt)

		// An array: a pointer, any parallel arrays of its type, a size_t.
		if cp := count_param(ps[i:]); cp > 0 && is_pointer(t) {
			arrays := ps[i:i + cp]
			elem := pointee(t)
			elem_odin, elem_c, mr := elem_types(g, elem)
			if et := typed(g, fmt.tprintf("%s.%s", f.name, p.name)); et != "" do elem_odin = et
			if p.name == "ids" && handle_of_family(f.name) != "" do elem_odin = handle_of_family(f.name)
			if slice.contains(POINTS, fmt.tprintf("%s.%s", f.name, p.name)) {
				if elem != "float" || cp != 1 do fail("POINTS %s.%s: not a lone float array", f.name, p.name)
				g.used[fmt.tprintf("points.%s.%s", f.name, p.name)] = true
				elem_odin = "[2]f32"
			}
			if is_const_pointer(t) {
				for a, k in arrays {
					an := ident(a.name)
					append(&params, D_Param{decl = fmt.tprintf("%s: []%s", an, elem_odin)})
					if mr != nil && needs_call(mr) {
						uses_scratch = true
						append(&pre, fmt.tprintf("%s_c := make([]%s, len(%s), context.temp_allocator)", an, elem_c, an))
						elem_expr, _ := strings.replace_all(to_c_expr(mr, "x"), "scratch)", "&scratch)")
						append(&pre, fmt.tprintf("for x, k in %s do %s_c[k] = %s", an, an, elem_expr))
						append(&args, fmt.tprintf("raw_data(%s_c)", an))
					} else {
						append(&args, fmt.tprintf("([^]%s)(raw_data(%s))", elem_c, an))
					}
					if k > 0 do append(&pre, fmt.tprintf("assert(len(%s) == len(%s))", an, ident(arrays[0].name)))
				}
				append(&args, fmt.tprintf("uint(len(%s))", ident(arrays[0].name)))
				i += cp
				continue
			}
			// Filled by the call: a query returns the total and is asked
			// twice, a take_ drains in chunks.
			if cp != 1 || f.ret != "size_t" do fail("%s: an out array %s the generator cannot read", f.name, p.name)
			out_array = true
			conv := ""
			if mr != nil && mr.kind == .Mirror do conv = from_c_expr(mr, "x")
			before := strings.join(args[:], ", ")
			sep := ", " if len(args) > 0 else ""
			collect := fmt.tprintf("%s = buf[:n]", n)
			if conv != "" {
				collect = fmt.tprintf("%s = make([]%s, n, context.temp_allocator)\n\tfor x, k in buf[:n] do %s[k] = %s", n, elem_odin, n, conv)
			}
			if strings.has_prefix(raw_name(f.name), "take_") {
				// A drain whose rest wait (warnings) is asked again until a
				// chunk comes back short; one that drops the rest
				// (announcements, audio commands: "size it generously",
				// kui.h) gets what a chunk holds, so the chunk is generous.
				// A string in what a drain hands out is borrowed until the
				// door's next call, and the next chunk is one: each chunk's
				// are kept before it is asked for.
				keep := ""
				if r := record(g.m, bare(elem)); r != nil {
					for fl in r.fields do if bare(fl.type) == "KuiStr" {
						keep = fmt.tprintf("%s\n\t\t\tx.%s = kept(x.%s)", keep, ident(fl.name), ident(fl.name))
					}
				}
				if keep != "" do keep = fmt.tprintf("\n\t\tfor &x in chunk[:min(got, len(chunk))] {{%s\n\t\t}}", keep)
				array_code = fmt.tprintf(
					"all := make([dynamic]%s, context.temp_allocator)\n\tchunk := make([]%s, 1024, context.temp_allocator)\n\tfor {{\n\t\tgot := int(c.%s(%s%sraw_data(chunk[:]), len(chunk)))%s\n\t\tappend(&all, ..chunk[:min(got, len(chunk))])\n\t\tif got < len(chunk) do break\n\t}}\n\tbuf := all[:]\n\tn := len(buf)\n\t%s",
					elem_c,
					elem_c,
					raw_name(f.name),
					before,
					sep,
					keep,
					collect,
				)
			} else {
				array_code = fmt.tprintf(
					"total := int(c.%s(%s%snil, 0))\n\tbuf := make([]%s, total, context.temp_allocator)\n\tn := min(int(c.%s(%s%sraw_data(buf), uint(total))), total)\n\t%s",
					raw_name(f.name),
					before,
					sep,
					elem_c,
					raw_name(f.name),
					before,
					sep,
					collect,
				)
			}
			append(&rets, D_Ret{n, fmt.tprintf("[]%s", elem_odin), ""})
			i += cp
			continue
		}

		switch {
		case bt == "KuiStr":
			append(&params, D_Param{decl = fmt.tprintf("%s: string", n)})
			append(&args, n)
		case bt == "KuiValue *":
			// A KuiValue the call consumes (kui.h writes it without const) or
			// borrows (with): either way an Odin message, encoded here.
			append(&params, D_Param{decl = fmt.tprintf("%s: any", n), defaultable = "nil"})
			if is_const_pointer(t) {
				uses_scratch = true
				append(&args, fmt.tprintf("borrow(&scratch, %s)", n))
			} else {
				append(&args, fmt.tprintf("to_value(%s)", n))
			}
		case bt == "uint8_t *":
			// Bytes are the data itself, as many as the size beside them says
			// (BYTE_LENGTHS).
			want := ""
			for bl in BYTE_LENGTHS do if bl[0] == fmt.tprintf("%s.%s", f.name, p.name) {
				want = bl[1]
				g.used[fmt.tprintf("byte_lengths.%s", bl[0])] = true
			}
			if want == "" do fail("%s: byte array %s has no BYTE_LENGTHS row", f.name, p.name)
			append(&params, D_Param{decl = fmt.tprintf("%s: []u8", n)})
			append(&pre, fmt.tprintf("assert(%s == nil || len(%s) >= %s, \"%s: %s holds fewer bytes than %s\")", n, n, want, raw_name(f.name), n, want))
			append(&args, fmt.tprintf("raw_data(%s)", n))
		case bt == "float *" && is_const_pointer(t):
			// A float array with no count is a fixed shape the call may go
			// without (a pivot, a dash): a fixed array, optional
			// (FIXED_FLOATS).
			size := ""
			for ff in FIXED_FLOATS do if ff[0] == fmt.tprintf("%s.%s", f.name, p.name) {
				size = ff[1]
				g.used[fmt.tprintf("fixed_floats.%s", ff[0])] = true
			}
			if size == "" do fail("%s: float array %s has no count and no FIXED_FLOATS row", f.name, p.name)
			append(&params, D_Param{decl = fmt.tprintf("%s: Maybe([%s]f32)", n, size), defaultable = "nil"})
			append(&pre, fmt.tprintf("%s_v, %s_ok := %s.?", n, n, n))
			append(&args, fmt.tprintf("raw_data(%s_v[:]) if %s_ok else nil", n, n))
		case is_const_pointer(t) && strings.has_prefix(pointee(t), "Kui"):
			mr := mirror_of(g, pointee(t))
			// The node's spec and a text's style are optional; another struct is
			// the call's input, unless DEFAULTS gives it a useful default.
			dflt := "{}" if mr.odin == "Spec" || mr.odin == "Text_Style" else ""
			for d in DEFAULTS do if d[0] == fmt.tprintf("%s.%s", f.name, p.name) {
				dflt = d[1]
				g.used[fmt.tprintf("default.%s", d[0])] = true
			}
			key := fmt.tprintf("%s.%s", f.name, p.name)
			if slice.contains(NULLABLE, key) {
				// NULL means something here (kui.h says what): a Maybe.
				g.used[fmt.tprintf("nullable.%s", key)] = true
				append(&params, D_Param{decl = fmt.tprintf("%s: Maybe(%s)", n, mr.odin), defaultable = "nil"})
				if mr.kind == .Mirror do uses_scratch = true
				expr, _ := strings.replace_all(to_c_expr(mr, "v"), "scratch)", "&scratch)")
				append(&pre, fmt.tprintf("%s_tmp: c.%s", n, type_name(mr.c_name)))
				append(&pre, fmt.tprintf("%s_c: ^c.%s", n, type_name(mr.c_name)))
				append(&pre, fmt.tprintf("if v, ok := %s.?; ok {{ %s_tmp = %s; %s_c = &%s_tmp }}", n, n, expr, n, n))
				append(&args, fmt.tprintf("%s_c", n))
				continue
			}
			append(&params, D_Param{decl = fmt.tprintf("%s: %s", n, mr.odin), defaultable = dflt})
			cn := fmt.tprintf("%s_c", n)
			if mr.odin == "Spec" {
				uses_scratch = true
				append(&pre, fmt.tprintf("%s: c.Spec", cn))
				append(&pre, fmt.tprintf("spec_to_c(%s, &%s, &scratch)", n, cn))
			} else {
				if mr.kind == .Mirror do uses_scratch = true
				expr, _ := strings.replace_all(to_c_expr(mr, n), "scratch)", "&scratch)")
				append(&pre, fmt.tprintf("%s := %s", cn, expr))
			}
			append(&args, fmt.tprintf("&%s", cn))
		case is_pointer(t) && !is_const_pointer(t):
			// An out-param.
			inner := pointee(t)
			out_name := n
			if inner == "KuiStr" {
				append(&rets, D_Ret{out_name, "string", ""})
				append(&args, fmt.tprintf("&%s", out_name))
			} else if strings.has_prefix(inner, "Kui") {
				rec := record(g.m, inner)
				if rec == nil || rec.fields[0].name != "size" do fail("%s: out-param %s is a %s with no size header; write its door by hand", f.name, p.name, inner)
				mr := mirror_of(g, inner)
				append(&pre, fmt.tprintf("c_%s := c.%s{{size = size_of(c.%s)}}", out_name, type_name(inner), type_name(inner)))
				append(&args, fmt.tprintf("&c_%s", out_name))
				append(&rets, D_Ret{out_name, mr.odin, fmt.tprintf("%s = %s", out_name, from_c_expr(mr, fmt.tprintf("c_%s", out_name)))})
			} else if prim, ok := primitive(inner); ok {
				ot, conv := scalar_type(g, f, p.name, inner)
				append(&pre, fmt.tprintf("c_%s: %s", out_name, prim))
				append(&args, fmt.tprintf("&c_%s", out_name))
				append(&rets, D_Ret{out_name, ot, fmt.tprintf("%s = %s", out_name, from_scalar(conv, ot, fmt.tprintf("c_%s", out_name)))})
			} else {
				fail("%s: out-param %s of type %s; write its door by hand", f.name, p.name, t)
			}
		case:
			if _, ok := primitive(bt); !ok do fail("%s: parameter %s of type %s", f.name, p.name, t)
			ot, conv := scalar_type(g, f, p.name, bt)
			dflt := ""
			for d in DEFAULTS do if d[0] == fmt.tprintf("%s.%s", f.name, p.name) {
				dflt = d[1]
				g.used[fmt.tprintf("default.%s", d[0])] = true
			}
			append(&params, D_Param{decl = fmt.tprintf("%s: %s", n, ot), defaultable = dflt})
			append(&args, to_scalar(conv, odin_type(bt), n))
		}
	}

	// The C return.
	call := fmt.tprintf("c.%s(%s)", raw_name(f.name), strings.join(args[:], ", "))
	ret_bt := bare(f.ret)
	result_set := ""
	switch {
	case out_array:
	// The count was the array's.
	case f.ret == "void":
	case f.ret == "bool" && len(rets) > 0:
		append(&rets, D_Ret{"ok", "bool", ""})
		result_set = fmt.tprintf("ok = %s", call)
	case ret_bt == "KuiValue *":
		inject_at(&rets, 0, D_Ret{"result", "Value", ""})
		result_set = fmt.tprintf("result = Value(%s)", call)
	case strings.has_prefix(ret_bt, "Kui") && record(g.m, ret_bt) != nil:
		// A struct by value: KuiSizing.
		mr := mirror_of(g, ret_bt)
		inject_at(&rets, 0, D_Ret{"result", mr.odin, ""})
		result_set = fmt.tprintf("result = %s", from_c_expr(mr, call))
	case:
		ot, conv := scalar_type(g, f, "return", ret_bt)
		inject_at(&rets, 0, D_Ret{"result", ot, ""})
		result_set = fmt.tprintf("result = %s", from_scalar(conv, ot, call))
	}

	// Trailing parameters with a default take it, as a run from the end.
	for k := len(params) - 1; k >= 0; k -= 1 {
		if params[k].defaultable == "" do break
		params[k].default_ = params[k].defaultable
	}

	b := &g.out
	if d := door_for(g.s, f.name); d != nil {
		emit_doc(b, d.doc, "")
		fmt.sbprintfln(b, "// Rust: %s.", d.rust)
	} else {
		fmt.sbprintfln(b, "// %s (kui.h).", f.name)
	}
	opener := slice.contains(OPENERS, f.name)
	if opener {
		g.used[fmt.tprintf("opener.%s", f.name)] = true
		if f.ret != "void" || len(rets) > 0 do fail("OPENERS %s: an opener returns nothing in C", f.name)
		fmt.sbprintln(b, "// Opens a node: `if` it, and the block's end closes it.")
		fmt.sbprintfln(b, "@(deferred_in = close_%s)", raw_name(f.name))
		append(&rets, D_Ret{"result", "bool", ""})
		result_set = fmt.tprintf("result = true")
		append(&post, call)
	}
	fmt.sbprintf(b, "%s :: proc(", raw_name(f.name))
	for p, k in params {
		if k > 0 do fmt.sbprint(b, ", ")
		fmt.sbprint(b, p.decl)
		if p.default_ != "" do fmt.sbprintf(b, " = %s", p.default_)
	}
	fmt.sbprint(b, ")")
	// One plain result is returned, not named.
	single := len(rets) == 1 && rets[0].name == "result" && len(post) == 0
	if opener do single = false
	if single {
		fmt.sbprintf(b, " -> %s", rets[0].type)
	} else if len(rets) > 0 {
		fmt.sbprint(b, " -> (")
		for r, k in rets {
			if k > 0 do fmt.sbprint(b, ", ")
			fmt.sbprintf(b, "%s: %s", r.name, r.type)
		}
		fmt.sbprint(b, ")")
		// A value and whether there was one: the ok may be left off.
		if len(rets) == 2 && rets[1].name == "ok" do fmt.sbprint(b, " #optional_ok")
	}
	fmt.sbprintln(b, " {")
	if uses_scratch {
		fmt.sbprintln(b, "\tscratch: Scratch")
		fmt.sbprintln(b, "\tdefer scratch_free(&scratch)")
	}
	for s in pre do fmt.sbprintfln(b, "\t%s", s)
	if opener {
		for s in post do fmt.sbprintfln(b, "\t%s", s)
		clear(&post)
	}
	switch {
	case single:
		fmt.sbprintfln(b, "\treturn %s", strings.trim_prefix(result_set, "result = "))
	case out_array:
		fmt.sbprintfln(b, "\t%s", array_code)
	case result_set != "":
		fmt.sbprintfln(b, "\t%s", result_set)
	case:
		fmt.sbprintfln(b, "\t%s", call)
	}
	for r in rets do if r.set != "" do fmt.sbprintfln(b, "\t%s", r.set)
	for s in post do fmt.sbprintfln(b, "\t%s", s)
	if len(rets) > 0 && !single do fmt.sbprintln(b, "\treturn")
	fmt.sbprintln(b, "}\n")
	if opener {
		fmt.sbprintf(b, "@(private)\nclose_%s :: proc(", raw_name(f.name))
		for p, k in params {
			if k > 0 do fmt.sbprint(b, ", ")
			name := p.decl[:strings.index_byte(p.decl, ':')]
			decl := p.decl if name == "ui" else fmt.tprintf("_%s", p.decl[len(name):])
			fmt.sbprint(b, decl)
			if p.default_ != "" do fmt.sbprintf(b, " = %s", p.default_)
		}
		fmt.sbprintln(b, ") {\n\tclose(ui)\n}\n")
	}
}

fn_typedef :: proc(g: ^Gen, t: string) -> string {
	for ft in g.m.fn_types do if ft.name == t do return ft.name
	return ""
}

Scalar_Conv :: enum {
	None,
	Flag, // one bit of a family, as its enum
	Enum, // u32 <-> an enum
	Bits, // u32 <-> a bit set
	Handle, // u64 <-> a distinct handle
	Int, // size_t <-> int
}

// The Odin type of a scalar parameter or return, and how it crosses.
scalar_type :: proc(g: ^Gen, f: ^Function, param, c_type: string) -> (string, Scalar_Conv) {
	key := fmt.tprintf("%s.%s", f.name, param)
	t := typed(g, key)
	if t == "" && param != "return" do t = typed(g, fmt.tprintf("*.%s", param))
	if t == "" && c_type == "uint64_t" && (param == "id" || param == "return") {
		t = handle_of_family(f.name)
	}
	switch {
	case t == "":
		if c_type == "size_t" do return "int", .Int
		p, _ := primitive(c_type)
		return p, .None
	case t == "Color":
		return t, .None
	case slice.contains(HANDLES, t):
		return t, .Handle
	case slice.contains(TRANSMUTED, t):
		return t, .Bits
	}
	for e in g.enums do if e.bits && e.rule.flag == t do return t, .Flag
	e := enum_def(g, t)
	if e == nil do fail("%s: TYPED names %s, which is not an enum, a handle or Color", key, t)
	return t, .Bits if e.bits else .Enum
}

to_scalar :: proc(conv: Scalar_Conv, c_odin, v: string) -> string {
	switch conv {
	case .None:
		return v
	case .Flag:
		return fmt.tprintf("%s(1) << u32(%s)", c_odin, v)
	case .Enum, .Handle:
		return fmt.tprintf("%s(%s)", c_odin, v)
	case .Bits:
		return fmt.tprintf("transmute(%s)%s", c_odin, v)
	case .Int:
		return fmt.tprintf("uint(%s)", v)
	}
	return v
}

from_scalar :: proc(conv: Scalar_Conv, odin_t, v: string) -> string {
	switch conv {
	case .None, .Flag:
		return v
	case .Enum, .Handle:
		return fmt.tprintf("%s(%s)", odin_t, v)
	case .Bits:
		return fmt.tprintf("transmute(%s)%s", odin_t, v)
	case .Int:
		return fmt.tprintf("int(%s)", v)
	}
	return v
}

// -- What the hand-written half owes the schema -------------------------------

// "dir: Dir" and "border_w: f32,\n\tborder_color: Color" -> the names.
note_fields :: proc(decl: string, into: ^map[string]bool) {
	for line in strings.split(decl, ",") {
		colon := strings.index_byte(line, ':')
		if colon > 0 do into[strings.trim_space(line[:colon])] = true
	}
}

// Every Odin spelling docs/props.md prints - the prop rows, the composites,
// the elements, the resources and the env setters - names what package kui
// has: a `kui.x` is a procedure of it, a `Spec.x` / `Text_Style.x` a field.
check_odin_spellings :: proc(g: ^Gen, doors: []^Function) {
	procs := make(map[string]bool)
	for f in doors do procs[raw_name(f.name)] = true
	for name, _ in g.hand_procs do procs[name] = true
	check :: proc(g: ^Gen, procs: map[string]bool, table, row, text: string) {
		for i := 0; i < len(text); i += 1 {
			prefix, fields := "", map[string]bool{}
			switch {
			case strings.has_prefix(text[i:], "kui."):
				prefix = "kui."
			case strings.has_prefix(text[i:], "Spec."):
				prefix, fields = "Spec.", g.spec_fields
			case strings.has_prefix(text[i:], "Text_Style."):
				prefix, fields = "Text_Style.", g.style_fields
			case:
				continue
			}
			if i > 0 && is_ident_byte(text[i - 1]) do continue
			j := i + len(prefix)
			for j < len(text) && is_ident_byte(text[j]) do j += 1
			name := text[i + len(prefix):j]
			known := procs[name] if prefix == "kui." else fields[name]
			if !known do fail("props.md's %s %s: its Odin spelling names %s%s, which package kui does not have (%q)", table, row, prefix, name, text)
			i = j
		}
	}
	for p in g.s.props do check(g, procs, "prop", p.name, p.odin)
	for c in g.s.custom do check(g, procs, "composite", c.name, c.odin)
	for e in g.s.elements do check(g, procs, "element", e.name, e.odin)
	for r in g.s.resources do check(g, procs, "resource", r.name, r.odin)
	for e in g.s.env do check(g, procs, "env field", e.name, e.odin)
	for e in g.s.elements do if e.odin == "" do fail("element %s has no Odin spelling", e.name)
}

// The verb table's Odin column (schema::DOORS) and the binding agree both
// ways: every procedure the column names is one package kui has, and a verb
// whose C function has a generated door is that door in the column - so a
// door renamed, dropped or added shows up as a row to change.
check_doors_column :: proc(g: ^Gen, doors: []^Function) {
	generated := make(map[string]bool)
	for f in doors do generated[raw_name(f.name)] = true
	for d in g.s.doors {
		if d.odin_cell == "is" && !generated[d.odin_text] && !g.hand_procs[d.odin_text] {
			fail("DOORS %s: the Odin column names %s, which package kui does not have", d.rust, d.odin_text)
		}
		if d.c_cell != "is" do continue
		door := raw_name(d.c_text)
		if generated[door] && (d.odin_cell != "is" || d.odin_text != door) {
			fail("DOORS %s: %s is package kui's generated door %s, but the Odin column says %s(%q)", d.rust, d.c_text, door, d.odin_cell, d.odin_text)
		}
	}
}

// Every event the core emits has a struct to decode it into, named for its
// kind (with _Event), holding every field the schema says it carries.
check_events :: proc(g: ^Gen) {
	for ev in g.s.events {
		if ev.kind == "click" do continue // the app's own payload
		name := ""
		for sname, _ in g.hand_structs {
			if strings.has_suffix(sname, "_Event") && norm(strings.trim_suffix(sname, "_Event")) == norm(ev.kind) do name = sname
		}
		if name == "" do fail("event %q has no %s_Event struct in the hand-written files", ev.kind, ada(ev.kind))
		fields := g.hand_structs[name]
		for want in payload_fields(ev.payload) {
			found := false
			for have in fields do if norm(have) == norm(want) do found = true
			if !found do fail("%s has no field for the schema's %q (payload %s)", name, want, ev.payload)
		}
	}
}

// The keys of a payload as the schema writes it: `{ kind: "drag", phase:
// "start" | "move", x, y, parent: { x, y }, tag }` is phase, x, y, parent,
// tag. Only the first {...} is read; a second shape after a `;` is the
// same event elsewhere and is read the same way.
payload_fields :: proc(payload: string) -> (out: [dynamic]string) {
	for part in strings.split(payload, ";") {
		open := strings.index_byte(part, '{')
		if open < 0 do continue
		depth := 0
		start := open + 1
		for i := open; i < len(part); i += 1 {
			ch := part[i]
			switch ch {
			case '{', '[':
				depth += 1
			case '}', ']':
				depth -= 1
				if depth == 0 {
					add_key(&out, part[start:i])
					i = len(part)
				}
			case ',':
				if depth == 1 {
					add_key(&out, part[start:i])
					start = i + 1
				}
			}
		}
	}
	return
}

add_key :: proc(out: ^[dynamic]string, item: string) {
	t := strings.trim_space(item)
	if colon := strings.index_byte(t, ':'); colon >= 0 do t = t[:colon]
	t = strings.trim_space(strings.trim_suffix(strings.trim_space(t), "?"))
	if t == "" || t == "kind" || !is_ident_byte(t[0]) do return
	for x in out do if x == t do return
	append(out, t)
}

// Every C function an element row names is reachable.
check_elements :: proc(g: ^Gen) {
	for el in g.s.elements {
		for word in strings.split(el.c, "`") {
			if !strings.has_prefix(word, "kui_") do continue
			if strings.contains(word, "*") do continue // kui_open*
			if function(g.m, word) == nil do fail("element %s names %s, which kui.h does not declare", el.name, word)
		}
	}
}

check_stale :: proc(g: ^Gen) {
	stale: [dynamic]string
	for t in TYPED do if !g.used[fmt.tprintf("typed.%s", t[0])] do append(&stale, fmt.tprintf("TYPED %s", t[0]))
	for t in PROP_TYPES do if !g.used[fmt.tprintf("prop_type.%s", t[0])] do append(&stale, fmt.tprintf("PROP_TYPES %s", t[0]))
	for t in LOWERING do if !g.used[fmt.tprintf("lowering.%s", t[0])] do append(&stale, fmt.tprintf("LOWERING %s", t[0]))
	for t in MAYBE_ROWS do if !g.used[fmt.tprintf("maybe.%s", t)] do append(&stale, fmt.tprintf("MAYBE_ROWS %s", t))
	for t in INT_ROWS do if !g.used[fmt.tprintf("int.%s", t)] do append(&stale, fmt.tprintf("INT_ROWS %s", t))
	for t in SKIP do if !g.used[fmt.tprintf("skip.%s", t[0])] do append(&stale, fmt.tprintf("SKIP %s", t[0]))
	for t in DEFAULTS do if !g.used[fmt.tprintf("default.%s", t[0])] do append(&stale, fmt.tprintf("DEFAULTS %s", t[0]))
	for t in STRUCT_NAMES do if !g.used[fmt.tprintf("struct_name.%s", t[0])] do append(&stale, fmt.tprintf("STRUCT_NAMES %s", t[0]))
	for t in BOOL_FIELDS do if !g.used[fmt.tprintf("bool.%s", t)] do append(&stale, fmt.tprintf("BOOL_FIELDS %s", t))
	for t in NULLABLE do if !g.used[fmt.tprintf("nullable.%s", t)] do append(&stale, fmt.tprintf("NULLABLE %s", t))
	for t in FIELD_DEFAULTS do if !g.used[fmt.tprintf("field_default.%s", t[0])] do append(&stale, fmt.tprintf("FIELD_DEFAULTS %s", t[0]))
	for t in SLICE_COUNTS do if !g.used[fmt.tprintf("slice_count.%s", t[0])] do append(&stale, fmt.tprintf("SLICE_COUNTS %s", t[0]))
	for t in POINTS do if !g.used[fmt.tprintf("points.%s", t)] do append(&stale, fmt.tprintf("POINTS %s", t))
	for t in FIXED_FLOATS do if !g.used[fmt.tprintf("fixed_floats.%s", t[0])] do append(&stale, fmt.tprintf("FIXED_FLOATS %s", t[0]))
	for t in BYTE_LENGTHS do if !g.used[fmt.tprintf("byte_lengths.%s", t[0])] do append(&stale, fmt.tprintf("BYTE_LENGTHS %s", t[0]))
	for t in OPENERS do if !g.used[fmt.tprintf("opener.%s", t)] do append(&stale, fmt.tprintf("OPENERS %s", t))
	for t in INVERTED do if !g.used[fmt.tprintf("inverted.%s", t[0])] do append(&stale, fmt.tprintf("INVERTED %s", t[0]))
	if len(stale) > 0 do fail("policy rows that matched nothing (stale, or a typo): %v", stale)
}

// -- Spelling -----------------------------------------------------------------

// SPACE_BETWEEN, spaceBetween, break-spaces -> Space_Between, ...; and a C
// struct's AccessNode -> Access_Node.
ada :: proc(s: string) -> string {
	b := strings.builder_make()
	up := true
	for i in 0 ..< len(s) {
		ch := s[i]
		if ch == '_' || ch == '-' {
			strings.write_byte(&b, '_')
			up = true
			continue
		}
		is_upper := 'A' <= ch && ch <= 'Z'
		if is_upper && i > 0 && !up {
			prev := s[i - 1]
			if 'a' <= prev && prev <= 'z' || '0' <= prev && prev <= '9' {
				strings.write_byte(&b, '_')
				up = true
			}
		}
		if up {
			strings.write_byte(&b, ch - 32 if 'a' <= ch && ch <= 'z' else ch)
			up = false
		} else {
			strings.write_byte(&b, ch + 32 if is_upper else ch)
		}
	}
	return strings.to_string(b)
}

snake_of :: proc(ada_name: string) -> string {
	return strings.to_lower(ada_name)
}

// What two spellings of one name have in common: letters and digits,
// lower-cased.
norm :: proc(s: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	for i in 0 ..< len(s) {
		ch := s[i]
		switch {
		case 'A' <= ch && ch <= 'Z':
			strings.write_byte(&b, ch + 32)
		case 'a' <= ch && ch <= 'z', '0' <= ch && ch <= '9':
			strings.write_byte(&b, ch)
		}
	}
	return strings.to_string(b)
}

has_word_prefix :: proc(s, word: string) -> bool {
	return s == word || strings.has_prefix(s, fmt.tprintf("%s_", word))
}

c_qualified :: proc(t: string) -> string {
	for i in 0 ..< len(t) {
		if 'A' <= t[i] && t[i] <= 'Z' do return fmt.tprintf("%sc.%s", t[:i], t[i:])
	}
	return t
}

parse_i64 :: proc(s: string) -> i64 {
	neg := strings.has_prefix(s, "-")
	n: i64
	for ch in (s[1:] if neg else s) {
		if ch < '0' || ch > '9' do break
		n = n * 10 + i64(ch - '0')
	}
	return -n if neg else n
}

log2 :: proc(v: i64) -> (n: i64) {
	for x := v; x > 1; x >>= 1 do n += 1
	return
}

// The first sentence of a schema doc, as comment lines.
emit_doc :: proc(b: ^strings.Builder, doc, indent: string) {
	text := doc
	if end := strings.index(text, ". "); end >= 0 do text = text[:end + 1]
	line := strings.builder_make(context.temp_allocator)
	for word in strings.fields(text, context.temp_allocator) {
		if strings.builder_len(line) + len(word) > 74 {
			fmt.sbprintfln(b, "%s// %s", indent, strings.to_string(line))
			strings.builder_reset(&line)
		}
		if strings.builder_len(line) > 0 do strings.write_byte(&line, ' ')
		strings.write_string(&line, word)
	}
	if strings.builder_len(line) > 0 do fmt.sbprintfln(b, "%s// %s", indent, strings.to_string(line))
}
