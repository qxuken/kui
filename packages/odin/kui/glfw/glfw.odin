// GLFW's keys as kui's (backlog F239). Generated by `cargo run -p kui-devtools --bin keytables` from the table in
// examples/devtools/src/bin/keytables.rs; edit the table, not this file.
//
// A package of its own, so importing kui links no GLFW:
//
//     import kui_glfw "kui/glfw"
//     glfw.SetInputMode(window, glfw.LOCK_KEY_MODS, 1)
//     glfw.SetKeyCallback(window, proc "c" (w: glfw.WindowHandle, key, scancode, action, mods: c.int) {
//         context = runtime.default_context()
//         kui_glfw.on_key(ui, key, scancode, action, mods)
//     })
//     glfw.SetCharCallback(window, proc "c" (w: glfw.WindowHandle, r: rune) {
//         context = runtime.default_context()
//         kui_glfw.on_char(ui, r)
//     })
//
// GLFW names a key by its place on a US keyboard (glfw.KEY_*), which is
// kui's `physical`; `code` is what the layout makes of it
// (glfw.GetKeyName), a letter upper-cased under Shift or Caps Lock - which
// GLFW reports only with LOCK_KEY_MODS on. A named key (the arrows, Enter,
// Tab, Escape, F5) goes through kui.input_press, so it means what it
// means; a key that types (a character, Space) goes through
// kui.input_key_down, the raw half a key sink and an editor's chords read,
// and what it types arrives once, from the char callback, as
// kui.input_text. kui.input_modifiers follows every key.
package kui_glfw

import "core:c"
import "core:unicode/utf8"
import "vendor:glfw"
import kui ".."

// kui's name for the key at GLFW `key`'s place and where it sits; "" for
// a key kui names none for (glfw.KEY_WORLD_1, _2).
physical :: proc(key: c.int) -> (name: string, location: kui.Key_Location) {
	switch key {
	case glfw.KEY_A: return "a", .Standard
	case glfw.KEY_B: return "b", .Standard
	case glfw.KEY_C: return "c", .Standard
	case glfw.KEY_D: return "d", .Standard
	case glfw.KEY_E: return "e", .Standard
	case glfw.KEY_F: return "f", .Standard
	case glfw.KEY_G: return "g", .Standard
	case glfw.KEY_H: return "h", .Standard
	case glfw.KEY_I: return "i", .Standard
	case glfw.KEY_J: return "j", .Standard
	case glfw.KEY_K: return "k", .Standard
	case glfw.KEY_L: return "l", .Standard
	case glfw.KEY_M: return "m", .Standard
	case glfw.KEY_N: return "n", .Standard
	case glfw.KEY_O: return "o", .Standard
	case glfw.KEY_P: return "p", .Standard
	case glfw.KEY_Q: return "q", .Standard
	case glfw.KEY_R: return "r", .Standard
	case glfw.KEY_S: return "s", .Standard
	case glfw.KEY_T: return "t", .Standard
	case glfw.KEY_U: return "u", .Standard
	case glfw.KEY_V: return "v", .Standard
	case glfw.KEY_W: return "w", .Standard
	case glfw.KEY_X: return "x", .Standard
	case glfw.KEY_Y: return "y", .Standard
	case glfw.KEY_Z: return "z", .Standard
	case glfw.KEY_0: return "0", .Standard
	case glfw.KEY_1: return "1", .Standard
	case glfw.KEY_2: return "2", .Standard
	case glfw.KEY_3: return "3", .Standard
	case glfw.KEY_4: return "4", .Standard
	case glfw.KEY_5: return "5", .Standard
	case glfw.KEY_6: return "6", .Standard
	case glfw.KEY_7: return "7", .Standard
	case glfw.KEY_8: return "8", .Standard
	case glfw.KEY_9: return "9", .Standard
	case glfw.KEY_SPACE: return "space", .Standard
	case glfw.KEY_APOSTROPHE: return "'", .Standard
	case glfw.KEY_COMMA: return ",", .Standard
	case glfw.KEY_MINUS: return "-", .Standard
	case glfw.KEY_PERIOD: return ".", .Standard
	case glfw.KEY_SLASH: return "/", .Standard
	case glfw.KEY_SEMICOLON: return ";", .Standard
	case glfw.KEY_EQUAL: return "=", .Standard
	case glfw.KEY_LEFT_BRACKET: return "[", .Standard
	case glfw.KEY_BACKSLASH: return "\\", .Standard
	case glfw.KEY_RIGHT_BRACKET: return "]", .Standard
	case glfw.KEY_GRAVE_ACCENT: return "`", .Standard
	case glfw.KEY_ESCAPE: return "escape", .Standard
	case glfw.KEY_ENTER: return "enter", .Standard
	case glfw.KEY_TAB: return "tab", .Standard
	case glfw.KEY_BACKSPACE: return "backspace", .Standard
	case glfw.KEY_INSERT: return "insert", .Standard
	case glfw.KEY_DELETE: return "delete", .Standard
	case glfw.KEY_RIGHT: return "right", .Standard
	case glfw.KEY_LEFT: return "left", .Standard
	case glfw.KEY_DOWN: return "down", .Standard
	case glfw.KEY_UP: return "up", .Standard
	case glfw.KEY_PAGE_UP: return "pageup", .Standard
	case glfw.KEY_PAGE_DOWN: return "pagedown", .Standard
	case glfw.KEY_HOME: return "home", .Standard
	case glfw.KEY_END: return "end", .Standard
	case glfw.KEY_CAPS_LOCK: return "capslock", .Standard
	case glfw.KEY_SCROLL_LOCK: return "scrolllock", .Standard
	case glfw.KEY_NUM_LOCK: return "numlock", .Standard
	case glfw.KEY_PRINT_SCREEN: return "printscreen", .Standard
	case glfw.KEY_PAUSE: return "pause", .Standard
	case glfw.KEY_MENU: return "menu", .Standard
	case glfw.KEY_F1: return "f1", .Standard
	case glfw.KEY_F2: return "f2", .Standard
	case glfw.KEY_F3: return "f3", .Standard
	case glfw.KEY_F4: return "f4", .Standard
	case glfw.KEY_F5: return "f5", .Standard
	case glfw.KEY_F6: return "f6", .Standard
	case glfw.KEY_F7: return "f7", .Standard
	case glfw.KEY_F8: return "f8", .Standard
	case glfw.KEY_F9: return "f9", .Standard
	case glfw.KEY_F10: return "f10", .Standard
	case glfw.KEY_F11: return "f11", .Standard
	case glfw.KEY_F12: return "f12", .Standard
	case glfw.KEY_F13: return "f13", .Standard
	case glfw.KEY_F14: return "f14", .Standard
	case glfw.KEY_F15: return "f15", .Standard
	case glfw.KEY_F16: return "f16", .Standard
	case glfw.KEY_F17: return "f17", .Standard
	case glfw.KEY_F18: return "f18", .Standard
	case glfw.KEY_F19: return "f19", .Standard
	case glfw.KEY_F20: return "f20", .Standard
	case glfw.KEY_F21: return "f21", .Standard
	case glfw.KEY_F22: return "f22", .Standard
	case glfw.KEY_F23: return "f23", .Standard
	case glfw.KEY_F24: return "f24", .Standard
	case glfw.KEY_F25: return "f25", .Standard
	case glfw.KEY_KP_0: return "0", .Numpad
	case glfw.KEY_KP_1: return "1", .Numpad
	case glfw.KEY_KP_2: return "2", .Numpad
	case glfw.KEY_KP_3: return "3", .Numpad
	case glfw.KEY_KP_4: return "4", .Numpad
	case glfw.KEY_KP_5: return "5", .Numpad
	case glfw.KEY_KP_6: return "6", .Numpad
	case glfw.KEY_KP_7: return "7", .Numpad
	case glfw.KEY_KP_8: return "8", .Numpad
	case glfw.KEY_KP_9: return "9", .Numpad
	case glfw.KEY_KP_DECIMAL: return ".", .Numpad
	case glfw.KEY_KP_DIVIDE: return "/", .Numpad
	case glfw.KEY_KP_MULTIPLY: return "*", .Numpad
	case glfw.KEY_KP_SUBTRACT: return "-", .Numpad
	case glfw.KEY_KP_ADD: return "+", .Numpad
	case glfw.KEY_KP_ENTER: return "enter", .Numpad
	case glfw.KEY_KP_EQUAL: return "=", .Numpad
	case glfw.KEY_LEFT_SHIFT: return "shift", .Left
	case glfw.KEY_RIGHT_SHIFT: return "shift", .Right
	case glfw.KEY_LEFT_CONTROL: return "ctrl", .Left
	case glfw.KEY_RIGHT_CONTROL: return "ctrl", .Right
	case glfw.KEY_LEFT_ALT: return "alt", .Left
	case glfw.KEY_RIGHT_ALT: return "alt", .Right
	case glfw.KEY_LEFT_SUPER: return "super", .Left
	case glfw.KEY_RIGHT_SUPER: return "super", .Right
	}
	return "", .Standard
}

// GLFW's `mods` as kui's.
key_mods :: proc(mods: c.int) -> kui.Key_Mods {
	return kui.Key_Mods {
		shift = mods & glfw.MOD_SHIFT != 0,
		ctrl = mods & glfw.MOD_CONTROL != 0,
		alt = mods & glfw.MOD_ALT != 0,
		super = mods & glfw.MOD_SUPER != 0,
		caps_lock = mods & glfw.MOD_CAPS_LOCK != 0,
		num_lock = mods & glfw.MOD_NUM_LOCK != 0,
	}
}

// A GLFW key callback's arguments, into kui.
on_key :: proc(ui: ^kui.Ui, key, scancode, action, mods: c.int) {
	phys, location := physical(key)
	if phys == "" do return
	km := key_mods(mods)
	held: kui.Mods
	if km.shift do held += {.Shift}
	if km.ctrl do held += {.Ctrl}
	if km.alt do held += {.Alt}
	if km.super do held += {.Super}
	kui.input_modifiers(ui, held)
	km.location = location
	types := len(phys) == 1 || phys == "space"
	code := phys
	layout := glfw.GetKeyName(key, scancode)
	if layout != "" && utf8.rune_count_in_string(layout) == 1 {
		code = layout
		types = true
	}
	buf: [1]u8
	if km.shift != km.caps_lock && len(code) == 1 && code[0] >= 'a' && code[0] <= 'z' {
		buf[0] = code[0] - 32
		code = string(buf[:])
	}
	switch {
	case action == glfw.RELEASE:
		kui.input_release(ui, code, phys, km)
	case types:
		kui.input_key_down(ui, code, phys, km, "", action == glfw.REPEAT)
	case:
		kui.input_press(ui, code, phys, km, "", action == glfw.REPEAT)
	}
}

// A GLFW char callback's rune, into kui as typed text.
on_char :: proc(ui: ^kui.Ui, r: rune) {
	bytes, n := utf8.encode_rune(r)
	kui.input_text(ui, string(bytes[:n]))
}
