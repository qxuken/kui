// kui.h's KuiMenuItem.
Menu_Item :: struct {
	label: string,
	role: Menu_Role,
	disabled: bool,
	id: any,
	accel: string,
	checked: bool,
	replay: bool,
	submenu: []Menu_Item,
}

menu_item_to_c :: proc(v: Menu_Item, scratch: ^Scratch) -> (out: c.MenuItem) {
	out.label = v.label
	out.role = u32(v.role)
	out.enabled = 0 if v.disabled else 1
	out.id = borrow(scratch, v.id)
	out.accel = v.accel
	out.checked = 1 if v.checked else 0
	out.replay = 1 if v.replay else 0
	{ tmp := make([]c.MenuItem, len(v.submenu), context.temp_allocator); for x, k in v.submenu do tmp[k] = menu_item_to_c(x, scratch); out.submenu, out.submenu_count = raw_data(tmp), uint(len(tmp)) }
	return
}

menu_item_from_c :: proc(v: c.MenuItem) -> (out: Menu_Item) {
	out.label = v.label
	out.role = Menu_Role(v.role)
	out.disabled = v.enabled == 0
	out.accel = v.accel
	out.checked = v.checked != 0
	out.replay = v.replay != 0
	{ tmp := make([]Menu_Item, v.submenu_count, context.temp_allocator); for &x, k in tmp do x = menu_item_from_c(v.submenu[k]); out.submenu = tmp }
	return
}

// kui.h's KuiMenu.
Bar_Menu :: struct {
	label: string,
	items: []Menu_Item,
	disabled: bool,
}

bar_menu_to_c :: proc(v: Bar_Menu, scratch: ^Scratch) -> (out: c.Menu) {
	out.label = v.label
	{ tmp := make([]c.MenuItem, len(v.items), context.temp_allocator); for x, k in v.items do tmp[k] = menu_item_to_c(x, scratch); out.items, out.count = raw_data(tmp), uint(len(tmp)) }
	out.enabled = 0 if v.disabled else 1
	return
}

bar_menu_from_c :: proc(v: c.Menu) -> (out: Bar_Menu) {
	out.label = v.label
	{ tmp := make([]Menu_Item, v.count, context.temp_allocator); for &x, k in tmp do x = menu_item_from_c(v.items[k]); out.items = tmp }
	out.disabled = v.enabled == 0
	return
}

