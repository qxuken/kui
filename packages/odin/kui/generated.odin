// kui.h's KuiAccessRun.
Access_Run :: struct {
	key: u64,
	line: u32,
	start: u32,
	end: u32,
	text: string,
	x: f32,
	y: f32,
	w: f32,
	h: f32,
	char_count: u32,
	char_lengths: []u8,
	char_positions: []f32,
	char_widths: []f32,
	word_start_count: u32,
	word_starts: []u8,
	rtl: bool,
}

access_run_to_c :: proc(v: Access_Run, scratch: ^Scratch) -> (out: c.AccessRun) {
	out.key = v.key
	out.line = v.line
	out.start = v.start
	out.end = v.end
	out.text = v.text
	out.x = v.x
	out.y = v.y
	out.w = v.w
	out.h = v.h
	out.char_count = v.char_count
	out.char_lengths = ([^]u8)(raw_data(v.char_lengths))
	out.char_positions = ([^]f32)(raw_data(v.char_positions))
	out.char_widths = ([^]f32)(raw_data(v.char_widths))
	out.word_start_count = v.word_start_count
	out.word_starts = ([^]u8)(raw_data(v.word_starts))
	out.rtl = 1 if v.rtl else 0
	_ = scratch
	return
}

access_run_from_c :: proc(v: c.AccessRun) -> (out: Access_Run) {
	out.key = v.key
	out.line = v.line
	out.start = v.start
	out.end = v.end
	out.text = v.text
	out.x = v.x
	out.y = v.y
	out.w = v.w
	out.h = v.h
	out.char_count = v.char_count
	out.char_lengths = ([^]u8)(v.char_lengths)[:v.char_count]
	out.char_positions = ([^]f32)(v.char_positions)[:v.char_count]
	out.char_widths = ([^]f32)(v.char_widths)[:v.char_count]
	out.word_start_count = v.word_start_count
	out.word_starts = ([^]u8)(v.word_starts)[:v.word_start_count]
	out.rtl = v.rtl != 0
	return
}

// kui.h's KuiDrawData.
Draw_Data :: struct {
	quads: []Quad,
	viewport_w: f32,
	viewport_h: f32,
	scale: f32,
	atlas_pixels: [^]u8,
	atlas_size: u32,
	atlas_dirty: bool,
	atlas_epoch: u64,
	fragments: []Fragment_Draw,
	time: f32,
	clips: []Clip,
	textures: []Texture_Draw,
}

draw_data_to_c :: proc(v: Draw_Data, scratch: ^Scratch) -> (out: c.DrawData) {
	out.size = size_of(c.DrawData)
	out.quads, out.quad_count = ([^]c.Quad)(raw_data(v.quads)), uint(len(v.quads))
	out.viewport_w = v.viewport_w
	out.viewport_h = v.viewport_h
	out.scale = v.scale
	out.atlas_pixels = v.atlas_pixels
	out.atlas_size = v.atlas_size
	out.atlas_dirty = v.atlas_dirty
	out.atlas_epoch = v.atlas_epoch
	{ tmp := make([]c.FragmentDraw, len(v.fragments), context.temp_allocator); for x, k in v.fragments do tmp[k] = fragment_draw_to_c(x, scratch); out.fragments, out.fragment_count = raw_data(tmp), uint(len(tmp)) }
	out.time = v.time
	out.clips, out.clip_count = ([^]c.Clip)(raw_data(v.clips)), uint(len(v.clips))
	{ tmp := make([]c.TextureDraw, len(v.textures), context.temp_allocator); for x, k in v.textures do tmp[k] = texture_draw_to_c(x, scratch); out.textures, out.texture_count = raw_data(tmp), uint(len(tmp)) }
	return
}

draw_data_from_c :: proc(v: c.DrawData) -> (out: Draw_Data) {
	out.quads = ([^]Quad)(v.quads)[:v.quad_count]
	out.viewport_w = v.viewport_w
	out.viewport_h = v.viewport_h
	out.scale = v.scale
	out.atlas_pixels = v.atlas_pixels
	out.atlas_size = v.atlas_size
	out.atlas_dirty = v.atlas_dirty
	out.atlas_epoch = v.atlas_epoch
	{ tmp := make([]Fragment_Draw, v.fragment_count, context.temp_allocator); for &x, k in tmp do x = fragment_draw_from_c(v.fragments[k]); out.fragments = tmp }
	out.time = v.time
	out.clips = ([^]Clip)(v.clips)[:v.clip_count]
	{ tmp := make([]Texture_Draw, v.texture_count, context.temp_allocator); for &x, k in tmp do x = texture_draw_from_c(v.textures[k]); out.textures = tmp }
	return
}

// kui.h's KuiFragmentDraw.
Fragment_Draw :: struct {
	fragment: Fragment,
	params: [16]f32,
	image_source: Fragment_Image,
	image_texture: u32,
	image_uv: [4]u32,
}

fragment_draw_to_c :: proc(v: Fragment_Draw, scratch: ^Scratch) -> (out: c.FragmentDraw) {
	out.fragment = u64(v.fragment)
	out.params = v.params
	out.image_source = u32(v.image_source)
	out.image_texture = v.image_texture
	out.image_uv = v.image_uv
	_ = scratch
	return
}

fragment_draw_from_c :: proc(v: c.FragmentDraw) -> (out: Fragment_Draw) {
	out.fragment = Fragment(v.fragment)
	out.params = v.params
	out.image_source = Fragment_Image(v.image_source)
	out.image_texture = v.image_texture
	out.image_uv = v.image_uv
	return
}

Clip :: c.Clip

// kui.h's KuiTextureDraw.
Texture_Draw :: struct {
	image: Image,
	rev: u32,
	width: u32,
	height: u32,
	uv: [4]u32,
}

texture_draw_to_c :: proc(v: Texture_Draw, scratch: ^Scratch) -> (out: c.TextureDraw) {
	out.image = u64(v.image)
	out.rev = v.rev
	out.width = v.width
	out.height = v.height
	out.uv = v.uv
	_ = scratch
	return
}

texture_draw_from_c :: proc(v: c.TextureDraw) -> (out: Texture_Draw) {
	out.image = Image(v.image)
	out.rev = v.rev
	out.width = v.width
	out.height = v.height
	out.uv = v.uv
	return
}

