// kui_fragment_open (kui.h).
// Opens a node: `if` it, and the block's end closes it.
@(deferred_in = close_fragment_open)
fragment_open :: proc(ui: ^Ui, label: string, id: Fragment, params: []f32, spec: Spec = {}) -> (result: bool) {
	scratch: Scratch
	defer scratch_free(&scratch)
	spec_c: c.Spec
	spec_to_c(spec, &spec_c, &scratch)
	c.fragment_open(ui, label, u64(id), ([^]f32)(raw_data(params)), uint(len(params)), &spec_c)
	result = true
	return
}

@(private)
close_fragment_open :: proc(ui: ^Ui, _: string, _: Fragment, _: []f32, _: Spec = {}) {
	close(ui)
}

