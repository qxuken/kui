// Shapes text in a style at a width and answers its size and line count.
// Rust: Ui::measure_text.
measure_text :: proc(ui: ^Ui, text: string, style: Text_Style, max_w: f32) -> (out: Text_Metrics, ok: bool) #optional_ok {
	style_c := text_style_to_c(style)
	c_out := c.TextMetrics{size = size_of(c.TextMetrics)}
