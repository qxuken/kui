	out.accent_soft = v.accent_soft
	out.selection = v.selection
	out.focus_ring = v.focus_ring
	out.hover = v.hover
	out.pressed = v.pressed
	out.success = v.success
	out.warning = v.warning
	out.danger = v.danger
	out.scrollbar = v.scrollbar
	out.scrollbar_active = v.scrollbar_active
	_ = scratch
