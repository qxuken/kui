Warning :: c.Warning

// kui.h's KuiAccessNode.
Access_Node :: struct {
	key: u64,
	parent: u64,
	origin: u32,
	role: Role,
	flags: Access_Flags,
	actions: Access_Actions,
	name: string,
	description: string,
	value: string,
	x: f32,
	y: f32,
	w: f32,
	h: f32,
	caret: u32,
	selection_start: u32,
	selection_end: u32,
	value_now: f32,
	value_min: f32,
	value_max: f32,
	scroll_x: f32,
	scroll_y: f32,
	scroll_max_x: f32,
	scroll_max_y: f32,
	anchor_run: u64,
	anchor_char: u32,
	focus_run: u64,
	focus_char: u32,
	run_count: u32,
	pos_in_set: u32,
	set_size: u32,
	orientation: Orientation,
}

access_node_to_c :: proc(v: Access_Node, scratch: ^Scratch) -> (out: c.AccessNode) {
	out.key = v.key
	out.parent = v.parent
	out.origin = v.origin
	out.role = u32(v.role)
	out.flags = transmute(u32)v.flags
	out.actions = transmute(u32)v.actions
	out.name = v.name
	out.description = v.description
	out.value = v.value
	out.x = v.x
	out.y = v.y
	out.w = v.w
	out.h = v.h
	out.caret = v.caret
	out.selection_start = v.selection_start
	out.selection_end = v.selection_end
	out.value_now = v.value_now
	out.value_min = v.value_min
	out.value_max = v.value_max
	out.scroll_x = v.scroll_x
	out.scroll_y = v.scroll_y
	out.scroll_max_x = v.scroll_max_x
	out.scroll_max_y = v.scroll_max_y
	out.anchor_run = v.anchor_run
	out.anchor_char = v.anchor_char
	out.focus_run = v.focus_run
	out.focus_char = v.focus_char
	out.run_count = v.run_count
	out.pos_in_set = v.pos_in_set
	out.set_size = v.set_size
	out.orientation = u32(v.orientation)
	_ = scratch
	return
}

access_node_from_c :: proc(v: c.AccessNode) -> (out: Access_Node) {
	out.key = v.key
	out.parent = v.parent
	out.origin = v.origin
	out.role = Role(v.role)
	out.flags = transmute(Access_Flags)v.flags
	out.actions = transmute(Access_Actions)v.actions
	out.name = v.name
	out.description = v.description
	out.value = v.value
	out.x = v.x
	out.y = v.y
	out.w = v.w
	out.h = v.h
	out.caret = v.caret
	out.selection_start = v.selection_start
	out.selection_end = v.selection_end
	out.value_now = v.value_now
	out.value_min = v.value_min
	out.value_max = v.value_max
	out.scroll_x = v.scroll_x
	out.scroll_y = v.scroll_y
	out.scroll_max_x = v.scroll_max_x
	out.scroll_max_y = v.scroll_max_y
	out.anchor_run = v.anchor_run
	out.anchor_char = v.anchor_char
	out.focus_run = v.focus_run
	out.focus_char = v.focus_char
	out.run_count = v.run_count
	out.pos_in_set = v.pos_in_set
	out.set_size = v.set_size
	out.orientation = Orientation(v.orientation)
	return
}

// kui.h's KuiAnnouncement.
Announcement :: struct {
	text: string,
	live: Live,
}

announcement_to_c :: proc(v: Announcement, scratch: ^Scratch) -> (out: c.Announcement) {
	out.text = v.text
	out.live = u32(v.live)
	_ = scratch
	return
}

announcement_from_c :: proc(v: c.Announcement) -> (out: Announcement) {
	out.text = v.text
	out.live = Live(v.live)
	return
