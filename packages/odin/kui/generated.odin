// The last frame's nodes with what layout and the declarations made of them
// — a tree view's and an inspector's data.
// Rust: Core::nodes.
nodes :: proc(ui: ^Ui) -> Value {
	return Value(c.nodes(ui))
}

// The access tree of the last finished frame (ADR 0001).
// Rust: Core::access_tree.
access_tree :: proc(ui: ^Ui) -> (out: []Access_Node) {
	total := int(c.access_tree(ui, nil, 0))
	buf := make([]c.AccessNode, total, context.temp_allocator)
	n := min(int(c.access_tree(ui, raw_data(buf), uint(total))), total)
	out = make([]Access_Node, n, context.temp_allocator)
	for x, k in buf[:n] do out[k] = access_node_from_c(x)
	return
}

// Says something once with no node behind it (ADR 0001).
// Rust: Ui::announce.
announce :: proc(ui: ^Ui, text: string, live: Live) {
	c.announce(ui, text, u32(live))
}

// Drains what was announced, for a host bridging assistive technology; a
// `KuiWindow`'s bridge is the runner's.
// Rust: Core::take_announcements.
take_announcements :: proc(ui: ^Ui) -> (out: []Announcement) {
	all := make([dynamic]c.Announcement, context.temp_allocator)
	chunk := make([]c.Announcement, 1024, context.temp_allocator)
	for {
		got := int(c.take_announcements(ui, raw_data(chunk[:]), len(chunk)))
		for &x in chunk[:min(got, len(chunk))] {
			x.text = kept(x.text)
		}
		append(&all, ..chunk[:min(got, len(chunk))])
		if got < len(chunk) do break
	}
	buf := all[:]
	n := len(buf)
	out = make([]Announcement, n, context.temp_allocator)
	for x, k in buf[:n] do out[k] = announcement_from_c(x)
	return
}

// kui_input_access (kui.h).
input_access :: proc(ui: ^Ui, key: u64, action: Access_Action, value: string) {
	c.input_access(ui, key, u32(1) << u32(action), value)
}

// kui_access_runs (kui.h).
access_runs :: proc(ui: ^Ui, key: u64) -> (out: []Access_Run) {
	total := int(c.access_runs(ui, key, nil, 0))
	buf := make([]c.AccessRun, total, context.temp_allocator)
	n := min(int(c.access_runs(ui, key, raw_data(buf), uint(total))), total)
	out = make([]Access_Run, n, context.temp_allocator)
	for x, k in buf[:n] do out[k] = access_run_from_c(x)
	return
}

// kui_input_access_text (kui.h).
input_access_text :: proc(ui: ^Ui, key: u64, action: Access_Action, anchor_run: u64, anchor_char: u32, focus_run: u64, focus_char: u32, value: string) {
	c.input_access_text(ui, key, u32(1) << u32(action), anchor_run, anchor_char, focus_run, focus_char, value)
}

// kui_titlebar (kui.h).
titlebar :: proc(ui: ^Ui, title: string) {
	c.titlebar(ui, title)
}

// kui_window_buttons (kui.h).
window_buttons :: proc(ui: ^Ui) {
	c.window_buttons(ui)
}

// kui_tooltip (kui.h).
tooltip :: proc(ui: ^Ui, text: string) {
	c.tooltip(ui, text)
}

// kui_latency_graph (kui.h).
latency_graph :: proc(ui: ^Ui) {
	c.latency_graph(ui)
}

// kui_latency_hud (kui.h).
latency_hud :: proc(ui: ^Ui, x: Align = .End, y: Align = .Start) {
	c.latency_hud(ui, u32(x), u32(y))
}

// kui_select (kui.h).
select :: proc(ui: ^Ui, label: string, items: []Menu_Item, current: i64) -> u64 {
	scratch: Scratch
	defer scratch_free(&scratch)
	items_c := make([]c.MenuItem, len(items), context.temp_allocator)
	for x, k in items do items_c[k] = menu_item_to_c(x, &scratch)
	return c.select(ui, label, raw_data(items_c), uint(len(items)), current)
}

// An editor's text, by key or by label.
// Rust: Ui::edit_text.
edit_text :: proc(ui: ^Ui, key: u64) -> (out: string, ok: bool) #optional_ok {
	ok = c.edit_text(ui, key, &out)
	return
}

// Replaces an editor's text, caret at the end.
// Rust: Ui::set_edit_text.
edit_set_text :: proc(ui: ^Ui, key: u64, text: string) {
	c.edit_set_text(ui, key, text)
}

// The same by the label an editor's `key` declares, which reaches one the
// frame is about to declare (backlog AR26).
// Rust: Ui::set_edit_text_by_label.
edit_set_text_label :: proc(ui: ^Ui, label: string, text: string) {
	c.edit_set_text_label(ui, label, text)
}

// Whether a node has focus.
// Rust: Ui::is_focused.
is_focused :: proc(ui: ^Ui, key: u64) -> bool {
	return c.is_focused(ui, key)
}

// kui_frame_finish (kui.h).
frame_finish :: proc(ui: ^Ui) {
	c.frame_finish(ui)
}

// The draw list: quads, clips, fragment and texture draws (`clips`,
// `fragmentDraws`, `textureDraws` beside `quads` in Node) and the frame's
// stats.
// Rust: Core::output.
draw_data :: proc(ui: ^Ui) -> (out: Draw_Data, ok: bool) #optional_ok {
	c_out := c.DrawData{size = size_of(c.DrawData)}
	ok = c.draw_data(ui, &c_out)
	out = draw_data_from_c(c_out)
	return
}

// The icon every window of the app is created with — RGBA pixels and their
// size — shown by Windows in the title bar, Alt-Tab and the taskbar and by
// X11's window manager; macOS (the bundle's `.icns`) and Wayland (the
// `.desktop` file's) have no window icon (backlog F86).
// Rust: Launcher::icon.
set_icon :: proc(rgba: []u8, width: u32, height: u32, resource: u32) -> bool {
	assert(rgba == nil || len(rgba) >= int(width) * int(height) * 4, "set_icon: rgba holds fewer bytes than int(width) * int(height) * 4")
	return c.set_icon(raw_data(rgba), width, height, resource)
}

// kui_slot_name (kui.h).
slot_name :: proc(ui: ^Ui) -> (out: string, ok: bool) #optional_ok {
	ok = c.slot_name(ui, &out)
	return
}

// kui_slot_namespace (kui.h).
slot_namespace :: proc(ui: ^Ui) -> (out: string, ok: bool) #optional_ok {
	ok = c.slot_namespace(ui, &out)
	return
}

// kui_slot_params (kui.h).
slot_params :: proc(ui: ^Ui) -> Value {
	return Value(c.slot_params(ui))
}

// kui_reply (kui.h).
reply :: proc(ev: Event, reply: any = nil) -> bool {
	scratch: Scratch
	defer scratch_free(&scratch)
	ev_c := event_to_c(ev, &scratch)
	return c.reply(&ev_c, borrow(&scratch, reply))
}

