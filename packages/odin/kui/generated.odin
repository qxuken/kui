Color_Token :: c.ColorToken

Length_Token :: c.LengthToken

// kui.h's KuiDerivedToken.
Derived_Token :: struct {
	name: string,
	from: string,
	ops: []Color_Op,
}

derived_token_to_c :: proc(v: Derived_Token, scratch: ^Scratch) -> (out: c.DerivedToken) {
	out.name = v.name
	out.from = v.from
	{ tmp := make([]c.ColorOp, len(v.ops), context.temp_allocator); for x, k in v.ops do tmp[k] = color_op_to_c(x, scratch); out.ops, out.op_count = raw_data(tmp), uint(len(tmp)) }
	return
}

derived_token_from_c :: proc(v: c.DerivedToken) -> (out: Derived_Token) {
	out.name = v.name
	out.from = v.from
	{ tmp := make([]Color_Op, v.op_count, context.temp_allocator); for &x, k in tmp do x = color_op_from_c(v.ops[k]); out.ops = tmp }
	return
}

// kui.h's KuiColorOp.
Color_Op :: struct {
	op: Color_Op_Kind,
	t: f32,
	other: string,
}

color_op_to_c :: proc(v: Color_Op, scratch: ^Scratch) -> (out: c.ColorOp) {
	out.op = u8(v.op)
	out.t = v.t
	out.other = v.other
	_ = scratch
	return
}

color_op_from_c :: proc(v: c.ColorOp) -> (out: Color_Op) {
	out.op = Color_Op_Kind(v.op)
	out.t = v.t
	out.other = v.other
	return
}

// kui.h's KuiWindowCommand.
Window_Command :: struct {
	kind: Window_Cmd,
	window: u32,
	origin: u16,
	config: Window_Config,
	width: f32,
	height: f32,
	owner: u32,
}

window_command_to_c :: proc(v: Window_Command, scratch: ^Scratch) -> (out: c.WindowCommand) {
	out.size = size_of(c.WindowCommand)
	out.kind = u32(v.kind)
	out.window = v.window
	out.origin = v.origin
	out.config = window_config_to_c(v.config, scratch)
	out.width = v.width
	out.height = v.height
	out.owner = v.owner
	return
}

window_command_from_c :: proc(v: c.WindowCommand) -> (out: Window_Command) {
	out.kind = Window_Cmd(v.kind)
	out.window = v.window
	out.origin = v.origin
	out.config = window_config_from_c(v.config)
	out.width = v.width
	out.height = v.height
	out.owner = v.owner
	return
}

// kui.h's KuiWindowConfig.
Window_Config :: struct {
	kind: Window_Kind,
	width: f32,
	height: f32,
	activates: Maybe(bool),
	anchor_x: f32,
	anchor_y: f32,
	anchor_w: f32,
	anchor_h: f32,
}

window_config_to_c :: proc(v: Window_Config, scratch: ^Scratch) -> (out: c.WindowConfig) {
	out.kind = u32(v.kind)
	out.width = v.width
	out.height = v.height
	out.activates = 1 if (v.activates.? or_else v.kind != .Popup) else 0
	out.anchor_x = v.anchor_x
	out.anchor_y = v.anchor_y
	out.anchor_w = v.anchor_w
	out.anchor_h = v.anchor_h
	_ = scratch
	return
}

window_config_from_c :: proc(v: c.WindowConfig) -> (out: Window_Config) {
	out.kind = Window_Kind(v.kind)
	out.width = v.width
	out.height = v.height
	out.activates = v.activates != 0
	out.anchor_x = v.anchor_x
	out.anchor_y = v.anchor_y
	out.anchor_w = v.anchor_w
	out.anchor_h = v.anchor_h
	return
}

