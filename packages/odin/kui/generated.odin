env_set_window :: proc(ui: ^Ui, window: u32, custom_chrome: bool, maximized: bool, fullscreen: bool, controls_w: f32, controls_h: f32) {
	c.env_set_window(ui, window, custom_chrome, maximized, fullscreen, controls_w, controls_h)
