// -- Spec: the node -----------------------------------------------------------

// Everything a node can declare, one field per row of the prop schema
// (kui_core::schema::PROPS and CUSTOM): the zero value is a plain box that
// fits its content, so a literal names only what differs. Messages take
// any value (message.odin); nil is no handler. docs/props.md documents
// every row under its JSX, Lua and C spellings; this is the Odin one.
Spec :: struct {
	// Column (the zero value), row, or table.
	dir: Dir,
	// Padding per side: pad(16), pad(16, 8), or {l = .., t = ..}.
	pad: Pad,
	// The border's width, and its colour.
	border_w: f32,
	border_color: Color,
	// {.Clip}, {.Scroll_X}, {.Scroll_Y}: what overflows the box is cut, or
	// scrolls.
	overflow: Overflow,
	// Out of flow: placed against the parent or the viewport (float_preset fills
	// one by name).
	float: Float,
	// Declare this node keyboard-focused this frame (kui_set_key_focus),
	// edge-triggered.
	key_focus: bool,
	// A stable key (kui_open_keyed): what transitions, focus and layout events
	// follow; a node with on_drag, on_key or on_hover needs one.
	key: string,
	// A virtual list row's index (kui_open_indexed), a namespace apart from
	// `key`.
	index: Maybe(u64),
	// How many rows this virtual list has, built or not (kui_row_count).
	row_count: Maybe(u64),
	// A hint floated below the node while it is hovered, and its accessible
	// description.
	tooltip: string,
	// Horizontal size: px | "fit" | "grow" | "N%" | a size expression —
	// `"clamp(400px, 80%, 1000px)"`, `"min(720px, 100%)"`, `"max(50%, 300)"`,
	// nested — which layout resolves against the parent's content box, the box
	// a percentage takes its cut of (backlog F109).
	width: Size,
	// Vertical size: px | "fit" | "grow" | "N%" | a size expression (see
	// `width`).
	height: Size,
	// Lower width clamp: logical px, a size expression (see `width`; a percentage
	// clamp is none until the parent's width is known, as in CSS), or "fit" for
	// the node's own fit width.
	min_width: Maybe(Size),
	// Upper width clamp: logical px or a size expression (see `width`);
	// grow+maxWidth is the responsive-width pattern.
	max_width: Maybe(Size),
	// Lower height clamp: logical px, a size expression, or "fit" for the node's
	// own fit height.
	min_height: Maybe(Size),
	// Upper height clamp: logical px or a size expression (see `width`).
	max_height: Maybe(Size),
	// Space between children along the main axis.
	gap: f32,
	// Children that don't fit the main axis start a new line instead of
	// overflowing or shrinking.
	wrap_children: bool,
	// Space between wrap lines, across the main axis (`gap` stays the space along
	// it).
	cross_gap: f32,
	// Child alignment along the main axis.
	main_align: Align,
	// Child alignment across the main axis.
	cross_align: Align,
	// Width over height — `16/9`, `1` for a square — CSS's `aspect-ratio`.
	aspect_ratio: f32,
	// Background fill.
	bg: Color,
	// Corner radius for all four corners (logical px); the per-corner props
	// override it when listed after it.
	radius: f32,
	// Group opacity 0..1 (default 1): fades this node and its whole subtree.
	opacity: Maybe(f32),
	// Paint this node's background, border, shadow and fragment with each edge on
	// a whole physical pixel: `x` and `x + width` rounded on their own, from
	// where layout put them, as a text's span backgrounds are.
	pixel_snap: bool,
	// Drop-shadow color; nothing else about a shadow draws without it.
	shadow_color: Color,
	// Drop-shadow blur radius (logical px): the edge ramps over this distance and
	// reaches this far past the shape.
	shadow_blur: f32,
	// Drop-shadow horizontal offset (logical px).
	shadow_x: f32,
	// Drop-shadow vertical offset (logical px); positive casts downward.
	shadow_y: f32,
	// Grows (or, negative, shrinks) the drop shadow's shape before blurring
	// (logical px).
	shadow_spread: f32,
	// Top-left corner radius (logical px).
	radius_tl: Maybe(f32),
	// Top-right corner radius (logical px).
	radius_tr: Maybe(f32),
	// Bottom-right corner radius (logical px).
	radius_br: Maybe(f32),
	// Bottom-left corner radius (logical px).
	radius_bl: Maybe(f32),
	// Center children on both axes.
	center: bool,
	// Hover-track without a click payload (for isHovered-driven styling).
	hoverable: bool,
	// Ask for another frame after this one, every frame this node is declared.
	animate: bool,
	// Paint this node's background in the OS accent colour —
	// `env.system.accent` — keeping the declared `bg` on a host that cannot
	// tell what it is.
	accent: bool,
	// Makes this node a selection scope: the text of every node inside it is one
	// selectable run, in tree order, and a press-drag across them selects the lot
	// — as do Shift with Left / Right / Home / End on a focused node inside it,
	// a character or a word at a time, a scope with nothing selected anchoring at
	// its start (`docs/adr/0017-selection-as-a-scope.md`).
	selectable: bool,
	// Reachable by Tab (and focused by a click) without a click payload or a
	// control role — a row that opens on Enter.
	focusable: bool,
	// A press on this node, or anywhere inside it, leaves keyboard focus where it
	// was: a toolbar button, a tab or a divider that acts without taking the
	// keyboard from the editor or key sink that had it.
	keep_focus: bool,
	// Makes this node's subtree a focus region: a Tab ring of its own that the
	// ring outside never enters and that never leaves — a devtools dock, an
	// inspector beside the app (`docs/adr/0022-focus-regions.md`).
	focus_region: bool,
	// When a scrolling node draws its bars: `visible` (the default — the stock
	// overlay thumb, drawn while the content overflows), `hidden` (no thumb, no
	// track to press; the wheel, the keyboard, `reveal` and the caret still
	// scroll it — for a list that draws its own indicator, or a pane whose bar
	// would sit on a border), or `auto` (shown while the scroll state is changing
	// — the offset or the content's extent moved, the pointer is on the track,
	// a thumb is dragged — and for a second after, then faded out over a
	// quarter of one; a node first seen shows it the same second; what an overlay
	// bar does on macOS).
	scrollbar: Scrollbar,
	// Scroll anchoring on a scrolling node (backlog C26, CSS's
	// `overflow-anchor`): the first child in view keeps its place on screen when
	// the content before it changes size — a chat that prepends history, a log
	// that inserts rows above the viewport, a list whose row heights are
	// corrected as they are measured — with no `setScroll` and no arithmetic in
	// the view.
	anchor: bool,
	// The thumb's width at rest, logical px (default 4); under the pointer or
	// dragged it is 2 px wider.
	scrollbar_width: f32,
	// The thumb at rest; the default is the theme's `scrollbar` role, a
	// translucent wash over whatever it sits on.
	scrollbar_color: Color,
	// The thumb under the pointer or while dragged; the default is the theme's
	// `scrollbar_active` role.
	scrollbar_active_color: Color,
	// What a scroll gesture that starts over this scroller does when it is
	// already at its limit that way (backlog F107, CSS's `overscroll-behavior`):
	// `auto` (the default) passes the gesture on to the scroller around it,
	// `contain` keeps it here, moving nothing until it turns back.
	overscroll: Overscroll,
	// Inert: no click, drag or key sink, no hover / pressed / focus background,
	// skipped by Tab, reported disabled to assistive technology; hover tracking
	// stays so a `tooltip` can say why.
	disabled: bool,
	// Background while hovered (or while any node in its hoverGroup is); implies
	// hover tracking, eases with `transition`.
	hover_bg: Color,
	// A gradient painted over the node's `bg` and under its border and its
	// children (`docs/adr/0042-a-gradient-is-an-image-the-core-paints.md`): `{
	// to: 'bottom', stops: [...] }` towards a side or a corner (`right`, `bottom
	// left`, …; the default is `bottom`), `{ angle: 0.125, stops }` in turns
	// clockwise from east, or `{ radial: true, at: [0.5, 0], stops }` out from a
	// centre (fractions of the box, the middle by default) to its farthest
	// corner.
	gradient: Maybe(Gradient),
	// Blur what was drawn beneath the node, inside its rounded box, by this
	// radius in logical px — CSS's `backdrop-filter: blur()`, the radius its
	// standard deviation (backlog F129).
	backdrop_blur: f32,
	// Turns this node and everything under it, in turns clockwise (0.25 is a
	// quarter turn right), about its pivot — the centre unless `pivotX` /
	// `pivotY` say — after layout
	// (`docs/adr/0043-a-node-turns-about-its-pivot.md`).
	rotate: f32,
	// Scales this node and everything under it by this factor, uniformly, about
	// its pivot, after layout (`docs/adr/0043-a-node-turns-about-its-pivot.md`);
	// 1 is none.
	scale: f32,
	// Where across the box `rotate` and `scale` are about, as a fraction of its
	// width: 0 the left edge, 0.5 (the default) the middle, 1 the right edge;
	// outside 0..1 is a point past the box.
	pivot_x: Maybe(f32),
	// Where down the box `rotate` and `scale` are about, as a fraction of its
	// height: 0 the top, 0.5 (the default) the middle, 1 the bottom.
	pivot_y: Maybe(f32),
	// On a table (`dir="table"`, ADR 0033): grid lines of this colour between its
	// columns and between its rows (backlog DX21) — down the middle of each gap
	// between the columns of its widest row, from the first row's top to the last
	// row's bottom, and across the middle of each gap between rows, the content
	// box wide.
	rules: Color,
	// The width of a table's `rules` in logical px; 1 when unset.
	rule_width: f32,
	// Background while files dragged in from the OS are over this node (ADR
	// 0031); wins over pressedBg, focusBg and hoverBg, clears when they leave,
	// land or the drag is cancelled.
	drop_bg: Color,
	// Background while pressed (or while its hoverGroup is); implies hover
	// tracking.
	pressed_bg: Color,
	// Background while the node holds keyboard-visible focus (moved there by Tab
	// or assistive technology, not a click); replaces the default focus ring.
	focus_bg: Color,
	// Modal surface: the Tab ring becomes this node's subtree, everything outside
	// it is inert to the pointer, the wheel and assistive technology, and Escape
	// or a press outside emits {kind:"dismiss", reason:"escape"|"outside", tag}
	// on it — the app stops declaring the node.
	modal: any,
	// Where focus lands when the enclosing `modal` scope is entered: the first
	// node in the modal's Tab ring declaring it, so a destructive confirm opens
	// on its Cancel rather than on whichever control is declared first.
	initial_focus: bool,
	// Nodes sharing a group name show hoverBg/pressedBg together (a split button,
	// a multi-piece shape).
	hover_group: string,
	// Hover tag: the pointer entering/leaving emits {kind:"hover",
	// phase:"enter"|"leave", tag} events.
	on_hover: any,
	// Drop-zone tag
	// (`docs/adr/0031-a-drop-zone-is-a-row-and-the-files-are-an-event.md`): files
	// dragged in from the OS over this node emit {kind:"drop",
	// phase:"enter"|"move"|"leave"|"drop", paths, x, y, tag} — `paths` the OS
	// paths as strings, `x`/`y` the pointer in logical viewport coordinates
	// (absent on `leave`).
	on_drop: any,
	// Layout tag: the node's laid-out rect arrives as {kind:"layout", x, y, w, h,
	// parent, tag} on its first frame and whenever it changes (needs a stable
	// key).
	on_layout: any,
	// Message emitted when clicked (data, not a callback).
	on_click: any,
	// Drag tag: emits {kind:"drag", phase, x, y, dx, dy, parent, tag} events,
	// `dx`/`dy` measured from the press point in every phase.
	on_drag: any,
	// Key-sink tag: with key focus held, presses arrive as {kind:"key",
	// phase:"down", code, ...} events.
	on_key: any,
	// With `onKey`: releases arrive too, as the same payload with phase:"up"
	// (`text` null, `repeat` false) — for a held-key interaction (WASD,
	// press-and-hold, a key that arms a mode while it is down).
	key_up: bool,
	// With `onKey`: the modifier and lock keys arrive as keys of their own
	// (backlog F108) — `code` "shift", "ctrl", "alt", "super", "capslock",
	// "numlock", "scrolllock", which side in `location` ("left" / "right"),
	// releases too with `keyUp`.
	modifier_keys: bool,
	// Context-menu tag: a secondary-button (right) press emits
	// {kind:"contextmenu", x, y, tag} on the node, at the logical viewport point
	// to open the menu at.
	on_context_menu: any,
	// Force-click tag: a press that deepens past the second stage of a Force
	// Touch trackpad emits {kind:"forceclick", x, y, tag} on the node, at the
	// logical viewport point it happened at
	// (`docs/adr/0017-selection-as-a-scope.md`).
	on_force_click: any,
	// Button tag (backlog F105): a press of a non-primary button — middle,
	// secondary, or one past those — emits {kind:"button", phase:"press",
	// button, x, y, clicks, tag} on the node, and the button is then captured by
	// it: every pointer move while it is held arrives as phase:"move" and its
	// release as phase:"release", on this node wherever the pointer is.
	on_button: any,
	// Which non-primary buttons `onButton` claims (backlog F105): `"secondary"`,
	// `"middle"` and `"other"` (every button past those), separated by spaces or
	// commas — `"middle"`, `"secondary middle"`.
	buttons: Mouse_Buttons,
	// Scroll tag: the wheel over this node emits {kind:"scroll", x, y, dx, dy,
	// lines, tag} on it instead of scrolling anything — `dx`/`dy` the delta in
	// logical px as the driver reported it (positive `dy` is the wheel rolling
	// up, toward earlier content), `x`/`y` the pointer, and `lines` on a `cells`
	// grid the whole lines the delta covers (positive = later history, the sign
	// `originLine` grows in; the fraction is carried to the next notch so a
	// trackpad's small steps add up) and null on any other node.
	on_scroll: any,
	// Which axes `onScroll` takes (backlog F107): `both` (the default), `x` or
	// `y`.
	scroll_axes: Scroll_Axes,
	// The modifiers `onScroll` is for (backlog F122): `"shift"`, `"ctrl"`,
	// `"alt"` and `"super"` (⌘, the Windows key), separated by spaces or commas
	// — `"ctrl super"`.
	scroll_mods: Mods,
	// Window-chrome role: interactions become window commands, not events.
	window: Window_Role,
	// The pointer shape over this node.
	cursor: Cursor,
	// Animate sizing/colors/radius changes over this many ms — and, on a scroll
	// container, the offset a reveal or a set_scroll moves it to (needs a stable
	// key).
	transition: f32,
	// Easing for `transition` (default easeOut).
	easing: Ease,
	// How far a spring overshoots its target: 0 glides in with none, 0.5 bounces
	// visibly, and values past 0.9 are held there (a spring at 1 would never
	// settle).
	bounce: f32,
	// With transition: also ease the node's position (reordered siblings slide).
	slide: bool,
	// CSS-style stops `[{ at?, dx?, dy?, width?, height?, bg?, radius?, opacity?,
	// rotate?, scale? }, …]`: the slots they name cycle through them over
	// `transition` ms, for ever unless `iterations` says how many times, without
	// the view redrawing; `at` is 0..1 and spreads evenly when omitted.
	keyframes: []Keyframe,
	// Where the node starts the first frame it is seen `{ dx?, dy?, width?,
	// height?, bg?, radius?, opacity?, rotate?, scale? }`: those slots ease in
	// from there over `transition` ms instead of snapping (`dx`/`dy` slide it in
	// from that far away, `opacity: 0` fades the whole subtree in, `scale: 0.8`
	// settles it in).
	enter: Enter,
	// Where the node ends the frame after the view stops declaring it `{ dx?,
	// dy?, width?, height?, bg?, radius?, opacity?, rotate?, scale? }` — an
	// `enter` read the other way.
	exit: Enter,
	// How `keyframes` cycle (CSS `animation-direction`, default normal).
	repeat: Repeat,
	// Holds the `keyframes` cycle back by this many ms (CSS `animation-delay`);
	// siblings with different delays run out of phase.
	delay: f32,
	// How many times the `keyframes` cycle runs (CSS `animation-iteration-count`,
	// backlog F133); left out, for ever.
	iterations: f32,
	// A registered sound (addSound) played when the node is clicked; implies
	// hover tracking.
	click_sound: Sound,
	// A registered sound (addSound) played when the pointer enters the node;
	// implies hover tracking.
	hover_sound: Sound,
	// What the node is to assistive technology.
	role: Role,
	// The accessible name.
	label: string,
	// The accessible description: the extra sentence a reader says after the
	// name, for what the name cannot say on its own — what a button will do,
	// why a control is disabled, what format a field wants.
	description: string,
	// The on state of a `checkbox` / `radio` / `switch` role.
	checked: bool,
	// A `checkbox` that is neither on nor off — the select-all box over a list
	// some of whose rows are selected (ADR 0034).
	mixed: bool,
	// The current one of a set: which `tab` a `tabList` shows, which `listItem` a
	// list has picked, which `link` is the page you are on.
	selected: bool,
	// A disclosure's state: what a node that shows and hides something (a twisty,
	// an accordion header, a menu button) reads as.
	expanded: Expanded,
	// Marks this node a live region: when the text inside it changes, a screen
	// reader reads the change without being asked — `polite` at the next pause,
	// `assertive` interrupting.
	live: Live,
	// A `slider` role's current value (the drawing stays yours; this is what
	// assistive technology reads).
	value_now: Maybe(f32),
	// A `slider` role's minimum.
	value_min: Maybe(f32),
	// A `slider` role's maximum.
	value_max: Maybe(f32),
	// What a `slider` role's position reads as (ARIA's `aria-valuetext`).
	value_text: string,
	// How far one arrow key moves a `slider` role, and the grid a value the
	// pointer sets snaps to (ADR 0034).
	value_step: Maybe(f32),
	// Keyboard focus entering or leaving this node's subtree — the node itself,
	// or anything focused inside it — emits `{kind:"focus", phase:"in"|"out",
	// by, tag}` (backlog DX18).
	on_focus: any,
	// A `slider` role's changes (ADR 0034): the core turns a press on the node
	// into the value under the pointer, a drag into the value under it, the
	// arrows and assistive technology's increment / decrement into one
	// `valueStep`, PageUp / PageDown into ten, Home / End into the range's ends
	// — clamped to `valueMin`..`valueMax` (0..100 unset) and snapped to the
	// step — and emits `{kind:"change", value, phase, tag}`: `phase` is
	// `"move"` while the pointer holds the slider and `"end"` when it lets go or
	// a key moved it.
	on_change: any,
	// On a `line` of a custom editor (a `textInput` / `multilineTextInput` role
	// drawn by the app): the caret's byte offset into that line's text.
	caret: Maybe(int),
	// On a `line` of a custom editor: the byte offset where the selection's other
	// end sits (the caret is `caret`, possibly on another line).
	selection_anchor: Maybe(int),
	// On a `line` declaring `caret`: the caret is solid — a block caret in a
	// modal editor's normal mode — so the driver's blink clock is not armed on
	// it and `caretVisible` stays true, while the offset still anchors the IME
	// and reads to assistive technology.
	caret_solid: bool,
}

// Spec as kui_open reads it. The message fields with a C field are
// borrowed (encoded into scratch, freed after the call); on_click, on_drag,
// on_key and on_hover are open's arguments and lowered there.
spec_to_c :: proc(s: Spec, out: ^c.Spec, scratch: ^Scratch) {
	out.dir = u32(s.dir)
	out.pad_l, out.pad_r, out.pad_t, out.pad_b = s.pad.l, s.pad.r, s.pad.t, s.pad.b
	out.border_w, out.border_color = s.border_w, s.border_color
	out.overflow = transmute(u32)s.overflow
	lower_float(s.float, out)
	out.tooltip = s.tooltip
	out.width = transmute(c.Sizing)s.width
	out.height = transmute(c.Sizing)s.height
	lower_min(s.min_width, &out.min_w, &out.min_w_size)
	lower_max(s.max_width, &out.max_w, &out.max_w_size)
	lower_min(s.min_height, &out.min_h, &out.min_h_size)
	lower_max(s.max_height, &out.max_h, &out.max_h_size)
	out.gap = s.gap
	out.wrap_children = 1 if s.wrap_children else 0
	out.cross_gap = s.cross_gap
	out.main_align = u32(s.main_align)
	out.cross_align = u32(s.cross_align)
	out.aspect_ratio = s.aspect_ratio
	out.bg = s.bg
	out.radius = s.radius
	if v, ok := s.opacity.?; ok do out.opacity_set, out.opacity = 1, v
	out.pixel_snap = 1 if s.pixel_snap else 0
	out.shadow_color = s.shadow_color
	out.shadow_blur = s.shadow_blur
	out.shadow_x = s.shadow_x
	out.shadow_y = s.shadow_y
	out.shadow_spread = s.shadow_spread
	lower_corner(s.radius_tl, s.radius, &out.radius_tl, &out.per_corner)
	lower_corner(s.radius_tr, s.radius, &out.radius_tr, &out.per_corner)
	lower_corner(s.radius_br, s.radius, &out.radius_br, &out.per_corner)
	lower_corner(s.radius_bl, s.radius, &out.radius_bl, &out.per_corner)
	if s.center do out.main_align, out.cross_align = c.CENTER, c.CENTER
	out.hoverable = 1 if s.hoverable else 0
	out.animate = 1 if s.animate else 0
	out.accent = 1 if s.accent else 0
	out.selectable = 1 if s.selectable else 0
	out.focusable = 1 if s.focusable else 0
	out.keep_focus = 1 if s.keep_focus else 0
	out.focus_region = 1 if s.focus_region else 0
	out.scrollbar = u32(s.scrollbar)
	out.anchor = 1 if s.anchor else 0
	out.scrollbar_width = s.scrollbar_width
	out.scrollbar_color = s.scrollbar_color
	out.scrollbar_active_color = s.scrollbar_active_color
	out.overscroll = u32(s.overscroll)
	out.disabled = 1 if s.disabled else 0
	out.hover_bg = s.hover_bg
	if gr, ok := s.gradient.?; ok do out.gradient = lower_gradient(gr)
	out.backdrop_blur = s.backdrop_blur
	out.rotate = s.rotate
	out.scale = s.scale
	if v, ok := s.pivot_x.?; ok do out.pivot_set, out.pivot_x = out.pivot_set | c.PIVOT_X, v
	if v, ok := s.pivot_y.?; ok do out.pivot_set, out.pivot_y = out.pivot_set | c.PIVOT_Y, v
	out.rules = s.rules
	out.rule_w = s.rule_width
	out.drop_bg = s.drop_bg
	out.pressed_bg = s.pressed_bg
	out.focus_bg = s.focus_bg
	out.modal = borrow(scratch, s.modal)
	out.initial_focus = 1 if s.initial_focus else 0
	out.hover_group = s.hover_group
	out.on_drop = borrow(scratch, s.on_drop)
	out.on_layout = borrow(scratch, s.on_layout)
	out.key_up = 1 if s.key_up else 0
	out.modifier_keys = 1 if s.modifier_keys else 0
	out.on_context_menu = borrow(scratch, s.on_context_menu)
	out.on_force_click = borrow(scratch, s.on_force_click)
	out.on_button = borrow(scratch, s.on_button)
	out.buttons = transmute(u32)s.buttons
	out.on_scroll = borrow(scratch, s.on_scroll)
	out.scroll_axes = u32(s.scroll_axes)
	out.scroll_mods = transmute(u32)s.scroll_mods
	out.window_role = u32(s.window)
	out.cursor = u32(s.cursor)
	out.transition_ms = s.transition
	out.easing = u32(s.easing)
	out.bounce = s.bounce
	out.slide = 1 if s.slide else 0
	out.keyframes, out.keyframes_len = ([^]c.Keyframe)(raw_data(s.keyframes)), uint(len(s.keyframes))
	out.enter = transmute(c.Enter)s.enter
	out.exit = transmute(c.Enter)s.exit
	out.repeat = u32(s.repeat)
	out.delay_ms = s.delay
	out.iterations = s.iterations
	out.click_sound = u64(s.click_sound)
	out.hover_sound = u64(s.hover_sound)
	out.role = u32(s.role)
	out.label = s.label
	out.description = s.description
	out.checked = 1 if s.checked else 0
	out.mixed = 1 if s.mixed else 0
	out.selected = 1 if s.selected else 0
	out.expanded = u32(s.expanded)
	out.live = u32(s.live)
	if v, ok := s.value_now.?; ok do out.value_set, out.value_now = out.value_set | c.VALUE_NOW, v
	if v, ok := s.value_min.?; ok do out.value_set, out.value_min = out.value_set | c.VALUE_MIN, v
	if v, ok := s.value_max.?; ok do out.value_set, out.value_max = out.value_set | c.VALUE_MAX, v
	out.value_text = s.value_text
	if v, ok := s.value_step.?; ok do out.value_set, out.value_step = out.value_set | c.VALUE_STEP, v
	out.on_focus = borrow(scratch, s.on_focus)
	out.on_change = borrow(scratch, s.on_change)
	if v, ok := s.caret.?; ok do out.value_set, out.caret = out.value_set | c.VALUE_CARET, u32(v)
	if v, ok := s.selection_anchor.?; ok do out.value_set, out.selection_anchor = out.value_set | c.VALUE_ANCHOR, u32(v)
	if s.caret_solid do out.value_set |= c.VALUE_CARET_SOLID
}

// -- Text_Style ------------------------------------------------------------------

// How a text is set, one field per style row of the prop schema; the zero
// value is the theme's body text.
Text_Style :: struct {
	// The text's size in logical px; zero is the theme's.
	size: f32,
	// Line height (logical px); default size * 1.35.
	line_height: f32,
	// Text color; default foreground when omitted.
	color: Color,
	// Font family: `sans`, `serif` or `mono`, kui's own, or the name of an
	// installed family or one loaded with `loadFontsDir` / `loadFontFile` —
	// `"Berkeley Mono"` — drawn in its face in the frame that names it (ADR
	// 0037).
	family: Font_Family,
	// A registered font handle (addFont / addSystemFont); overrides `family`.
	font: Font,
	// Line breaking at the node's width: between words (default), anywhere, never
	// (one line per paragraph, clipped to the node), or between words with
	// whitespace taking its room (`break-spaces`: a space that does not fit
	// starts the next row rather than hanging past the edge — an editor's
	// wrapped line).
	wrap: Wrap,
	// Lay out at most this many lines (0 = unlimited); with `ellipsis`, a line
	// clamp.
	max_lines: int,
	// End the last line with an ellipsis when the text is cut off: a single line
	// unless `maxLines` says otherwise.
	ellipsis: bool,
	// A line under the text, where the face puts its underline and as thick as it
	// says, in the text colour.
	underline: bool,
	// The underline's own colour — a diagnostic's red under keyword-coloured
	// text (backlog K4).
	underline_color: Color,
	// The underline's shape (backlog K4): `solid` (the face's line), `wavy`
	// (three strokes tall around the line, a six-stroke period — a diagnostic's
	// squiggle, a terminal's undercurl) or `dotted` (dots two strokes across,
	// four apart).
	underline_style: Underline_Style,
	// A line through the text, where the face puts its strikeout.
	strikethrough: bool,
	// The family's bold, on a whole text or an editor (backlog F150) — a
	// heading, a table's header, a title field: its bold face, or its regular
	// drawn bold where the family has none, as a `<span bold>` is.
	bold: bool,
	// OpenType features for the shaper, as `tag=value` pairs separated by spaces
	// or commas — a bare `tag` is 1, `-tag` is 0: `"liga=0 calt=0"` keeps a
	// coding font from joining `->` and `!=` (what a terminal built on runs needs
	// to hold its grid), `"tnum"` lines figures up in a gutter, `"ss01"` picks a
	// stylistic set.
	features: string,
}

text_style_to_c :: proc(s: Text_Style) -> (out: c.TextStyle) {
	out.size = s.size
	out.line_height = s.line_height
	out.color = s.color
	out.family = u32(s.family)
	out.font = u64(s.font)
	out.wrap = u32(s.wrap)
	out.max_lines = u32(s.max_lines)
	out.ellipsis = 1 if s.ellipsis else 0
	if s.underline do out.decoration |= c.DECO_UNDERLINE
	out.underline_color = s.underline_color
	out.underline_style = u32(s.underline_style)
	if s.strikethrough do out.decoration |= c.DECO_STRIKETHROUGH
	out.bold = 1 if s.bold else 0
	out.features = s.features
	return
}

// -- The structs the doors take and return -------------------------------------

// kui.h's KuiEvent.
Event :: struct {
	origin: u16,
	key: u64,
	payload: Value,
	window: u32,
	reply_sink: ^c.ReplySink,
	slot: u64,
}

event_to_c :: proc(v: Event, scratch: ^Scratch) -> (out: c.Event) {
	out.size = size_of(c.Event)
	out.origin = v.origin
	out.key = v.key
	out.payload = (^c.Value)(v.payload)
	out.window = v.window
	out.reply_sink = v.reply_sink
	out.slot = v.slot
	_ = scratch
	return
}

event_from_c :: proc(v: c.Event) -> (out: Event) {
	out.origin = v.origin
	out.key = v.key
	out.payload = Value(v.payload)
	out.window = v.window
	out.reply_sink = v.reply_sink
	out.slot = v.slot
	return
}

