	out.italic = 1 if v.italic else 0
	_ = scratch
	return
}

system_font_from_c :: proc(v: c.SystemFont) -> (out: System_Font) {
	out.family = v.family
	out.weights = ([^]u16)(v.weights)[:v.weight_count]
	out.monospaced = v.monospaced != 0
