	spec_to_c(spec, &spec_c, &scratch)
	c.polyline(ui, label, ([^]f32)(raw_data(xy)), uint(len(xy)), width, color, curve, raw_data(dash_v[:]) if dash_ok else nil, &spec_c, to_value(on_click), to_value(on_drag), to_value(on_hover))
}

