	out.multiple = 1 if v.multiple else 0
	out.title = v.title
	{ tmp := make([]c.FileFilter, len(v.filters), context.temp_allocator); for x, k in v.filters do tmp[k] = file_filter_to_c(x, scratch); out.filters, out.filter_count = raw_data(tmp), uint(len(tmp)) }
	out.directory = v.directory
	out.file_name = v.file_name
	return
}

file_dialog_from_c :: proc(v: c.FileDialog) -> (out: File_Dialog) {
	out.mode = File_Dialog_Mode(v.mode)
	out.multiple = v.multiple != 0
	out.title = v.title
	{ tmp := make([]File_Filter, v.filter_count, context.temp_allocator); for &x, k in tmp do x = file_filter_from_c(v.filters[k]); out.filters = tmp }
	out.directory = v.directory
	out.file_name = v.file_name
	return
}

