	out = text_metrics_from_c(c_out)
	return
}

// The same for spans, shaped as one paragraph.
// Rust: Ui::measure_rich_text.
measure_rich_text :: proc(ui: ^Ui, spans: []Span, base: Text_Style, max_w: f32) -> (out: Text_Metrics, ok: bool) #optional_ok {
	base_c := text_style_to_c(base)
