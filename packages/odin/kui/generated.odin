}

// The pointer shape the frame asks for, which the host sets on its window.
// Rust: Core::cursor_shape.
cursor_shape :: proc(ui: ^Ui) -> Cursor {
	return Cursor(c.cursor_shape(ui))
}

// Declares the window's title this frame.
// Rust: Ui::window_title.
window_title :: proc(ui: ^Ui, title: string) {
	c.window_title(ui, title)
}

// What the frame declared, for a driver applying it; a `KuiWindow` applies
// its own.
// Rust: Core::window_title.
window_title_get :: proc(ui: ^Ui) -> (out: string, ok: bool) #optional_ok {
	ok = c.window_title_get(ui, &out)
	return
}

// Declares that the window sits above every other app's this frame (backlog
// C30).
// Rust: Ui::always_on_top.
set_always_on_top :: proc(ui: ^Ui, on_top: bool) {
	c.set_always_on_top(ui, on_top)
}

// The same for the level.
// Rust: Core::always_on_top.
always_on_top_get :: proc(ui: ^Ui) -> bool {
	return c.always_on_top_get(ui)
}

// kui_env_set_always_on_top (kui.h).
env_set_always_on_top :: proc(ui: ^Ui, always_on_top: bool) {
	c.env_set_always_on_top(ui, always_on_top)
}

// kui_env_set_backdrop (kui.h).
env_set_backdrop :: proc(ui: ^Ui, backdrop: Backdrop) {
	c.env_set_backdrop(ui, u32(backdrop))
}

// kui_ctx_backdrop (kui.h).
ctx_backdrop :: proc(ui: ^Ui) -> Backdrop {
	return Backdrop(c.ctx_backdrop(ui))
}

// Declares that this frame wants secure keyboard entry while the window has
// the keyboard — a password prompt (backlog F85).
// Rust: Ui::secure_input.
set_secure_input :: proc(ui: ^Ui, on: bool) {
	c.set_secure_input(ui, on)
}

// The same for the secure-input ask: what a driver with its own loop reads to
// make the platform call; the runner makes it for a `KuiWindow` and
// `kui_run`.
// Rust: Core::secure_input.
secure_input_get :: proc(ui: ^Ui) -> bool {
	return c.secure_input_get(ui)
}

// Declares which Option keys act as Alt in this window on macOS, so a dead
// key like ⌥u arrives as `<A-u>` (backlog F113).
// Rust: Ui::option_as_alt.
set_option_as_alt :: proc(ui: ^Ui, option_as_alt: Option_As_Alt) {
	c.set_option_as_alt(ui, u32(option_as_alt))
}

// The same for the Option-as-Alt ask: what a driver with its own loop reads
// to apply it to its window; the runner applies it for a `KuiWindow` and
// `kui_run`.
// Rust: Core::option_as_alt.
option_as_alt_get :: proc(ui: ^Ui) -> Option_As_Alt {
	return Option_As_Alt(c.option_as_alt_get(ui))
}

// Declares that this window takes the keyboard as keys, with the input method
// off — no composition, and on a Mac no dead keys and no press-and-hold, so
// a held letter repeats (backlog F125).
// Rust: Ui::ime_off.
set_ime_off :: proc(ui: ^Ui, off: bool) {
	c.set_ime_off(ui, off)
}

// The same for the input-method ask: what a driver with its own loop reads to
// apply it to its window; the runner applies it for a `KuiWindow` and
// `kui_run`.
// Rust: Core::ime_off.
ime_off_get :: proc(ui: ^Ui) -> bool {
	return c.ime_off_get(ui)
}

// kui_frame_begin (kui.h).
frame_begin :: proc(ui: ^Ui, w: f32, h: f32, scale: f32) {
	c.frame_begin(ui, w, h, scale)
}

// kui_row_count (kui.h).
row_count :: proc(ui: ^Ui, rows: u64) {
	c.row_count(ui, rows)
}

// kui_slot (kui.h).
slot :: proc(ui: ^Ui, name: string, params: any = nil) -> bool {
	scratch: Scratch
	defer scratch_free(&scratch)
	return c.slot(ui, name, borrow(&scratch, params))
}

// Declares a slot as `slot` does and keeps what the fill built — every node
// as its door saw it, the slots inside, every fact of the frame it read —
// for `slot_replay` to push again (ADR 0045).
// Rust: Ui::slot_kept.
slot_kept :: proc(ui: ^Ui, name: string, params: any = nil) -> bool {
	scratch: Scratch
	defer scratch_free(&scratch)
	return c.slot_kept(ui, name, borrow(&scratch, params))
}

// The host's claim that nothing it feeds the extension changed: the core
// checks the params, every fact the kept fill read and the slot's place, and
// pushes the kept nodes again without the extension, or fills and keeps and
// says why (ADR 0045).
// Rust: Ui::slot_replay.
slot_replay :: proc(ui: ^Ui, name: string, params: any = nil) -> i32 {
	scratch: Scratch
	defer scratch_free(&scratch)
	return c.slot_replay(ui, name, borrow(&scratch, params))
}

// What the last `slot_replay` of a name answered this frame, or the frame
// before while this one is being built: replayed, or why it was filled fresh
// (ADR 0045).
// Rust: Core::slot_fill.
slot_fill :: proc(ui: ^Ui, name: string) -> i32 {
	return c.slot_fill(ui, name)
}

// Loads a plugin under a namespace; a `KuiWindow` takes its list at
// construction (`extensions`).
// Rust: Ui::add_extension.
ctx_add_extension :: proc(ui: ^Ui, namespace_: string, path: string) -> bool {
	return c.ctx_add_extension(ui, namespace_, path)
}

// kui_ctx_extension_error (kui.h).
ctx_extension_error :: proc(ui: ^Ui) -> (out: string, ok: bool) #optional_ok {
	ok = c.ctx_extension_error(ui, &out)
	return
}

// kui_ctx_extension_count (kui.h).
ctx_extension_count :: proc(ui: ^Ui) -> u32 {
	return c.ctx_extension_count(ui)
}

// kui_ctx_extension_namespace (kui.h).
ctx_extension_namespace :: proc(ui: ^Ui, origin: u16) -> (out: string, ok: bool) #optional_ok {
	ok = c.ctx_extension_namespace(ui, origin, &out)
	return
}

// kui_open_draggable (kui.h).
open_draggable :: proc(ui: ^Ui, label: string, spec: Spec = {}, on_click: any = nil, on_drag: any = nil) -> u64 {
	scratch: Scratch
	defer scratch_free(&scratch)
	spec_c: c.Spec
	spec_to_c(spec, &spec_c, &scratch)
	return c.open_draggable(ui, label, &spec_c, to_value(on_click), to_value(on_drag))
}

// kui_set_key_focus (kui.h).
set_key_focus :: proc(ui: ^Ui, key: u64) {
	c.set_key_focus(ui, key)
}

// Moves focus to a node now; an app's move stands over a modal's restore
// (backlog AR17).
// Rust: Ui::focus.
focus :: proc(ui: ^Ui, key: u64) {
	c.focus(ui, key)
}

// The key a key label names this frame: the name the view opened the node
// under, not the one a reader hears.
// Rust: Ui::key_of.
key_of :: proc(ui: ^Ui, label: string) -> u64 {
	return c.key_of(ui, label)
}

// The key of the first node a reader hears named so in the last frame: a test
// presses the button named Like.
// Rust: Core::key_named.
key_named :: proc(ui: ^Ui, name: string) -> u64 {
	return c.key_named(ui, name)
}

// Steps the Tab ring forward (ADR 0002).
// Rust: Ui::focus_next.
focus_next :: proc(ui: ^Ui, forward: bool) {
	c.focus_next(ui, forward)
}

// The focused node's key.
// Rust: Ui::focused.
focused :: proc(ui: ^Ui) -> u64 {
	return c.focused(ui)
}

// Whether focus came from the keyboard and the ring should show.
// Rust: Ui::focus_visible.
focus_visible :: proc(ui: ^Ui) -> bool {
	return c.focus_visible(ui)
}

// The blink phase a custom editor draws its caret on.
// Rust: Ui::caret_visible.
caret_visible :: proc(ui: ^Ui) -> bool {
	return c.caret_visible(ui)
}

// The host's blink clock writes the phase.
// Rust: Core::set_caret_visible.
set_caret_visible :: proc(ui: ^Ui, visible: bool) {
	c.set_caret_visible(ui, visible)
}

// Whether anything focused draws a caret to blink — a `caretSolid` line's
// is not one — which arms a host's blink clock.
// Rust: Core::has_caret.
has_caret :: proc(ui: ^Ui) -> bool {
	return c.has_caret(ui)
}

// Changes when the caret moves or focus does, which re-arms the clock solid.
// Rust: Core::caret_stamp.
caret_stamp :: proc(ui: ^Ui) -> u64 {
	return c.caret_stamp(ui)
}

// Enters a `focusRegion`'s ring, or leaves it for the main one (ADR 0022).
// Rust: Ui::focus_region.
focus_region :: proc(ui: ^Ui, key: u64) {
	c.focus_region(ui, key)
}

// The region in effect.
// Rust: Ui::region.
region :: proc(ui: ^Ui) -> u64 {
	return c.region(ui)
}

// Scrolls whatever encloses a node until it is in view.
// Rust: Ui::reveal.
reveal :: proc(ui: ^Ui, key: u64) {
	c.reveal(ui, key)
}

// Scrolls a node to an offset.
// Rust: Ui::set_scroll.
set_scroll :: proc(ui: ^Ui, key: u64, x: f32, y: f32) {
	c.set_scroll(ui, key, x, y)
}

// Moves a node's scroll by content that moved under it, with no ease: a
// variable-height list's anchor (backlog C46).
// Rust: Ui::shift_scroll.
shift_scroll :: proc(ui: ^Ui, key: u64, drawn: f32, target: f32) {
	c.shift_scroll(ui, key, drawn, target)
}

// A scrolling node's offset.
// Rust: Ui::scroll_offset.
scroll_offset :: proc(ui: ^Ui, key: u64) -> (x: f32, y: f32) {
	c_x: f32
	c_y: f32
	c.scroll_offset(ui, key, &c_x, &c_y)
	x = c_x
	y = c_y
	return
}

// Where layout put a node last frame (backlog C26).
// Rust: Ui::layout_of.
layout_of :: proc(ui: ^Ui, key: u64) -> (out: Layout_Rect, ok: bool) #optional_ok {
	c_out := c.LayoutRect{size = size_of(c.LayoutRect)}
	ok = c.layout_of(ui, key, &c_out)
	out = layout_rect_from_c(c_out)
	return
}

// A scrolling node's viewport and content sizes.
// Rust: Ui::scroll_geometry.
scroll_geometry :: proc(ui: ^Ui, key: u64) -> (out: Scroll_Geometry, ok: bool) #optional_ok {
	c_out := c.ScrollGeometry{size = size_of(c.ScrollGeometry)}
	ok = c.scroll_geometry(ui, key, &c_out)
	out = scroll_geometry_from_c(c_out)
	return
}

// Registers a font's bytes and mints an id for `font`.
// Rust: Core::add_font_data.
font_add :: proc(ui: ^Ui, data: []u8) -> Font {
	return Font(c.font_add(ui, ([^]u8)(raw_data(data)), uint(len(data))))
}

// Registers an installed family by name.
// Rust: Core::add_system_font.
font_add_system :: proc(ui: ^Ui, name: string) -> Font {
	return Font(c.font_add_system(ui, name))
}

// The installed family names `add_system_font` accepts.
// Rust: Core::system_font_families.
font_families :: proc(ui: ^Ui) -> (out: []string) {
	total := int(c.font_families(ui, nil, 0))
	buf := make([]string, total, context.temp_allocator)
	n := min(int(c.font_families(ui, raw_data(buf), uint(total))), total)
	out = buf[:n]
	return
}

// The same families, each with what the font database read off its faces:
// `monospaced` (every face fixed-pitch), `weights`, `italic` (backlog F97)
// — a font picker's monospaced-first list without a file loaded or a glyph
// shaped.
// Rust: Core::system_fonts.
system_fonts :: proc(ui: ^Ui) -> (out: []System_Font) {
	total := int(c.system_fonts(ui, nil, 0))
	buf := make([]c.SystemFont, total, context.temp_allocator)
	n := min(int(c.system_fonts(ui, raw_data(buf), uint(total))), total)
	out = make([]System_Font, n, context.temp_allocator)
	for x, k in buf[:n] do out[k] = system_font_from_c(x)
	return
}

// Registers a font file by path.
// Rust: Core::load_font_file.
font_load_file :: proc(ui: ^Ui, path: string) -> Font {
	return Font(c.font_load_file(ui, path))
}

// Registers every font file in a directory.
// Rust: Core::load_fonts_dir.
font_load_dir :: proc(ui: ^Ui, dir: string) -> int {
	return int(c.font_load_dir(ui, dir))
}

// Scans the system's fonts again, so a font installed while the app runs is
// found (the scan is otherwise once a process); returns how many faces came
// and went.
// Rust: Core::reload_system_fonts.
font_reload_system :: proc(ui: ^Ui) -> int {
	return int(c.font_reload_system(ui))
}

// The fonts asked, in order, for a character the text's own family lacks,
// before the platform's fallback list (backlog F121).
// Rust: Core::set_fallback_fonts.
font_set_fallback :: proc(ui: ^Ui, ids: []Font) {
	c.font_set_fallback(ui, ([^]u64)(raw_data(ids)), uint(len(ids)))
}

// Drops a font.
// Rust: Core::remove_font.
font_remove :: proc(ui: ^Ui, id: Font) {
	c.font_remove(ui, u64(id))
}

// Registers RGBA pixels and mints an id for `<image src>`.
// Rust: SharedResources::add_image.
image_add :: proc(ui: ^Ui, w: u32, h: u32, rgba: []u8) -> Image {
	assert(rgba == nil || len(rgba) >= int(w) * int(h) * 4, "image_add: rgba holds fewer bytes than int(w) * int(h) * 4")
	return Image(c.image_add(ui, w, h, raw_data(rgba)))
}

// Drops an image; every window's atlas lets it go (backlog AR8).
// Rust: Core::remove_image.
image_remove :: proc(ui: ^Ui, id: Image) {
	c.image_remove(ui, u64(id))
}

// Replaces the pixels behind a live id, keeping the id (ADR 0025).
// Rust: Core::update_image.
image_update :: proc(ui: ^Ui, id: Image, w: u32, h: u32, rgba: []u8) {
	assert(rgba == nil || len(rgba) >= int(w) * int(h) * 4, "image_update: rgba holds fewer bytes than int(w) * int(h) * 4")
	c.image_update(ui, u64(id), w, h, raw_data(rgba))
}

// Registers a WGSL function and mints an id for `<fragment src>` (ADR 0015).
// Rust: Core::add_fragment.
fragment_add :: proc(ui: ^Ui, wgsl: string) -> Fragment {
	return Fragment(c.fragment_add(ui, wgsl))
}

// Drops a fragment; the renderer drops its pipelines (backlog AR8).
// Rust: Core::remove_fragment.
fragment_remove :: proc(ui: ^Ui, id: Fragment) {
	c.fragment_remove(ui, u64(id))
}

// The whole WGSL module behind a handle, which is what a renderer compiles.
// Rust: Core::fragment_module_source.
fragment_source :: proc(ui: ^Ui, id: Fragment) -> (out: string, ok: bool) #optional_ok {
	ok = c.fragment_source(ui, u64(id), &out)
	return
}

// Registers a sound's bytes and mints an id for `<audio src>`, `clickSound`
// and `play`.
// Rust: Core::add_sound.
sound_add :: proc(ui: ^Ui, data: []u8) -> Sound {
	return Sound(c.sound_add(ui, ([^]u8)(raw_data(data)), uint(len(data))))
}

// Drops a sound.
// Rust: Core::remove_sound.
sound_remove :: proc(ui: ^Ui, id: Sound) {
	c.sound_remove(ui, u64(id))
}

// Starts a playback of a registered sound, outside any node; answers the
// playback id.
// Rust: Ui::play.
play :: proc(ui: ^Ui, sound: Sound, opts: Maybe(Play) = nil, tag: any = nil) -> Playback {
	scratch: Scratch
	defer scratch_free(&scratch)
	opts_tmp: c.Play
	opts_c: ^c.Play
	if v, ok := opts.?; ok { opts_tmp = play_to_c(v, &scratch); opts_c = &opts_tmp }
	return Playback(c.play(ui, u64(sound), opts_c, to_value(tag)))
}

// Stops a playback, with an optional fade.
// Rust: Core::stop.
stop :: proc(ui: ^Ui, playback: Playback, fade_ms: f32) {
	c.stop(ui, u64(playback), fade_ms)
}

// A playback's volume, with an optional tween.
// Rust: Core::set_volume.
set_volume :: proc(ui: ^Ui, playback: Playback, volume: f32, tween_ms: f32) {
	c.set_volume(ui, u64(playback), volume, tween_ms)
}

// Pauses a playback.
// Rust: Core::pause.
pause :: proc(ui: ^Ui, playback: Playback, fade_ms: f32) {
	c.pause(ui, u64(playback), fade_ms)
}

// Resumes a paused playback.
// Rust: Core::resume.
resume :: proc(ui: ^Ui, playback: Playback, fade_ms: f32) {
	c.resume(ui, u64(playback), fade_ms)
}

// The device's master volume, with an optional tween.
// Rust: Core::set_master_volume.
set_master_volume :: proc(ui: ^Ui, volume: f32, tween_ms: f32) {
	c.set_master_volume(ui, volume, tween_ms)
}

// kui_audio (kui.h).
audio :: proc(ui: ^Ui, label: string, spec: Audio, tag: any = nil) -> u64 {
	scratch: Scratch
	defer scratch_free(&scratch)
	spec_c := audio_to_c(spec, &scratch)
	return c.audio(ui, label, &spec_c, to_value(tag))
}

// Drains what the frame asked of the audio device; a `KuiWindow`'s device is
// the runner's.
// Rust: Core::take_audio_commands.
take_audio_commands :: proc(ui: ^Ui) -> (out: []Audio_Command) {
	all := make([dynamic]c.AudioCommand, context.temp_allocator)
	chunk := make([]c.AudioCommand, 1024, context.temp_allocator)
	for {
		got := int(c.take_audio_commands(ui, raw_data(chunk[:]), len(chunk)))
		append(&all, ..chunk[:min(got, len(chunk))])
		if got < len(chunk) do break
	}
	buf := all[:]
	n := len(buf)
	out = make([]Audio_Command, n, context.temp_allocator)
	for x, k in buf[:n] do out[k] = audio_command_from_c(x)
	return
}

// The device reports a playback over.
// Rust: Core::audio_ended.
audio_ended :: proc(ui: ^Ui, playback: Playback) {
	c.audio_ended(ui, u64(playback))
}

// The device reports a stop that cut a playback short — a one-shot node's
// removal becomes `truncated-playback`.
// Rust: Core::audio_truncated.
audio_truncated :: proc(ui: ^Ui, playback: Playback, at: f64) {
	c.audio_truncated(ui, u64(playback), at)
}

// The device reports a play it would not take — a `refused` sound event and
// `playback-refused`.
// Rust: Core::audio_refused.
audio_refused :: proc(ui: ^Ui, playback: Playback) {
	c.audio_refused(ui, u64(playback))
}

