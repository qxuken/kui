// The palette in effect (`THEME_ROLES`).
// Rust: Ui::theme.
theme :: proc(ui: ^Ui) -> (out: Theme, ok: bool) #optional_ok {
	c_out := c.Theme{size = size_of(c.Theme)}
	ok = c.theme(ui, &c_out)
	out = theme_from_c(c_out)
	return
}

// Pins an accent and keeps the OS's base.
// Rust: Core::set_accent.
theme_set_accent :: proc(ui: ^Ui, accent: Color) {
	c.theme_set_accent(ui, accent)
}

// Pins a whole palette.
// Rust: Core::set_theme.
theme_set :: proc(ui: ^Ui, theme: Maybe(Theme) = nil) {
	scratch: Scratch
	defer scratch_free(&scratch)
	theme_tmp: c.Theme
	theme_c: ^c.Theme
	if v, ok := theme.?; ok { theme_tmp = theme_to_c(v, &scratch); theme_c = &theme_tmp }
	c.theme_set(ui, theme_c)
}

// The sizes in effect (`METRIC_ROLES`).
// Rust: Ui::metrics.
metrics :: proc(ui: ^Ui) -> (out: Metrics, ok: bool) #optional_ok {
	c_out := c.Metrics{size = size_of(c.Metrics)}
	ok = c.metrics(ui, &c_out)
	out = metrics_from_c(c_out)
	return
}

// Pins the stock widgets' sizes.
// Rust: Core::set_metrics.
metrics_set :: proc(ui: ^Ui, metrics: Maybe(Metrics) = nil) {
	scratch: Scratch
	defer scratch_free(&scratch)
	metrics_tmp: c.Metrics
	metrics_c: ^c.Metrics
	if v, ok := metrics.?; ok { metrics_tmp = metrics_to_c(v, &scratch); metrics_c = &metrics_tmp }
	c.metrics_set(ui, metrics_c)
}

// Declares the origin's colour and length tokens (ADR 0027).
// Rust: Ui::set_tokens.
tokens_set :: proc(ui: ^Ui, colors: []Color_Token, lengths: []Length_Token) {
	c.tokens_set(ui, ([^]c.ColorToken)(raw_data(colors)), uint(len(colors)), ([^]c.LengthToken)(raw_data(lengths)), uint(len(lengths)))
}

// kui_token_color (kui.h).
token_color :: proc(ui: ^Ui, name: string) -> (out: Color, ok: bool) #optional_ok {
	c_out: u32
	ok = c.token_color(ui, name, &c_out)
	out = c_out
	return
}

// kui_token_length (kui.h).
token_length :: proc(ui: ^Ui, name: string) -> (out: f32, ok: bool) #optional_ok {
	c_out: f32
	ok = c.token_length(ui, name, &c_out)
	out = c_out
	return
}

// Adds derived colours to the declared ones (ADR 0028).
// Rust: Tokens::derive.
tokens_derive :: proc(ui: ^Ui, derived: []Derived_Token) -> bool {
	scratch: Scratch
	defer scratch_free(&scratch)
	derived_c := make([]c.DerivedToken, len(derived), context.temp_allocator)
	for x, k in derived do derived_c[k] = derived_token_to_c(x, &scratch)
	return c.tokens_derive(ui, raw_data(derived_c), uint(len(derived)))
}

// The clock the tweens read; a window's runner sets it from the display.
// Rust: Core::set_time.
set_time :: proc(ui: ^Ui, now_secs: f64) {
	c.set_time(ui, now_secs)
}

// The frame clock in seconds, the one the tweens read: what a view times its
// own deadlines by.
// Rust: Ui::now.
now :: proc(ui: ^Ui) -> f64 {
	return c.now(ui)
}

// Asks for a frame at a time on the frame clock — a toast's expiry, a
// sequence's beat — with nothing owed until then.
// Rust: Ui::request_frame_at.
request_frame_at :: proc(ui: ^Ui, at: f64) {
	c.request_frame_at(ui, at)
}

// The time a driver should next draw at for a frame asked at a time; infinity
// in C and Odin, null in Node, for none.
// Rust: Core::next_frame_at.
next_frame_at :: proc(ui: ^Ui) -> f64 {
	return c.next_frame_at(ui)
}

// Whether the last frame left a transition mid-flight, so the host draws
// another without waiting for input.
// Rust: Core::animating.
animating :: proc(ui: ^Ui) -> bool {
	return c.animating(ui)
}

// The same by kind — a finite transition, a keyframe cycle, a departing
// ghost, a requested frame, an autoscroll — so a test can wait for the
// transitions to run out under a cycle that never ends; Node's loop has
// `quiet()` for that wait (backlog F64).
// Rust: Core::owed.
owed :: proc(ui: ^Ui) -> Owed {
	return transmute(Owed)c.owed(ui)
}

// Turns on the trace of why frames run: who holds an owed frame, and whether
// a frame changed what is drawn (backlog F111).
// Rust: Core::set_frame_trace.
set_frame_trace :: proc(ui: ^Ui, on: bool) {
	c.set_frame_trace(ui, on)
}

// Why the frame being built runs: the input it answers by kind, what the
// driver noted, and `owed` after a frame that owed one (backlog F111).
// Rust: Core::frame_cause.
frame_cause :: proc(ui: ^Ui) -> Frame_Causes {
	return transmute(Frame_Causes)c.frame_cause(ui)
}

// A driver adds a reason the core cannot see — a wake, a resize, a blink, a
// retry — to the next frame's (backlog F111).
// Rust: Core::note_frame_cause.
note_frame_cause :: proc(ui: ^Ui, cause: Frame_Causes) {
	c.note_frame_cause(ui, transmute(u32)cause)
}

// Whether the last finished frame drew exactly what the one before drew,
// traced (backlog F111).
// Rust: Core::frame_unchanged.
frame_unchanged :: proc(ui: ^Ui) -> i32 {
	return c.frame_unchanged(ui)
}

// LCD subpixel coverage for outline glyphs, for a renderer that blends per
