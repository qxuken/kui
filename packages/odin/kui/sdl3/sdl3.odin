// SDL3's keys as kui's (backlog F239). Generated by `cargo run -p kui-devtools --bin keytables` from the table in
// examples/devtools/src/bin/keytables.rs; edit the table, not this file.
//
// A package of its own, so importing kui links no SDL:
//
//     import kui_sdl3 "kui/sdl3"
//     sdl.StartTextInput(window)
//     #partial switch ev.type {
//     case .KEY_DOWN, .KEY_UP: kui_sdl3.on_key(ui, &ev.key)
//     case .TEXT_INPUT: kui_sdl3.on_text(ui, &ev.text)
//     }
//
// SDL names a key by its place on a US keyboard (its scancode), which is
// kui's `physical`; `code` is what the layout makes of it (the event's
// keycode), a letter upper-cased under Shift or Caps Lock. A named key
// (the arrows, Enter, Tab, Escape, F5) goes through kui.input_press, so it
// means what it means; a key that types (a character, Space) goes through
// kui.input_key_down, the raw half a key sink and an editor's chords read,
// and what it types arrives once, from TEXT_INPUT, as kui.input_text.
// kui.input_modifiers follows every key.
package kui_sdl3

import "core:unicode/utf8"
import sdl "vendor:sdl3"
import kui ".."

// kui's name for the key at scancode `sc`'s place and where it sits; ""
// for a key kui names none for.
physical :: proc(sc: sdl.Scancode) -> (name: string, location: kui.Key_Location) {
	#partial switch sc {
	case .A: return "a", .Standard
	case .B: return "b", .Standard
	case .C: return "c", .Standard
	case .D: return "d", .Standard
	case .E: return "e", .Standard
	case .F: return "f", .Standard
	case .G: return "g", .Standard
	case .H: return "h", .Standard
	case .I: return "i", .Standard
	case .J: return "j", .Standard
	case .K: return "k", .Standard
	case .L: return "l", .Standard
	case .M: return "m", .Standard
	case .N: return "n", .Standard
	case .O: return "o", .Standard
	case .P: return "p", .Standard
	case .Q: return "q", .Standard
	case .R: return "r", .Standard
	case .S: return "s", .Standard
	case .T: return "t", .Standard
	case .U: return "u", .Standard
	case .V: return "v", .Standard
	case .W: return "w", .Standard
	case .X: return "x", .Standard
	case .Y: return "y", .Standard
	case .Z: return "z", .Standard
	case ._0: return "0", .Standard
	case ._1: return "1", .Standard
	case ._2: return "2", .Standard
	case ._3: return "3", .Standard
	case ._4: return "4", .Standard
	case ._5: return "5", .Standard
	case ._6: return "6", .Standard
	case ._7: return "7", .Standard
	case ._8: return "8", .Standard
	case ._9: return "9", .Standard
	case .SPACE: return "space", .Standard
	case .APOSTROPHE: return "'", .Standard
	case .COMMA: return ",", .Standard
	case .MINUS: return "-", .Standard
	case .PERIOD: return ".", .Standard
	case .SLASH: return "/", .Standard
	case .SEMICOLON: return ";", .Standard
	case .EQUALS: return "=", .Standard
	case .LEFTBRACKET: return "[", .Standard
	case .BACKSLASH: return "\\", .Standard
	case .RIGHTBRACKET: return "]", .Standard
	case .GRAVE: return "`", .Standard
	case .ESCAPE: return "escape", .Standard
	case .RETURN: return "enter", .Standard
	case .TAB: return "tab", .Standard
	case .BACKSPACE: return "backspace", .Standard
	case .INSERT: return "insert", .Standard
	case .DELETE: return "delete", .Standard
	case .RIGHT: return "right", .Standard
	case .LEFT: return "left", .Standard
	case .DOWN: return "down", .Standard
	case .UP: return "up", .Standard
	case .PAGEUP: return "pageup", .Standard
	case .PAGEDOWN: return "pagedown", .Standard
	case .HOME: return "home", .Standard
	case .END: return "end", .Standard
	case .CAPSLOCK: return "capslock", .Standard
	case .SCROLLLOCK: return "scrolllock", .Standard
	case .NUMLOCKCLEAR: return "numlock", .Standard
	case .PRINTSCREEN: return "printscreen", .Standard
	case .PAUSE: return "pause", .Standard
	case .APPLICATION: return "menu", .Standard
	case .F1: return "f1", .Standard
	case .F2: return "f2", .Standard
	case .F3: return "f3", .Standard
	case .F4: return "f4", .Standard
	case .F5: return "f5", .Standard
	case .F6: return "f6", .Standard
	case .F7: return "f7", .Standard
	case .F8: return "f8", .Standard
	case .F9: return "f9", .Standard
	case .F10: return "f10", .Standard
	case .F11: return "f11", .Standard
	case .F12: return "f12", .Standard
	case .F13: return "f13", .Standard
	case .F14: return "f14", .Standard
	case .F15: return "f15", .Standard
	case .F16: return "f16", .Standard
	case .F17: return "f17", .Standard
	case .F18: return "f18", .Standard
	case .F19: return "f19", .Standard
	case .F20: return "f20", .Standard
	case .F21: return "f21", .Standard
	case .F22: return "f22", .Standard
	case .F23: return "f23", .Standard
	case .F24: return "f24", .Standard
	case .KP_0: return "0", .Numpad
	case .KP_1: return "1", .Numpad
	case .KP_2: return "2", .Numpad
	case .KP_3: return "3", .Numpad
	case .KP_4: return "4", .Numpad
	case .KP_5: return "5", .Numpad
	case .KP_6: return "6", .Numpad
	case .KP_7: return "7", .Numpad
	case .KP_8: return "8", .Numpad
	case .KP_9: return "9", .Numpad
	case .KP_PERIOD: return ".", .Numpad
	case .KP_DIVIDE: return "/", .Numpad
	case .KP_MULTIPLY: return "*", .Numpad
	case .KP_MINUS: return "-", .Numpad
	case .KP_PLUS: return "+", .Numpad
	case .KP_ENTER: return "enter", .Numpad
	case .KP_EQUALS: return "=", .Numpad
	case .LSHIFT: return "shift", .Left
	case .RSHIFT: return "shift", .Right
	case .LCTRL: return "ctrl", .Left
	case .RCTRL: return "ctrl", .Right
	case .LALT: return "alt", .Left
	case .RALT: return "alt", .Right
	case .LGUI: return "super", .Left
	case .RGUI: return "super", .Right
	case .MENU: return "menu", .Standard
	case .CLEAR: return "clear", .Standard
	case .MUTE: return "volumemute", .Standard
	case .VOLUMEUP: return "volumeup", .Standard
	case .VOLUMEDOWN: return "volumedown", .Standard
	case .MEDIA_PLAY: return "mediaplay", .Standard
	case .MEDIA_PAUSE: return "mediapause", .Standard
	case .MEDIA_RECORD: return "mediarecord", .Standard
	case .MEDIA_FAST_FORWARD: return "mediafastforward", .Standard
	case .MEDIA_REWIND: return "mediarewind", .Standard
	case .MEDIA_NEXT_TRACK: return "medianext", .Standard
	case .MEDIA_PREVIOUS_TRACK: return "mediaprev", .Standard
	case .MEDIA_STOP: return "mediastop", .Standard
	case .MEDIA_PLAY_PAUSE: return "mediaplaypause", .Standard
	}
	return "", .Standard
}

// SDL's modifier state as kui's.
key_mods :: proc(mod: sdl.Keymod) -> kui.Key_Mods {
	return kui.Key_Mods {
		shift = mod & sdl.KMOD_SHIFT != {},
		ctrl = mod & sdl.KMOD_CTRL != {},
		alt = mod & sdl.KMOD_ALT != {},
		super = mod & sdl.KMOD_GUI != {},
		caps_lock = .CAPS in mod,
		num_lock = .NUM in mod,
	}
}

// An SDL KEY_DOWN or KEY_UP, into kui.
on_key :: proc(ui: ^kui.Ui, e: ^sdl.KeyboardEvent) {
	phys, location := physical(e.scancode)
	if phys == "" do return
	km := key_mods(e.mod)
	held: kui.Mods
	if km.shift do held += {.Shift}
	if km.ctrl do held += {.Ctrl}
	if km.alt do held += {.Alt}
	if km.super do held += {.Super}
	kui.input_modifiers(ui, held)
	km.location = location
	types := len(phys) == 1 || phys == "space"
	code := phys
	buf: [4]u8
	k := u32(e.key)
	if k & u32(sdl.K_SCANCODE_MASK) == 0 && k > 0x20 && k != 0x7f && k < 0x110000 {
		// The layout's character.
		bytes, n := utf8.encode_rune(rune(k))
		buf = bytes
		code = string(buf[:n])
		types = true
	}
	if km.shift != km.caps_lock && len(code) == 1 && code[0] >= 'a' && code[0] <= 'z' {
		buf[0] = code[0] - 32
		code = string(buf[:1])
	}
	switch {
	case !e.down:
		kui.input_release(ui, code, phys, km)
	case types:
		kui.input_key_down(ui, code, phys, km, "", e.repeat)
	case:
		kui.input_press(ui, code, phys, km, "", e.repeat)
	}
}

// An SDL TEXT_INPUT, into kui as typed text.
on_text :: proc(ui: ^kui.Ui, e: ^sdl.TextInputEvent) {
	if e.text != nil do kui.input_text(ui, string(e.text))
}
