{
  "name": "@qxuken/kui",
  "version": "0.1.0-alpha.43",
  "description": "kui for Node: JSX views lowered into the kui IR, Elm-style messages as data",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qxuken/kui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./jsx-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./jsx-runtime.d.ts",
      "default": "./jsx-dev-runtime.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "jsx-runtime.js",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.js",
    "encoder.js",
    "native.cjs",
    "prebuilds/",
    "props.md",
    "howto.md",
    "CHANGELOG.md",
    "docs/adr/"
  ],
  "scripts": {
    "build:native": "cargo build -p kui-node --release",
    "gen": "node gen-types.mjs",
    "prepack": "node prepack.mjs",
    "test": "node --test test.mjs"
  }
}
