{
  "name": "kui-node-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild apps/*.tsx features/*.tsx widgets/*.tsx tools/*.tsx --bundle --packages=external --jsx=automatic --jsx-import-source=@qxuken/kui --format=esm --platform=node --outdir=dist --outbase=. --out-extension:.js=.mjs",
    "counter": "npm run build && node dist/apps/counter.mjs",
    "window": "npm run build && node dist/features/window.mjs",
    "slide": "npm run build && node dist/features/slide.mjs",
    "clipboard": "npm run build && node dist/features/clipboard.mjs",
    "virtual_list": "npm run build && node dist/widgets/virtual_list.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node tools/smoke.mjs",
    "bench": "node tools/bench.mjs"
  },
  "kui": {
    "windowed": ["apps/counter", "features/window", "features/slide", "features/clipboard", "widgets/virtual_list"],
    "headless": ["apps/counter", "features/slide", "features/clipboard", "widgets/virtual_list", "tools/types"]
  },
  "dependencies": {
    "@qxuken/kui": "file:../../packages/kui"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
