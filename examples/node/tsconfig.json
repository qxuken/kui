{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "jsxImportSource": "@qxuken/kui",
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.tsx",
    "*.ts",
    "apps/*.tsx",
    "features/*.tsx",
    "widgets/*.tsx",
    "tools/*.tsx"
  ]
}
