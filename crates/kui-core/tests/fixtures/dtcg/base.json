{
  "space": {
    "$type": "dimension",
    "gap": { "$value": { "value": 8, "unit": "px" } },
    "gutter": { "$value": { "value": 1, "unit": "rem" } }
  },
  "font": { "code": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "mono"] } },
  "shadow": { "card": { "$type": "shadow", "$value": { "color": "#000000", "offsetX": { "value": 0, "unit": "px" } } } }
}
