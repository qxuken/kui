// panel with your children: `children` builds the group it asks for.
panel_with :: proc(ui: ^kui.Ui, p: Panel, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := panel_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/panel"), props, call, &b)
}

