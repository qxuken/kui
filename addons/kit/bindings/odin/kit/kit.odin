}

// A menu row.
Item :: struct {
	// What `choose` carries.
	value: string,
	// What it reads as.
	label: string,
	// The chord beside it, as text: `⌘K`.
	shortcut: string,
	// Shown, not choosable.
	disabled: Maybe(bool),
	// A destructive action, drawn as one.
	danger: Maybe(bool),
}

@(private)
item_value :: proc(p: Item) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	c.value_map_set(m, "label", c.value_str(p.label))
	if p.shortcut != "" do c.value_map_set(m, "shortcut", c.value_str(p.shortcut))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.danger.?; ok do c.value_map_set(m, "danger", c.value_bool(x))
	return m
}

// One item of a checklist.
Check :: struct {
	// What it says; its name.
	label: string,
	// Ticked.
	checked: bool,
	// Shown, not tickable.
	disabled: Maybe(bool),
}

@(private)
check_value :: proc(p: Check) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "label", c.value_str(p.label))
	c.value_map_set(m, "checked", c.value_bool(p.checked))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	return m
}

// One row of an inspector: a key and its value.
Entry :: struct {
	// The field's name.
