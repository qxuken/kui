// A button. Space, Enter and assistive technology press it as a click does.
Button :: struct {
	// The text on it; its accessible name unless `name` says more.
	label: string,
	// Its accessible name when that says more than the label; start it with the
	// label's words (Clear → Clear the selection).
	name: string,
	// Default when left out.
	variant: Maybe(Variant),
	// An icon's name before the label (Kit's icon set).
	icon: string,
	// The chord, shown faintly after the label: `⌘R`.
	shortcut: string,
	// Drawn and read as unavailable; presses nothing.
	disabled: Maybe(bool),
	// A toggle that is on (a panel shown): drawn selected and read as such.
	pressed: Maybe(bool),
	// A hint under the pointer — why it is disabled, say.
	tooltip: string,
	// The message `press` arrives as. Pressed.
	on_press: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `press` carries: Pressed.
Button_Press :: struct {
}

// Embed with `using _:` in the message passed as `on_press`.
With_Button_Press :: struct {
	press: Button_Press,
}

@(private)
button_props :: proc(p: Button) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "label", c.value_str(p.label))
	if p.name != "" do c.value_map_set(m, "name", c.value_str(p.name))
	if x, ok := p.variant.?; ok do c.value_map_set(m, "variant", c.value_str(VARIANT_NAMES[x]))
	if p.icon != "" do c.value_map_set(m, "icon", c.value_str(p.icon))
	if p.shortcut != "" do c.value_map_set(m, "shortcut", c.value_str(p.shortcut))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.pressed.?; ok do c.value_map_set(m, "pressed", c.value_bool(x))
	if p.tooltip != "" do c.value_map_set(m, "tooltip", c.value_str(p.tooltip))
	if p.on_press != nil do c.value_map_set(m, "on_press", (^c.Value)(kui.encode(p.on_press)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

button :: proc(ui: ^kui.Ui, p: Button) -> i32 {
	return button_in(ui, NAMESPACE, p)
}

button_in :: proc(ui: ^kui.Ui, namespace: string, p: Button) -> i32 {
	props := button_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/button")
	return c.component(ui, name, props, nil, nil)
}

// A square button holding an icon.
IconButton :: struct {
	// The icon's name (Kit's icon set).
	icon: string,
	// What it does: its accessible name and its tooltip.
	label: string,
	// Ghost when left out.
	variant: Maybe(Variant),
	// Unavailable.
	disabled: Maybe(bool),
	// A toggle that is on: drawn selected and read as such.
	pressed: Maybe(bool),
	// The hint under the pointer; the label when left out.
	tooltip: string,
	// The message `press` arrives as. Pressed.
	on_press: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `press` carries: Pressed.
IconButton_Press :: struct {
}

// Embed with `using _:` in the message passed as `on_press`.
With_IconButton_Press :: struct {
	press: IconButton_Press,
}

@(private)
icon_button_props :: proc(p: IconButton) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "icon", c.value_str(p.icon))
	c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.variant.?; ok do c.value_map_set(m, "variant", c.value_str(VARIANT_NAMES[x]))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.pressed.?; ok do c.value_map_set(m, "pressed", c.value_bool(x))
	if p.tooltip != "" do c.value_map_set(m, "tooltip", c.value_str(p.tooltip))
	if p.on_press != nil do c.value_map_set(m, "on_press", (^c.Value)(kui.encode(p.on_press)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

icon_button :: proc(ui: ^kui.Ui, p: IconButton) -> i32 {
	return icon_button_in(ui, NAMESPACE, p)
}

icon_button_in :: proc(ui: ^kui.Ui, namespace: string, p: IconButton) -> i32 {
	props := icon_button_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/icon_button")
	return c.component(ui, name, props, nil, nil)
}

// A one-line text field, the skin's field style (an underline in Ledger).
TextField :: struct {
	// Its text: yours to keep, from `change`.
	value: string,
	// Its label, above it; its name.
	label: string,
	// The label names the field but is not drawn: a field whose place says what it
	// is.
	hide_label: Maybe(bool),
	// Shown while it is empty.
	placeholder: string,
	// In the data face.
	mono: Maybe(bool),
	// Unavailable.
	disabled: Maybe(bool),
	// Its width in px; grows when left out.
	width: Maybe(f64),
	// Takes the keyboard each time this number changes while the field is on
	// screen: keep a counter in your model and bump it (⌘F). A field that shows
	// after the bump takes its number as where it starts.
	focus: Maybe(i64),
	// Takes the keyboard as it first shows: a new item's name.
	autofocus: Maybe(bool),
	// What is wrong with the text: drawn at the end of the field in the danger
	// colour (cut short past half its width, the whole message its tooltip), its
	// edge in danger too, and read after its name. It takes no room of its own, so
	// a field in a toolbar keeps its height. An empty string marks the field only,
	// for fields that share one message.
	error: string,
	// A Choose… button after the field that opens the system's folder, open or
	// save dialog; the path picked arrives as `change`, as if typed. Cancelled,
	// nothing changes. The dialog starts in the field's folder when its text is an
	// absolute path.
	browse: Maybe(Browse),
	// The button's label; Choose… when left out.
	browse_label: string,
	// The message `change` arrives as. The text changed, or a path was picked.
	on_change: any,
	// The message `submit` arrives as. Enter.
	on_submit: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `change` carries: The text changed, or a path was picked.
TextField_Change :: struct {
	// The whole text.
	text: string,
}

// Embed with `using _:` in the message passed as `on_change`.
With_TextField_Change :: struct {
	change: TextField_Change,
}

// What `submit` carries: Enter.
TextField_Submit :: struct {
	// The whole text.
	text: string,
}

// Embed with `using _:` in the message passed as `on_submit`.
With_TextField_Submit :: struct {
	submit: TextField_Submit,
}

@(private)
text_field_props :: proc(p: TextField) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	if p.label != "" do c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.hide_label.?; ok do c.value_map_set(m, "hide_label", c.value_bool(x))
	if p.placeholder != "" do c.value_map_set(m, "placeholder", c.value_str(p.placeholder))
	if x, ok := p.mono.?; ok do c.value_map_set(m, "mono", c.value_bool(x))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if x, ok := p.focus.?; ok do c.value_map_set(m, "focus", c.value_int(x))
	if x, ok := p.autofocus.?; ok do c.value_map_set(m, "autofocus", c.value_bool(x))
	if p.error != "" do c.value_map_set(m, "error", c.value_str(p.error))
	if x, ok := p.browse.?; ok do c.value_map_set(m, "browse", c.value_str(BROWSE_NAMES[x]))
	if p.browse_label != "" do c.value_map_set(m, "browse_label", c.value_str(p.browse_label))
	if p.on_change != nil do c.value_map_set(m, "on_change", (^c.Value)(kui.encode(p.on_change)))
	if p.on_submit != nil do c.value_map_set(m, "on_submit", (^c.Value)(kui.encode(p.on_submit)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

text_field :: proc(ui: ^kui.Ui, p: TextField) -> i32 {
	return text_field_in(ui, NAMESPACE, p)
}

text_field_in :: proc(ui: ^kui.Ui, namespace: string, p: TextField) -> i32 {
	props := text_field_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/text_field")
	return c.component(ui, name, props, nil, nil)
}

// A text field of several lines, in a well in every skin: a note, a request
// body.
TextArea :: struct {
	// Its text: yours to keep, from `change`.
	value: string,
	// Its label, above it; its name.
	label: string,
	// The label names the field but is not drawn.
	hide_label: Maybe(bool),
	// Shown while it is empty.
	placeholder: string,
	// In the data face: code, JSON.
	mono: Maybe(bool),
	// Unavailable.
	disabled: Maybe(bool),
	// Its width in px; grows when left out.
	width: Maybe(f64),
	// Lines tall at the least; 4 when left out. It grows with its text.
	rows: Maybe(i64),
	// Lines tall at the most, scrolling past them; no limit when left out.
	max_rows: Maybe(i64),
	// Takes the room its parent leaves (a request body filling its tab), `rows`
	// still its least.
	grow: Maybe(bool),
	// Takes the keyboard each time this number changes while it is on screen.
	focus: Maybe(i64),
	// Takes the keyboard as it first shows.
	autofocus: Maybe(bool),
	// What is wrong with the text, under it in the danger colour.
	error: string,
	// Tab and Shift+Tab move the keyboard to the next or the last control, as from
	// a one-line field: a note, a comment. Left out, Tab types indentation as a
	// code editor's does, and the ways out are Escape then Tab, or Ctrl+M
	// (Ctrl+Shift+M on macOS).
	tab_moves_focus: Maybe(bool),
	// The message `change` arrives as. The text changed.
	on_change: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `change` carries: The text changed.
TextArea_Change :: struct {
	// The whole text.
	text: string,
}

// Embed with `using _:` in the message passed as `on_change`.
With_TextArea_Change :: struct {
	change: TextArea_Change,
}

@(private)
text_area_props :: proc(p: TextArea) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	if p.label != "" do c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.hide_label.?; ok do c.value_map_set(m, "hide_label", c.value_bool(x))
	if p.placeholder != "" do c.value_map_set(m, "placeholder", c.value_str(p.placeholder))
	if x, ok := p.mono.?; ok do c.value_map_set(m, "mono", c.value_bool(x))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if x, ok := p.rows.?; ok do c.value_map_set(m, "rows", c.value_int(x))
	if x, ok := p.max_rows.?; ok do c.value_map_set(m, "max_rows", c.value_int(x))
	if x, ok := p.grow.?; ok do c.value_map_set(m, "grow", c.value_bool(x))
	if x, ok := p.focus.?; ok do c.value_map_set(m, "focus", c.value_int(x))
	if x, ok := p.autofocus.?; ok do c.value_map_set(m, "autofocus", c.value_bool(x))
	if p.error != "" do c.value_map_set(m, "error", c.value_str(p.error))
	if x, ok := p.tab_moves_focus.?; ok do c.value_map_set(m, "tab_moves_focus", c.value_bool(x))
	if p.on_change != nil do c.value_map_set(m, "on_change", (^c.Value)(kui.encode(p.on_change)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

text_area :: proc(ui: ^kui.Ui, p: TextArea) -> i32 {
	return text_area_in(ui, NAMESPACE, p)
}

text_area_in :: proc(ui: ^kui.Ui, namespace: string, p: TextArea) -> i32 {
	props := text_area_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/text_area")
	return c.component(ui, name, props, nil, nil)
}

// A search field: a glass, the query, and a clear button while it has one.
Search :: struct {
	// The query: yours to keep.
