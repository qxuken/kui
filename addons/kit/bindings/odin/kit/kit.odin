// A trace waterfall: spans as bars on a time axis, nested by depth, coloured by
// group, zoomed and panned by the wheel and a drag.
Waterfall :: struct {
	// The spans: fields `name`, `start`, `len` (ms), `depth`, `group`, and
	// `target` (a label).
	bars: ^c.Channel,
	// Points in time, fields `at` and `label`: a navigation, a paint.
	marks: ^c.Channel,
	// The window's start in ms: yours to keep, from `zoom`.
	start: Maybe(f64),
	// The window's length in ms; the whole trace when left out.
	length: Maybe(f64),
	// The selected span (its row).
	selected: Maybe(i64),
	// Takes the room its parent leaves.
	grow: Maybe(bool),
	// The message `select` arrives as. A span was clicked.
	on_select: any,
	// The message `zoom` arrives as. The wheel or a drag asks for another window.
	on_zoom: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `select` carries: A span was clicked.
Waterfall_Select :: struct {
	// Its row.
	row: i64,
}

// Embed with `using _:` in the message passed as `on_select`.
With_Waterfall_Select :: struct {
	select: Waterfall_Select,
}

// What `zoom` carries: The wheel or a drag asks for another window.
Waterfall_Zoom :: struct {
	// Its start in ms.
	start: f64,
	// Its length in ms.
	length: f64,
}

// Embed with `using _:` in the message passed as `on_zoom`.
With_Waterfall_Zoom :: struct {
	zoom: Waterfall_Zoom,
}

@(private)
waterfall_props :: proc(p: Waterfall) -> ^c.Value {
	m := c.value_map()
	if p.bars != nil do c.value_map_set(m, "bars", c.channel_handle(p.bars))
	if p.marks != nil do c.value_map_set(m, "marks", c.channel_handle(p.marks))
	if x, ok := p.start.?; ok do c.value_map_set(m, "start", c.value_float(x))
	if x, ok := p.length.?; ok do c.value_map_set(m, "length", c.value_float(x))
	if x, ok := p.selected.?; ok do c.value_map_set(m, "selected", c.value_int(x))
	if x, ok := p.grow.?; ok do c.value_map_set(m, "grow", c.value_bool(x))
	if p.on_select != nil do c.value_map_set(m, "on_select", (^c.Value)(kui.encode(p.on_select)))
	if p.on_zoom != nil do c.value_map_set(m, "on_zoom", (^c.Value)(kui.encode(p.on_zoom)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

waterfall :: proc(ui: ^kui.Ui, p: Waterfall) -> i32 {
	return waterfall_in(ui, NAMESPACE, p)
}

waterfall_in :: proc(ui: ^kui.Ui, namespace: string, p: Waterfall) -> i32 {
	props := waterfall_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/waterfall")
	return c.component(ui, name, props, nil, nil)
}

