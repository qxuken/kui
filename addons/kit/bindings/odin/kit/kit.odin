// Two panes and a draggable rule between them.
Split :: struct {
	// Side by side (row, the default) or stacked.
	axis: Maybe(Axis),
	// How much of the room the first pane takes, 0 to 1: yours to keep and pass
	// back.
	fraction: f64,
	// The least either pane is, in px; 80 when left out.
	min: Maybe(f64),
	// The message `resize` arrives as. The rule was dragged: the fraction it asks
	// for.
	on_resize: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `resize` carries: The rule was dragged: the fraction it asks for.
Split_Resize :: struct {
	// 0 to 1.
	fraction: f64,
}

// Embed with `using _:` in the message passed as `on_resize`.
With_Split_Resize :: struct {
	resize: Split_Resize,
}

@(private)
split_props :: proc(p: Split) -> ^c.Value {
	m := c.value_map()
	if x, ok := p.axis.?; ok do c.value_map_set(m, "axis", c.value_str(AXIS_NAMES[x]))
	c.value_map_set(m, "fraction", c.value_float(p.fraction))
	if x, ok := p.min.?; ok do c.value_map_set(m, "min", c.value_float(x))
	if p.on_resize != nil do c.value_map_set(m, "on_resize", (^c.Value)(kui.encode(p.on_resize)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

split :: proc(ui: ^kui.Ui, p: Split) -> i32 {
