// Generated by kui-addon-schema from kit's schema.lua (ADR 0066); do not edit.
// Kit: a UI kit for kui, tuned for dense tool UIs — inputs, data views,
// overlays, layout, charts and a trace waterfall, drawn by a skin (Ledger,
// Phosphor, Neutral) the host picks.
package kit

import "base:runtime"
import "core:strings"
import kui "../../../../../packages/odin/kui"
import c "../../../../../packages/odin/kui/c"

// The namespace the components are placed under; the `_in` procedures
// take another, for kit loaded twice.
NAMESPACE :: "kit"

@(private)
kit_list :: proc(xs: $T/[]$E, f: proc(x: E) -> ^c.Value) -> ^c.Value {
	l := c.value_list()
	for x in xs do c.value_list_push(l, f(x))
	return l
}

// What a `_with` procedure's callback runs its children under.
@(private)
Body_Context :: runtime.Context

@(private)
concat :: proc(a, b: string) -> string {
	return strings.concatenate({a, b}, context.temp_allocator)
}

// How loud a control is.
Variant :: enum {
	Default,
	Primary,
	Ghost,
	Danger,
}

@(private)
VARIANT_NAMES := [Variant]string {
	.Default = "default",
	.Primary = "primary",
	.Ghost = "ghost",
	.Danger = "danger",
}

// What a badge, a stat or a toast is about.
Tone :: enum {
	Neutral,
	Accent,
	Ok,
	Warn,
	Danger,
}

@(private)
TONE_NAMES := [Tone]string {
	.Neutral = "neutral",
	.Accent = "accent",
	.Ok = "ok",
	.Warn = "warn",
	.Danger = "danger",
}

// Where a cell's content sits.
Align :: enum {
	Start,
	Center,
	End,
}

@(private)
ALIGN_NAMES := [Align]string {
	.Start = "start",
	.Center = "center",
	.End = "end",
}

// Which way a split divides.
Axis :: enum {
	Row,
	Column,
}

@(private)
AXIS_NAMES := [Axis]string {
	.Row = "row",
	.Column = "column",
}

// The look: Ledger's paper and ink, Phosphor's terminal, or Neutral's quiet
// chrome.
Skin :: enum {
	Ledger,
	Phosphor,
	Neutral,
}

@(private)
SKIN_NAMES := [Skin]string {
	.Ledger = "ledger",
	.Phosphor = "phosphor",
	.Neutral = "neutral",
}

// Row and control heights: 22 and 26 px, or 20 and 22 px compact.
Density :: enum {
	Comfortable,
	Compact,
}

@(private)
DENSITY_NAMES := [Density]string {
	.Comfortable = "comfortable",
	.Compact = "compact",
}

// A log line's level.
Level :: enum {
	Debug,
	Info,
	Warn,
	Error,
}

@(private)
LEVEL_NAMES := [Level]string {
	.Debug = "debug",
	.Info = "info",
	.Warn = "warn",
	.Error = "error",
}

// A choice: what it is, and what it reads as.
Choice :: struct {
	// What the choice is; what the event carries.
	value: string,
	// What it reads as.
	label: string,
	// Shown, not choosable.
	disabled: Maybe(bool),
}

@(private)
choice_value :: proc(p: Choice) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	return m
}

// A table's column: which field of the channel it shows, and how.
Column :: struct {
	// The channel column it reads.
	field: string,
	// Its header.
	title: string,
	// Its width in px; shares the rest when left out.
	width: Maybe(f64),
	// Where its cells sit; numbers read best at the end.
	align: Maybe(Align),
	// Its cells in the data face: ids, timings, hashes.
	mono: Maybe(bool),
}

@(private)
column_value :: proc(p: Column) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "field", c.value_str(p.field))
	c.value_map_set(m, "title", c.value_str(p.title))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if x, ok := p.align.?; ok do c.value_map_set(m, "align", c.value_str(ALIGN_NAMES[x]))
	if x, ok := p.mono.?; ok do c.value_map_set(m, "mono", c.value_bool(x))
	return m
}

// A tab: its value and its label.
Tab :: struct {
	// What it is; what `change` carries.
	value: string,
	// What it reads as.
	label: string,
	// A count beside the label.
	count: Maybe(i64),
}

@(private)
tab_value :: proc(p: Tab) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.count.?; ok do c.value_map_set(m, "count", c.value_int(x))
	return m
}

// A menu row.
Item :: struct {
	// What `choose` carries.
	value: string,
	// What it reads as.
	label: string,
	// The chord beside it, as text: `⌘K`.
	shortcut: string,
	// Shown, not choosable.
	disabled: Maybe(bool),
	// A destructive action, drawn as one.
	danger: Maybe(bool),
}

@(private)
item_value :: proc(p: Item) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	c.value_map_set(m, "label", c.value_str(p.label))
	if p.shortcut != "" do c.value_map_set(m, "shortcut", c.value_str(p.shortcut))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.danger.?; ok do c.value_map_set(m, "danger", c.value_bool(x))
	return m
}

// One row of an inspector: a key and its value.
Entry :: struct {
