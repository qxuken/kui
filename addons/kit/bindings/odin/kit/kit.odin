// Two panes and a draggable rule between them.
Split :: struct {
	// Side by side (row, the default) or stacked.
	axis: Maybe(Axis),
	// How much of the room the first pane takes, 0 to 1: yours to keep and pass
	// back.
	fraction: f64,
	// The least either pane is, in px; 80 when left out.
	min: Maybe(f64),
	// The message `resize` arrives as. The rule was dragged: the fraction it asks
	// for.
	on_resize: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `resize` carries: The rule was dragged: the fraction it asks for.
Split_Resize :: struct {
	// 0 to 1.
	fraction: f64,
}

// Embed with `using _:` in the message passed as `on_resize`.
With_Split_Resize :: struct {
	resize: Split_Resize,
}

@(private)
split_props :: proc(p: Split) -> ^c.Value {
	m := c.value_map()
	if x, ok := p.axis.?; ok do c.value_map_set(m, "axis", c.value_str(AXIS_NAMES[x]))
	c.value_map_set(m, "fraction", c.value_float(p.fraction))
	if x, ok := p.min.?; ok do c.value_map_set(m, "min", c.value_float(x))
	if p.on_resize != nil do c.value_map_set(m, "on_resize", (^c.Value)(kui.encode(p.on_resize)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

split :: proc(ui: ^kui.Ui, p: Split) -> i32 {
	return split_in(ui, NAMESPACE, p)
}

split_in :: proc(ui: ^kui.Ui, namespace: string, p: Split) -> i32 {
	props := split_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/split")
	return c.component(ui, name, props, nil, nil)
}

// split with your children: `children` builds the group it asks for.
split_with :: proc(ui: ^kui.Ui, p: Split, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := split_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/split"), props, call, &b)
}

// A strip of tabs over the body of the one chosen.
Tabs :: struct {
	// The tabs, in order.
	tabs: []Tab,
	// The one shown: yours to keep.
	value: string,
	// The message `change` arrives as. Another tab was chosen.
	on_change: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `change` carries: Another tab was chosen.
Tabs_Change :: struct {
	// Its value.
	value: string,
}

// Embed with `using _:` in the message passed as `on_change`.
With_Tabs_Change :: struct {
	change: Tabs_Change,
}

@(private)
tabs_props :: proc(p: Tabs) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "tabs", kit_list(p.tabs, proc(x: Tab) -> ^c.Value { return tab_value(x) }))
	c.value_map_set(m, "value", c.value_str(p.value))
	if p.on_change != nil do c.value_map_set(m, "on_change", (^c.Value)(kui.encode(p.on_change)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

tabs :: proc(ui: ^kui.Ui, p: Tabs) -> i32 {
	return tabs_in(ui, NAMESPACE, p)
}

tabs_in :: proc(ui: ^kui.Ui, namespace: string, p: Tabs) -> i32 {
	props := tabs_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/tabs")
	return c.component(ui, name, props, nil, nil)
}

// tabs with your children: `children` builds the group it asks for.
tabs_with :: proc(ui: ^kui.Ui, p: Tabs, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := tabs_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/tabs"), props, call, &b)
}

// A heading that folds what is under it.
Section :: struct {
	// The heading.
	title: string,
	// Folded: yours to keep.
	collapsed: Maybe(bool),
	// A count beside the heading.
	count: Maybe(i64),
	// The body's left inset in px; 18 when left out, under the title. 0 for rows
	// with their own inset that line up with `leading`.
	indent: Maybe(f64),
	// The message `toggle` arrives as. The heading was pressed.
	on_toggle: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `toggle` carries: The heading was pressed.
Section_Toggle :: struct {
