// A choice: what it is, and what it reads as.
Choice :: struct {
	// What the choice is; what the event carries.
	value: string,
	// What it reads as.
	label: string,
	// Shown, not choosable.
	disabled: Maybe(bool),
	// A count beside the label (a segment's, a tab's).
	count: Maybe(i64),
	// The count is bad news: drawn in the danger colour.
	alert: Maybe(bool),
}

@(private)
choice_value :: proc(p: Choice) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "value", c.value_str(p.value))
	c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.count.?; ok do c.value_map_set(m, "count", c.value_int(x))
	if x, ok := p.alert.?; ok do c.value_map_set(m, "alert", c.value_bool(x))
	return m
}

// A table's column: which field of the channel it shows, and how.
Column :: struct {
	// The channel column it reads.
	field: string,
	// Its header.
	title: string,
	// Its width in px; shares the rest when left out.
	width: Maybe(f64),
	// How narrow a sharing column goes before the table hides a column or scrolls
	// sideways (80 when left out).
	min_width: Maybe(f64),
	// How much it matters when the table is narrow: the columns that do not fit
	// hide lowest first, the header with them; left out, it never hides. What
	// still does not fit scrolls sideways.
	priority: Maybe(f64),
	// Where its cells sit; numbers read best at the end.
	align: Maybe(Align),
	// Its cells in the data face: ids, timings, hashes.
	mono: Maybe(bool),
	// A channel column naming each cell's tone (`ok`, `warn`, `danger`, `accent`,
	// `neutral`): the cell is drawn in it — a status, an HTTP method.
	tone: string,
	// Its cells as pills with a dot in their `tone`: a status column.
	badge: Maybe(bool),
}

@(private)
column_value :: proc(p: Column) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "field", c.value_str(p.field))
	c.value_map_set(m, "title", c.value_str(p.title))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if x, ok := p.min_width.?; ok do c.value_map_set(m, "min_width", c.value_float(x))
	if x, ok := p.priority.?; ok do c.value_map_set(m, "priority", c.value_float(x))
	if x, ok := p.align.?; ok do c.value_map_set(m, "align", c.value_str(ALIGN_NAMES[x]))
	if x, ok := p.mono.?; ok do c.value_map_set(m, "mono", c.value_bool(x))
	if p.tone != "" do c.value_map_set(m, "tone", c.value_str(p.tone))
	if x, ok := p.badge.?; ok do c.value_map_set(m, "badge", c.value_bool(x))
	return m
}

// A tab: its value and its label.
Tab :: struct {
	// What it is; what `change` carries.
	value: string,
	// What it reads as.
	label: string,
	// A count beside the label.
	count: Maybe(i64),
}

