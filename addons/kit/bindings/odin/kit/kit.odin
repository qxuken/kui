	return shader_in(ui, NAMESPACE, p)
}

shader_in :: proc(ui: ^kui.Ui, namespace: string, p: Shader) -> i32 {
	props := shader_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/shader")
	return c.component(ui, name, props, nil, nil)
}

// A modal dialog: a title, its body and its actions; Escape and a press outside
// ask it to close.
Dialog :: struct {
	// Its title; its name.
	title: string,
	// Its width in px; 420 when left out.
	width: Maybe(f64),
	// The message `dismiss` arrives as. Escape, or a press outside.
	on_dismiss: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `dismiss` carries: Escape, or a press outside.
Dialog_Dismiss :: struct {
}

// Embed with `using _:` in the message passed as `on_dismiss`.
With_Dialog_Dismiss :: struct {
	dismiss: Dialog_Dismiss,
}

@(private)
dialog_props :: proc(p: Dialog) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "title", c.value_str(p.title))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if p.on_dismiss != nil do c.value_map_set(m, "on_dismiss", (^c.Value)(kui.encode(p.on_dismiss)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

dialog :: proc(ui: ^kui.Ui, p: Dialog) -> i32 {
	return dialog_in(ui, NAMESPACE, p)
}

dialog_in :: proc(ui: ^kui.Ui, namespace: string, p: Dialog) -> i32 {
	props := dialog_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/dialog")
	return c.component(ui, name, props, nil, nil)
}

// dialog with your children: `children` builds the group it asks for.
dialog_with :: proc(ui: ^kui.Ui, p: Dialog, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := dialog_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/dialog"), props, call, &b)
}

// A panel floating beside what opened it; Escape and a press outside ask it to
