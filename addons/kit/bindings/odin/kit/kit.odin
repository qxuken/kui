toaster_with :: proc(ui: ^kui.Ui, p: Toaster, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
