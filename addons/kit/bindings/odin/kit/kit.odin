// A field that opens a menu of options.
Select :: struct {
	// The options, in order.
	options: []Choice,
	// The one chosen: yours to keep.
	value: string,
	// Shown with nothing chosen.
	placeholder: string,
	// Its label, above it.
	label: string,
	// Its width in px.
	width: Maybe(f64),
	// The message `change` arrives as. An option was chosen.
	on_change: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `change` carries: An option was chosen.
Select_Change :: struct {
	// Its value.
	value: string,
}

// Embed with `using _:` in the message passed as `on_change`.
With_Select_Change :: struct {
	change: Select_Change,
}

@(private)
select_props :: proc(p: Select) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "options", kit_list(p.options, proc(x: Choice) -> ^c.Value { return choice_value(x) }))
	if p.value != "" do c.value_map_set(m, "value", c.value_str(p.value))
	if p.placeholder != "" do c.value_map_set(m, "placeholder", c.value_str(p.placeholder))
	if p.label != "" do c.value_map_set(m, "label", c.value_str(p.label))
	if x, ok := p.width.?; ok do c.value_map_set(m, "width", c.value_float(x))
	if p.on_change != nil do c.value_map_set(m, "on_change", (^c.Value)(kui.encode(p.on_change)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

select :: proc(ui: ^kui.Ui, p: Select) -> i32 {
	return select_in(ui, NAMESPACE, p)
}

select_in :: proc(ui: ^kui.Ui, namespace: string, p: Select) -> i32 {
	props := select_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/select")
	return c.component(ui, name, props, nil, nil)
}

// A box and its label.
Checkbox :: struct {
	// Its label; its name.
	label: string,
	// Ticked: yours to keep.
	checked: bool,
	// Some of what it stands for: drawn as a dash.
	mixed: Maybe(bool),
	// Unavailable.
	disabled: Maybe(bool),
	// The label names it but is not drawn: its children draw it instead (a name
	// with search hits marked).
	hide_label: Maybe(bool),
	// Takes its row's room, the whole height a target: a list row ticked anywhere.
	grow: Maybe(bool),
	// The message `toggle` arrives as. Pressed.
	on_toggle: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `toggle` carries: Pressed.
Checkbox_Toggle :: struct {
	// What it asks to be.
	checked: bool,
}

// Embed with `using _:` in the message passed as `on_toggle`.
With_Checkbox_Toggle :: struct {
	toggle: Checkbox_Toggle,
}

@(private)
checkbox_props :: proc(p: Checkbox) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "label", c.value_str(p.label))
	c.value_map_set(m, "checked", c.value_bool(p.checked))
	if x, ok := p.mixed.?; ok do c.value_map_set(m, "mixed", c.value_bool(x))
	if x, ok := p.disabled.?; ok do c.value_map_set(m, "disabled", c.value_bool(x))
	if x, ok := p.hide_label.?; ok do c.value_map_set(m, "hide_label", c.value_bool(x))
	if x, ok := p.grow.?; ok do c.value_map_set(m, "grow", c.value_bool(x))
	if p.on_toggle != nil do c.value_map_set(m, "on_toggle", (^c.Value)(kui.encode(p.on_toggle)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

checkbox :: proc(ui: ^kui.Ui, p: Checkbox) -> i32 {
	return checkbox_in(ui, NAMESPACE, p)
}

checkbox_in :: proc(ui: ^kui.Ui, namespace: string, p: Checkbox) -> i32 {
	props := checkbox_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/checkbox")
	return c.component(ui, name, props, nil, nil)
}

// checkbox with your children: `children` builds the group it asks for.
checkbox_with :: proc(ui: ^kui.Ui, p: Checkbox, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := checkbox_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/checkbox"), props, call, &b)
}

// A list of things to tick, one Tab stop: Up and Down walk the items, Home and
// End the ends, Space or a click ticks the one focused.
Checklist :: struct {
	// The items, in order: yours to keep.
	items: []Check,
	// What it lists, as it is read.
	label: string,
	// An × on each item, which the pointer presses to remove it; Delete or
	// Backspace removes the focused one.
	removable: Maybe(bool),
	// The message `toggle` arrives as. An item was ticked or unticked.
	on_toggle: any,
	// The message `remove` arrives as. An item asked to go.
	on_remove: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `toggle` carries: An item was ticked or unticked.
Checklist_Toggle :: struct {
	// Its place, 0-based.
	index: i64,
	// What it asks to be.
	checked: bool,
}

// Embed with `using _:` in the message passed as `on_toggle`.
With_Checklist_Toggle :: struct {
	toggle: Checklist_Toggle,
