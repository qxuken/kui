// A value on a track, dragged, clicked or stepped by the arrows.
Slider :: struct {
	// The value: yours to keep.
	value: f64,
	// The least.
	min: f64,
	// The most.
	max: f64,
	// What an arrow moves it by; a hundredth of the range when left out.
	step: Maybe(f64),
	// Its label; its name.
	label: string,
	// The value as text, shown beside the label and read for it: `20 MB/s`, `30
	// days`. The number when left out.
	value_label: string,
	// The message `change` arrives as. It asks for another value.
	on_change: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `change` carries: It asks for another value.
Slider_Change :: struct {
	// The value it asks for.
	value: f64,
}

// Embed with `using _:` in the message passed as `on_change`.
With_Slider_Change :: struct {
	change: Slider_Change,
}

