// Generated by kui-addon-schema from kit's schema.lua (ADR 0066); do not edit.
// Kit: a UI kit for kui, tuned for dense tool UIs — inputs, data views,
// overlays, layout, charts and a trace waterfall, drawn by a skin (Ledger,
// Phosphor, Neutral) the host picks.
package kit

import "base:runtime"
import "core:strings"
import kui "../../../../../packages/odin/kui"
import c "../../../../../packages/odin/kui/c"

// The namespace the components are placed under; the `_in` procedures
// take another, for kit loaded twice.
NAMESPACE :: "kit"

@(private)
kit_list :: proc(xs: $T/[]$E, f: proc(x: E) -> ^c.Value) -> ^c.Value {
	l := c.value_list()
	for x in xs do c.value_list_push(l, f(x))
	return l
}

// What a `_with` procedure's callback runs its children under.
@(private)
Body_Context :: runtime.Context

@(private)
concat :: proc(a, b: string) -> string {
	return strings.concatenate({a, b}, context.temp_allocator)
}

// How loud a control is; success confirms what just happened (Copied).
Variant :: enum {
	Default,
	Primary,
	Ghost,
	Danger,
	Success,
}

@(private)
VARIANT_NAMES := [Variant]string {
	.Default = "default",
	.Primary = "primary",
	.Ghost = "ghost",
	.Danger = "danger",
	.Success = "success",
}

// What a badge, a stat or a toast is about.
