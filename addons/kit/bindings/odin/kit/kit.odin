// Lines over time with axes and a legend; `live` keeps the newest window in
// view.
LineChart :: struct {
	// The rows: an x column and a column a series.
	data: ^c.Channel,
	// The x column (time, an index).
	x: string,
	// The lines.
	series: []Series,
	// In px; 160 when left out.
	height: Maybe(f64),
	// Filled under the first line.
	area: Maybe(bool),
	// With it, only the last `window` of x is shown: a live chart. While samples
	// come in it scrolls smoothly between them, drawn one sample behind and slid
	// left over the time samples take to come (a keyframe cycle the core runs, so
	// a frame between samples runs no view); under reduced motion, and while the
	// plot is out of the viewport, it steps.
	window: Maybe(f64),
	// How the x ticks read; the number when left out.
	x_format: Maybe(XFormat),
	// After each x tick's number: `min`, `s`.
	x_unit: string,
	// After each y tick's number: `ms`, `%`.
	y_unit: string,
	// Under the pointer, a crosshair at the pointer's x, a dot on each series
	// there and a readout of the x and every series' value in its colour for the
	// sample under it — a still pointer keeps its crosshair still while a live
	// window slides samples under it — gone when the pointer leaves; on when
	// left out. An idle chart pays one hover layer for it.
	readout: Maybe(bool),
	// A Tab stop that is a slider over the samples: the arrows move the readout a
	// sample, Page Up and Down ten, Home and End to the ends, and a screen reader
	// hears the readout as its value and as a live region. No key sink: every
	// other key, Tab and the app's chords, goes on as from any control.
	focusable: Maybe(bool),
	// The message `hover` arrives as. The pointer moved over a row.
	on_hover: any,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

// What `hover` carries: The pointer moved over a row.
LineChart_Hover :: struct {
	// The row under it.
	row: i64,
}

// Embed with `using _:` in the message passed as `on_hover`.
With_LineChart_Hover :: struct {
	hover: LineChart_Hover,
}

@(private)
line_chart_props :: proc(p: LineChart) -> ^c.Value {
	m := c.value_map()
	if p.data != nil do c.value_map_set(m, "data", c.channel_handle(p.data))
	c.value_map_set(m, "x", c.value_str(p.x))
	c.value_map_set(m, "series", kit_list(p.series, proc(x: Series) -> ^c.Value { return series_value(x) }))
	if x, ok := p.height.?; ok do c.value_map_set(m, "height", c.value_float(x))
	if x, ok := p.area.?; ok do c.value_map_set(m, "area", c.value_bool(x))
	if x, ok := p.window.?; ok do c.value_map_set(m, "window", c.value_float(x))
	if x, ok := p.x_format.?; ok do c.value_map_set(m, "x_format", c.value_str(X_FORMAT_NAMES[x]))
	if p.x_unit != "" do c.value_map_set(m, "x_unit", c.value_str(p.x_unit))
	if p.y_unit != "" do c.value_map_set(m, "y_unit", c.value_str(p.y_unit))
	if x, ok := p.readout.?; ok do c.value_map_set(m, "readout", c.value_bool(x))
	if x, ok := p.focusable.?; ok do c.value_map_set(m, "focusable", c.value_bool(x))
	if p.on_hover != nil do c.value_map_set(m, "on_hover", (^c.Value)(kui.encode(p.on_hover)))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

line_chart :: proc(ui: ^kui.Ui, p: LineChart) -> i32 {
	return line_chart_in(ui, NAMESPACE, p)
}

line_chart_in :: proc(ui: ^kui.Ui, namespace: string, p: LineChart) -> i32 {
	props := line_chart_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/line_chart")
	return c.component(ui, name, props, nil, nil)
}

