// Rows `first` to `last` of a list or a table, both in (0-based): a multiple
// selection is a list of them, so ⌘A on 100,000 rows is one.
RowRange :: struct {
	// The first row in it.
	first: i64,
	// The last row in it.
	last: i64,
}

@(private)
row_range_value :: proc(p: RowRange) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "first", c.value_int(p.first))
	c.value_map_set(m, "last", c.value_int(p.last))
	return m
}

// One line of a line chart.
Series :: struct {
	// The channel column holding its values.
	field: string,
	// Its name in the legend.
	name: string,
	// Its colour; the skin's series colours in order when left out.
	color: Maybe(u32),
}

@(private)
series_value :: proc(p: Series) -> ^c.Value {
	m := c.value_map()
	c.value_map_set(m, "field", c.value_str(p.field))
	c.value_map_set(m, "name", c.value_str(p.name))
	if x, ok := p.color.?; ok do c.value_map_set(m, "color", c.value_int(i64(x)))
	return m
}

// Kit's look for this window: the skin, the density, the hard shadows and any
// role the brand overrides. Place it once a frame, before the components; it
// draws nothing.
Settings :: struct {
	// The skin; Ledger when left out.
	skin: Maybe(Skin),
	// Comfortable when left out.
	density: Maybe(Density),
	// The skin's hard shadows; on when left out.
	shadows: Maybe(bool),
	// Corner radius in px, for a brand with its own; the skin's when left out.
	radius: Maybe(f64),
	// Roles the brand overrides, by name: `{ accent = 0x2f6fedff, panel =
	// "$brandSurface" }` — a colour, `{ light, dark }` or a token each. An
	// accent given as a colour derives the palette around it: what the skin drew
	// in its accent takes it (the selection, a view switch's chosen segment, the
	// first chart series and waterfall group), what it drew in the accent's hue
	// takes the new hue, the ground and surfaces lean a few percent toward it, and
	// every text role is moved in lightness until it reads at 4.5:1 on what it
	// sits on (WCAG AA), what reads on the accent worked out. Roles the brand
	// names are kept as named.
	roles: any,
	// Kit's colours held light or dark whatever the OS says; the OS's when left
	// out (`system`).
	appearance: Maybe(Appearance),
	// The hairline's width in px (rows, a field's edge); the skin's when left out.
	hair: Maybe(f64),
	// The region rule's width in px (a panel's frame, a control's border); the
	// skin's when left out.
	rule: Maybe(f64),
	// The UI face, as a family list (`{ "Inter", "sans" }`); the skin's when left
	// out.
	font_ui: []string,
	// The data face (ids, numbers, code), as a family list; the skin's when left
	// out.
	font_data: []string,
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

@(private)
settings_props :: proc(p: Settings) -> ^c.Value {
	m := c.value_map()
	if x, ok := p.skin.?; ok do c.value_map_set(m, "skin", c.value_str(SKIN_NAMES[x]))
	if x, ok := p.density.?; ok do c.value_map_set(m, "density", c.value_str(DENSITY_NAMES[x]))
	if x, ok := p.shadows.?; ok do c.value_map_set(m, "shadows", c.value_bool(x))
	if x, ok := p.radius.?; ok do c.value_map_set(m, "radius", c.value_float(x))
	if p.roles != nil do c.value_map_set(m, "roles", (^c.Value)(kui.encode(p.roles)))
	if x, ok := p.appearance.?; ok do c.value_map_set(m, "appearance", c.value_str(APPEARANCE_NAMES[x]))
	if x, ok := p.hair.?; ok do c.value_map_set(m, "hair", c.value_float(x))
	if x, ok := p.rule.?; ok do c.value_map_set(m, "rule", c.value_float(x))
	if p.font_ui != nil do c.value_map_set(m, "font_ui", kit_list(p.font_ui, proc(x: string) -> ^c.Value { return c.value_str(x) }))
	if p.font_data != nil do c.value_map_set(m, "font_data", kit_list(p.font_data, proc(x: string) -> ^c.Value { return c.value_str(x) }))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

settings :: proc(ui: ^kui.Ui, p: Settings) -> i32 {
	return settings_in(ui, NAMESPACE, p)
}

settings_in :: proc(ui: ^kui.Ui, namespace: string, p: Settings) -> i32 {
	props := settings_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/settings")
	return c.component(ui, name, props, nil, nil)
}

// A titled region: a header with the title and its actions, the body, an
// optional footer.
Panel :: struct {
	// Its title, as the skin labels regions.
	title: string,
	// A line under the title.
	subtitle: string,
	// The body scrolls rather than grows.
	scroll: Maybe(bool),
	// Takes the room its parent leaves.
	grow: Maybe(bool),
	// The body's padding in px; 10 when left out, 0 for a body that brings its own
	// or is often empty.
	pad: Maybe(f64),
	// Keys the instance (empty: where it is placed); fresh asks every frame.
	key:   string,
	fresh: bool,
}

@(private)
panel_props :: proc(p: Panel) -> ^c.Value {
	m := c.value_map()
	if p.title != "" do c.value_map_set(m, "title", c.value_str(p.title))
	if p.subtitle != "" do c.value_map_set(m, "subtitle", c.value_str(p.subtitle))
	if x, ok := p.scroll.?; ok do c.value_map_set(m, "scroll", c.value_bool(x))
	if x, ok := p.grow.?; ok do c.value_map_set(m, "grow", c.value_bool(x))
	if x, ok := p.pad.?; ok do c.value_map_set(m, "pad", c.value_float(x))
	if p.key != "" do c.value_map_set(m, "key", c.value_str(p.key))
	if p.fresh do c.value_map_set(m, "fresh", c.value_bool(true))
	return m
}

panel :: proc(ui: ^kui.Ui, p: Panel) -> i32 {
	return panel_in(ui, NAMESPACE, p)
}

panel_in :: proc(ui: ^kui.Ui, namespace: string, p: Panel) -> i32 {
	props := panel_props(p)
	defer c.value_free(props)
	name := concat(namespace, "/panel")
	return c.component(ui, name, props, nil, nil)
}

// panel with your children: `children` builds the group it asks for.
panel_with :: proc(ui: ^kui.Ui, p: Panel, data: ^$T, children: proc(data: ^T, ui: ^kui.Ui, group: string)) -> i32 {
	Body :: struct {
		data:     ^T,
		children: proc(data: ^T, ui: ^kui.Ui, group: string),
		ctx:      Body_Context,
	}
	call :: proc "c" (user: rawptr, ui: ^c.Ctx, group: string) {
		b := (^Body)(user)
		context = b.ctx
		b.children(b.data, ui, group)
	}
	b := Body{data, children, context}
	props := panel_props(p)
	defer c.value_free(props)
	return c.component(ui, concat(NAMESPACE, "/panel"), props, call, &b)
}

