  -- Kit's look for this window: the skin, the density, the hard shadows and
  -- any role the brand overrides. Place it once a frame, before the
  -- components; it draws nothing.
  settings: function(props: SettingsProps): kui.Node

  -- A titled region: a header with the title and its actions, the body, an
  -- optional footer.
  panel: function(props: PanelProps, children?: {any:any}): kui.Node

  -- A row of controls at the control height, its trailing group pushed to the
  -- far side.
  toolbar: function(props: ToolbarProps, children?: {any:any}): kui.Node

  -- A thin row at a window's foot for state: counts, the connection, the
  -- clock.
  statusbar: function(props: StatusbarProps, children?: {any:any}): kui.Node

  -- Two panes and a draggable rule between them.
  split: function(props: SplitProps, children?: {any:any}): kui.Node

  -- A strip of tabs over the body of the one chosen.
  tabs: function(props: TabsProps, children?: {any:any}): kui.Node

  -- A heading that folds what is under it.
  section: function(props: SectionProps, children?: {any:any}): kui.Node

  -- A rule between groups, as the skin draws regions.
  divider: function(props: DividerProps): kui.Node

  -- A button. Space, Enter and assistive technology press it as a click does.
  button: function(props: ButtonProps): kui.Node

  -- A square button holding an icon.
  icon_button: function(props: IconButtonProps): kui.Node

  -- A one-line text field, the skin's field style (an underline in Ledger).
  text_field: function(props: TextFieldProps): kui.Node

  -- A search field: a glass, the query, and a clear button while it has one.
  search: function(props: SearchProps): kui.Node

  -- A field that opens a menu of options.
  select: function(props: SelectProps): kui.Node

  -- A box and its label.
  checkbox: function(props: CheckboxProps, children?: {any:any}): kui.Node

  -- An on/off switch and its label.
  switch: function(props: SwitchProps): kui.Node

  -- One of a few options, each a radio and its label.
  radio_group: function(props: RadioGroupProps): kui.Node

  -- A row of joined buttons, one of them chosen: a view switch, a range.
  segmented: function(props: SegmentedProps): kui.Node

  -- A value on a track, dragged, clicked or stepped by the arrows.
  slider: function(props: SliderProps): kui.Node

  -- A virtual table over a channel: its columns, a sticky header, the rows in
  -- view only, a selection, sortable headers.
  table: function(props: TableProps): kui.Node

  -- A virtual list over a channel: a title line and a detail line a row.
  list: function(props: ListProps): kui.Node

  -- Keys and their values, aligned: a request's headers, a record's fields.
  inspector: function(props: InspectorProps): kui.Node

  -- A log over a channel: time, level and message a line, following the end
  -- unless scrolled away.
  log: function(props: LogProps): kui.Node

  -- A short label in a pill: a status, a method, a count.
  badge: function(props: BadgeProps): kui.Node

  -- A number with its label, and how it moved.
  stat: function(props: StatProps): kui.Node

  -- Text in the data face on the panel colour: a payload, a command, a stack.
  code: function(props: CodeProps): kui.Node

  -- A message in the flow of the page: an error to act on, a warning, a note;
  -- its actions after it.
  notice: function(props: NoticeProps, children?: {any:any}): kui.Node

  -- What a view shows with nothing in it: a title, a sentence, and what to
  -- do.
  empty: function(props: EmptyProps, children?: {any:any}): kui.Node

  -- A bar that fills; with no value it moves to say work is going on.
  progress: function(props: ProgressProps): kui.Node

  -- A modal dialog: a title, its body and its actions; Escape and a press
  -- outside ask it to close.
  dialog: function(props: DialogProps, children?: {any:any}): kui.Node

  -- A panel floating beside what opened it; Escape and a press outside ask it
  -- to close.
  popover: function(props: PopoverProps, children?: {any:any}): kui.Node

  -- A menu of items floating under what opened it.
  menu: function(props: MenuProps): kui.Node

  -- A message in a window's corner that goes when dismissed.
  toast: function(props: ToastProps): kui.Node

  -- A line with no axes, for a trend inline.
  sparkline: function(props: SparklineProps): kui.Node

  -- Lines over time with axes and a legend; `live` keeps the newest window in
  -- view.
  line_chart: function(props: LineChartProps): kui.Node

  -- Bars by label.
  bar_chart: function(props: BarChartProps): kui.Node

  -- How a column's values fall into bins.
  histogram: function(props: HistogramProps): kui.Node

  -- A trace waterfall: spans as bars on a time axis, nested by depth,
  -- coloured by group, zoomed and panned by the wheel and a drag.
  waterfall: function(props: WaterfallProps): kui.Node

  -- The same components under another namespace.
  at: function(namespace: string): kit
end

return kit
