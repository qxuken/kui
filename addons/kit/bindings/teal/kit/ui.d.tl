-- Generated by kui-addon-schema from kit's schema.lua (ADR 0066); do not edit.
-- Kit: a UI kit for kui, tuned for dense tool UIs — inputs, data views,
-- overlays, layout, charts and a trace waterfall, drawn by a skin (Ledger,
-- Phosphor, Neutral) the host picks.

local record kit
  -- How loud a control is; success confirms what just happened (Copied).
  enum Variant
    "default" "primary" "ghost" "danger" "success"
  end

  -- What a badge, a stat or a toast is about.
  enum Tone
    "neutral" "accent" "ok" "warn" "danger"
  end

  -- Where a cell's content sits.
  enum Align
    "start" "center" "end"
  end

  -- Which way a split divides.
  enum Axis
    "row" "column"
  end

  -- The look: Ledger's paper and ink, Phosphor's terminal, or Neutral's quiet
  -- chrome.
  enum Skin
    "ledger" "phosphor" "neutral"
  end

  -- Row and control heights: 22 and 26 px, or 20 and 22 px compact.
  enum Density
    "comfortable" "compact"
  end

  -- A log line's level.
  enum Level
    "debug" "info" "warn" "error"
  end

  -- A choice: what it is, and what it reads as.
  record Choice
    -- What the choice is; what the event carries.
    value: string
    -- What it reads as.
    label: string
    -- Shown, not choosable.
    disabled: boolean
    -- A count beside the label (a segment's, a tab's).
    count: integer
    -- The count is bad news: drawn in the danger colour.
    alert: boolean
  end

  -- A table's column: which field of the channel it shows, and how.
  record Column
    -- The channel column it reads.
    field: string
    -- Its header.
    title: string
    -- Its width in px; shares the rest when left out.
    width: number
    -- Where its cells sit; numbers read best at the end.
    align: Align
    -- Its cells in the data face: ids, timings, hashes.
    mono: boolean
  end

  -- A tab: its value and its label.
  record Tab
    -- What it is; what `change` carries.
    value: string
    -- What it reads as.
    label: string
    -- A count beside the label.
    count: integer
  end

  -- A menu row.
  record Item
    -- What `choose` carries.
    value: string
    -- What it reads as.
    label: string
    -- The chord beside it, as text: `⌘K`.
    shortcut: string
    -- Shown, not choosable.
    disabled: boolean
    -- A destructive action, drawn as one.
    danger: boolean
  end

  -- One row of an inspector: a key and its value.
  record Entry
    -- The field's name.
    key: string
    -- Its value, as text.
    value: string
    -- The value in the data face.
    mono: boolean
  end

  -- One line of a line chart.
  record Series
    -- The channel column holding its values.
    field: string
    -- Its name in the legend.
    name: string
    -- Its colour; the skin's series colours in order when left out.
    color: integer | string
  end

  -- The props of `kit/settings`.
  record SettingsProps
    -- The skin; Ledger when left out.
    skin: Skin
    -- Comfortable when left out.
    density: Density
    -- The skin's hard shadows; on when left out.
    shadows: boolean
    -- Corner radius in px, for a brand with its own; the skin's when left
    -- out.
    radius: number
    -- Roles the brand overrides, by name: `{ accent = 0x2f6fedff, panel =
    -- "$brandSurface" }` — a colour or a token each.
    roles: any
    key: string
    fresh: boolean
  end

  -- The props of `kit/panel`.
  record PanelProps
    -- Its title, as the skin labels regions.
    title: string
    -- A line under the title.
    subtitle: string
    -- The body scrolls rather than grows.
    scroll: boolean
    -- Takes the room its parent leaves.
    grow: boolean
    -- The body's padding in px; 10 when left out, 0 for a body that brings
    -- its own or is often empty.
    pad: number
    key: string
    fresh: boolean
  end

  -- The props of `kit/toolbar`.
  record ToolbarProps
